---
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const { title, description = 'Fathom — Autonomous AI Workers documentation: tools, sessions, HTTP API, MCP, security, and architecture.', activePage = '' } = Astro.props;
const SITE = 'https://fathom.uz';
const canonical = SITE + Astro.url.pathname;
const crumbLabel = title.replace(/ — Fathom(?: Research)?$/, '');

interface NavItem {
  label: string;
  href: string;
  id: string;
  i18nKey?: string;
}

interface NavSection {
  title: string;
  i18nKey?: string;
  items: NavItem[];
}

const navSections: NavSection[] = [
  {
    title: 'Getting Started', i18nKey: 'docsNav.start',
    items: [
      { label: 'Quickstart', href: '/docs/quickstart', id: 'quickstart', i18nKey: 'docsNav.quickstart' },
      { label: 'Installation', href: '/docs/quickstart#installation', id: 'installation', i18nKey: 'docsNav.installation' },
    ],
  },
  {
    title: 'Outreach', i18nKey: 'docsNav.outreach',
    items: [
      { label: 'Outreach & Leads', href: '/docs/outreach', id: 'outreach', i18nKey: 'docsNav.outreachGuide' },
      { label: 'Personalization', href: '/docs/personalization', id: 'personalization', i18nKey: 'docsNav.personalization' },
      { label: 'Recipes', href: '/docs/recipes', id: 'recipes', i18nKey: 'docsNav.recipes' },
    ],
  },
  {
    title: 'Memory', i18nKey: 'docsNav.memory',
    items: [
      { label: 'Memory System', href: '/docs/memory', id: 'memory', i18nKey: 'docsNav.memorySystem' },
    ],
  },
  {
    title: 'Configuration', i18nKey: 'docsNav.config',
    items: [
      { label: 'Config Reference', href: '/docs/configuration', id: 'configuration', i18nKey: 'docsNav.configRef' },
      { label: 'Environment Variables', href: '/docs/configuration#env-vars', id: 'env-vars', i18nKey: 'docsNav.envVars' },
      { label: 'Memory Config', href: '/docs/configuration#memory', id: 'memory-config', i18nKey: 'docsNav.memoryConfig' },
      { label: 'Hooks', href: '/docs/configuration#hooks', id: 'hooks-config', i18nKey: 'docsNav.hooksConfig' },
      { label: 'Profiles & Personas', href: '/profiles', id: 'profiles', i18nKey: 'docsNav.profilesPersonas' },
    ],
  },
  {
    title: 'Tools', i18nKey: 'docsNav.tools',
    items: [
      { label: 'All Tools', href: '/docs/tools', id: 'tools', i18nKey: 'docsNav.allTools' },
      { label: 'Search Backends', href: '/docs/tools#search-backends', id: 'search-backends', i18nKey: 'docsNav.searchBackends' },
      { label: 'OSINT Pipeline', href: '/docs/tools#osint', id: 'osint', i18nKey: 'docsNav.osint' },
    ],
  },
  {
    title: 'Architecture', i18nKey: 'docsNav.architecture',
    items: [
      { label: 'Overview', href: '/docs/architecture', id: 'architecture', i18nKey: 'docsNav.archOverview' },
      { label: 'Agent Lifecycle', href: '/docs/architecture#lifecycle', id: 'lifecycle', i18nKey: 'docsNav.archLifecycle' },
      { label: 'Multi-Process', href: '/docs/architecture#multi-process', id: 'multi-process', i18nKey: 'docsNav.archMultiProcess' },
      { label: 'Task Tree', href: '/docs/architecture#task-tree', id: 'task-tree', i18nKey: 'docsNav.archTaskTree' },
      { label: 'Improvement Backlog', href: '/docs/architecture#improvement-backlog', id: 'improvement-backlog', i18nKey: 'docsNav.archImprovement' },
      { label: 'Verification Receipts', href: '/docs/architecture#verification-receipts', id: 'verification-receipts', i18nKey: 'docsNav.archReceipts' },
      { label: 'Lifecycle Hooks', href: '/ops', id: 'hooks', i18nKey: 'docsNav.archHooks' },
      { label: 'Safety & Security', href: '/architecture', id: 'safety', i18nKey: 'docsNav.archSafety' },
    ],
  },
  {
    title: 'Security & Privacy', i18nKey: 'docsNav.security',
    items: [
      { label: 'Security Overview', href: '/security', id: 'security', i18nKey: 'docsNav.securityOverview' },
    ],
  },
  {
    title: 'Integrations', i18nKey: 'docsNav.integrations',
    items: [
      { label: 'All Integrations', href: '/integrations', id: 'integrations', i18nKey: 'docsNav.allIntegrations' },
    ],
  },
  {
    title: 'API Reference', i18nKey: 'docsNav.api',
    items: [
      { label: 'HTTP API', href: '/docs/api', id: 'api', i18nKey: 'docsNav.httpApi' },
      { label: 'SSE Events', href: '/docs/api#sse-events', id: 'sse', i18nKey: 'docsNav.sse' },
      { label: 'CLI Reference', href: '/docs/cli', id: 'cli', i18nKey: 'docsNav.cli' },
      { label: 'RPC, GUI & IDE', href: '/docs/protocol-gui', id: 'protocol-gui', i18nKey: 'docsNav.protocolGui' },
    ],
  },
];
---

<!doctype html>
<html lang={Astro.currentLocale === 'ru' ? 'ru' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={Astro.currentLocale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:site_name" content="Fathom — Autonomous AI Workers" />
    <meta property="og:image" content={`${SITE}/og-image.svg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og-image.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <JsonLd data={{
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Documentation', item: `${SITE}/docs/` },
        ...(Astro.url.pathname !== '/docs/'
          ? [{ '@type': 'ListItem', position: 3, name: crumbLabel, item: canonical }]
          : []),
      ],
    }} />
    <script is:inline>
      (function () {
        var t = localStorage.getItem('fathom-theme') || localStorage.getItem('Fathom-theme');
        if (t && !localStorage.getItem('fathom-theme')) localStorage.setItem('fathom-theme', t);
        if (!t && window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
        if (t) document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <nav class="docstop-nav">
      <div class="docstop-nav-inner">
        <a href="/" class="docs-logo">
          <svg class="docs-logo-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect width="24" height="24" rx="5" fill="#181818"/>
            <rect x="6" y="6" width="12" height="12" rx="2" fill="#fcfbfa"/>
          </svg>
          <span class="docs-logo-text">Fathom</span>
        </a>
        <div class="docstop-links">
          <a href="/docs" class:list={[{ active: activePage === 'docs' }]}>Docs</a>
          <a href="/docs/quickstart" class:list={[{ active: activePage === 'quickstart' }]}>Quickstart</a>
          <a href="/docs/cli" class:list={[{ active: activePage === 'cli' }]}>CLI</a>
          <a href="/docs/configuration" class:list={[{ active: activePage === 'configuration' }]}>Config</a>
          <a href="/docs/tools" class:list={[{ active: activePage === 'tools' }]}>Tools</a>
          <a href="/docs/api" class:list={[{ active: activePage === 'api' }]}>API</a>
        </div>
        <div class="docstop-actions">
          <button class="docs-btn-ghost theme-toggle" data-theme-toggle aria-label="Toggle theme">◐</button>
          <a href="/install" class="docs-btn-ghost">Install</a>
          <a href="/docs/quickstart" class="docs-btn-primary">Get Started →</a>
        </div>
        <button class="docs-mobile-toggle" aria-label="Menu" id="docs-menu-toggle">
          <span></span><span></span><span></span>
        </button>
      </div>
    </nav>

    <div class="docs-layout">
      <aside class="docs-sidebar" id="docs-sidebar">
        <nav class="sidebar-nav">
          {navSections.map((section) => (
            <div class="sidebar-section">
              {section.i18nKey ? <h3 class="sidebar-section-title" data-i18n={section.i18nKey}>{section.title}</h3> : <h3 class="sidebar-section-title">{section.title}</h3>}
              <ul class="sidebar-list">
                {section.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class:list={['sidebar-link', { active: activePage === item.id }]}
                      {...(item.i18nKey ? { 'data-i18n': item.i18nKey } : {})}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <main class="docs-main">
        <div class="docs-content">
          <slot />
        </div>
      </main>

      <aside class="docs-toc" id="docs-toc">
        <div class="toc-inner">
          <h4 class="toc-title">On this page</h4>
          <nav class="toc-nav" id="toc-nav"></nav>
        </div>
      </aside>
    </div>

    <style>
      .docstop-nav {
        position: sticky;
        top: 0;
        z-index: 200;
        background: var(--nav-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border);
        height: 56px;
      }

      .docstop-nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 56px;
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 24px;
        gap: 24px;
      }

      .docs-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 1.125rem;
        letter-spacing: -0.03em;
        flex-shrink: 0;
      }

      .docs-logo-icon {
        color: var(--accent);
        font-size: 1.375rem;
      }

      .docs-logo-mark {
        width: 22px;
        height: 22px;
        flex: none;
      }

      .docs-logo-text {
        text-transform: lowercase;
      }

      .docstop-links {
        display: flex;
        align-items: center;
        gap: 4px;
      }

      .docstop-links a {
        padding: 6px 14px;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-secondary);
        border-radius: var(--radius-sm);
        transition: all var(--duration) var(--ease-out);
      }

      .docstop-links a:hover {
        color: var(--text-primary);
        background: var(--bg-secondary);
      }

      .docstop-links a.active {
        color: var(--text-primary);
        background: var(--bg-tertiary);
      }

      .docstop-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }

      .docs-btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-secondary);
        transition: color var(--duration) var(--ease-out);
      }

      .docs-btn-ghost:hover {
        color: var(--text-primary);
      }

      .docs-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--on-accent);
        background: var(--accent);
        border-radius: var(--radius-full);
        transition: all var(--duration) var(--ease-out);
      }

      .docs-btn-primary:hover {
        background: var(--accent-hover);
        transform: translateY(-1px);
        box-shadow: var(--shadow-glow);
      }

      .docs-mobile-toggle {
        display: none;
        flex-direction: column;
        gap: 4px;
        padding: 8px;
      }

      .docs-mobile-toggle span {
        display: block;
        width: 18px;
        height: 2px;
        background: var(--text-primary);
        border-radius: 1px;
      }

      .docs-layout {
        display: grid;
        grid-template-columns: 260px 1fr 220px;
        max-width: 1440px;
        margin: 0 auto;
        min-height: calc(100vh - 56px);
      }

      .docs-sidebar {
        position: sticky;
        top: 56px;
        height: calc(100vh - 56px);
        overflow-y: auto;
        padding: 32px 24px 32px 24px;
        border-right: 1px solid var(--border);
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
      }

      .sidebar-nav {
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      .sidebar-section-title {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: 10px;
        padding: 0 12px;
      }

      .sidebar-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .sidebar-link {
        display: block;
        padding: 7px 12px;
        font-size: 0.875rem;
        font-weight: 450;
        color: var(--text-secondary);
        border-radius: var(--radius-sm);
        transition: all var(--duration) var(--ease-out);
        line-height: 1.4;
      }

      .sidebar-link:hover {
        color: var(--text-primary);
        background: var(--bg-secondary);
      }

      .sidebar-link.active {
        color: var(--accent);
        background: var(--accent-light);
        font-weight: 550;
      }

      .docs-main {
        min-width: 0;
        padding: 48px 56px 80px;
      }

      .docs-content {
        max-width: 800px;
        margin: 0 auto;
      }

      .docs-toc {
        position: sticky;
        top: 56px;
        height: calc(100vh - 56px);
        overflow-y: auto;
        padding: 48px 24px 48px 16px;
        scrollbar-width: thin;
        scrollbar-color: var(--border) transparent;
      }

      .toc-inner {
        border-left: 1px solid var(--border);
        padding-left: 16px;
      }

      .toc-title {
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-tertiary);
        margin-bottom: 16px;
      }

      .toc-nav {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .toc-nav :global(a) {
        display: block;
        font-size: 0.8125rem;
        color: var(--text-tertiary);
        padding: 4px 0;
        line-height: 1.4;
        transition: color var(--duration) var(--ease-out);
        border-left: 2px solid transparent;
        padding-left: 12px;
        margin-left: -17px;
      }

      .toc-nav :global(a:hover) {
        color: var(--text-primary);
      }

      .toc-nav :global(a.active) {
        color: var(--accent);
        border-left-color: var(--accent);
      }

      .toc-nav :global(a.toc-h3) {
        padding-left: 24px;
        font-size: 0.75rem;
      }

      @media (max-width: 1200px) {
        .docs-toc {
          display: none;
        }

        .docs-layout {
          grid-template-columns: 260px 1fr;
        }
      }

      @media (max-width: 768px) {
        .docstop-links {
          display: none;
        }

        .docstop-actions {
          display: none;
        }

        .docs-mobile-toggle {
          display: flex;
        }

        .docs-layout {
          grid-template-columns: 1fr;
        }

        .docs-sidebar {
          display: none;
          position: fixed;
          top: 56px;
          left: 0;
          right: 0;
          bottom: 0;
          z-index: 150;
          background: var(--bg-primary);
          border-right: none;
          padding: 24px;
        }

        .docs-sidebar.open {
          display: block;
        }

        .docs-main {
          padding: 32px 20px 60px;
        }
      }
    </style>

    <script>
      import { initTheme } from '../theme.js';
      import { initI18n } from '../i18n/switcher.js';
      initTheme();
      initI18n();

      document.querySelectorAll('pre').forEach((pre) => {
        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'copy';
        btn.addEventListener('click', () => {
          navigator.clipboard?.writeText(pre.innerText.replace(/\ncopy$/, ''));
          btn.textContent = 'copied';
          setTimeout(() => { btn.textContent = 'copy'; }, 1500);
        });
        pre.style.position = 'relative';
        pre.appendChild(btn);
      });

      const toggle = document.getElementById('docs-menu-toggle');
      const sidebar = document.getElementById('docs-sidebar');
      toggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('open');
      });

      const headings = document.querySelectorAll('.docs-content h2, .docs-content h3');
      const tocNav = document.getElementById('toc-nav');
      if (tocNav && headings.length > 0) {
        headings.forEach((heading) => {
          const id = heading.id || heading.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || '';
          if (!heading.id) heading.id = id;
          const link = document.createElement('a');
          link.href = `#${id}`;
          link.textContent = heading.textContent || '';
          link.className = heading.tagName === 'H3' ? 'toc-h3' : 'toc-h2';
          tocNav.appendChild(link);
        });

        const tocLinks = tocNav.querySelectorAll('a');
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                tocLinks.forEach((link) => link.classList.remove('active'));
                const active = tocNav.querySelector(`a[href="#${entry.target.id}"]`);
                if (active) active.classList.add('active');
              }
            });
          },
          { rootMargin: '-80px 0px -70% 0px' }
        );
        headings.forEach((heading) => observer.observe(heading));
      }
    </script>
  </body>
</html>
