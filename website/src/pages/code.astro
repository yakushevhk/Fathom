---
import Layout from '../layouts/Layout.astro';

const version = '0.3';
const downloadUrl = 'https://cloud.y7.hk/code/parallel-code-v0.3.zip';

const workspaces = [
  {
    name: 'rust/ - Parallel CLI',
    crates: [
      { name: 'parallel', desc: 'Main binary - CLI, agent loop, update, doctor' },
      { name: 'parallel-core', desc: 'Agent loop, planning, executor, goals, consensus' },
      { name: 'parallel-tools', desc: '37 built-ins: file, shell, AST, DAP, browser, eval, security, memory' },
      { name: 'parallel-llm', desc: 'LLM client abstraction (streaming, models)' },
      { name: 'parallel-tui', desc: 'Terminal UI - ratatui chat, dashboard, diff viewer' },
      { name: 'parallel-config', desc: 'TOML-based configuration loader' },
      { name: 'parallel-common', desc: 'Shared utilities - shell, path, token counter' },
      { name: 'parallel-memory', desc: 'Durable memory with vector search and decay' },
      { name: 'parallel-session', desc: 'SQLite-backed session persistence and fork' },
      { name: 'parallel-server', desc: 'HTTP API server - axum, SSE, WebSocket, auth' },
      { name: 'parallel-orchestrator', desc: 'Multi-agent orchestration and tree manager' },
      { name: 'parallel-mcp', desc: 'MCP protocol client and server' },
      { name: 'parallel-lsp', desc: 'Language Server Protocol integration' },
      { name: 'parallel-permissions', desc: 'Permission system - plan/build/edit/yolo/auto' },
      { name: 'parallel-stability', desc: 'Checkpoint, shutdown, notification' },
      { name: 'parallel-plugins', desc: 'Plugin system - WASM, lifecycle hooks' },
    ]
  },
  {
    name: 'research-agent/ - Parallel Research',
    crates: [
      { name: 'parallel-research', desc: 'Main binary - bench, run, serve, tui' },
      { name: 'pr-core', desc: 'Agent core - context, skills, hooks, billing' },
      { name: 'pr-agent', desc: 'Hierarchical sub-agents, coordinator, process manager' },
      { name: 'pr-tools', desc: 'OSINT/lead-gen tools - extract, search, verify, enrich' },
      { name: 'pr-llm', desc: 'LLM client - streaming, models, token counting' },
      { name: 'pr-tui', desc: 'Terminal UI - ratatui dashboard, sessions, agents tree' },
      { name: 'pr-server', desc: 'HTTP API - axum, SSE, dashboard, metrics' },
      { name: 'pr-mcp', desc: 'MCP client (stdio/HTTP/OAuth) and server' },
      { name: 'pr-lsp', desc: 'LSP integration - auto-detect, install, format' },
      { name: 'pr-persistence', desc: 'SQLite/PostgreSQL - contacts, jobs, history' },
      { name: 'pr-memory', desc: 'Semantic memory - entity graph, vector search, BM25' },
      { name: 'parallel-gui', desc: 'Desktop GUI - gpui native application' },
    ]
  }
];

const techStack = [
  { category: 'Language', items: 'Rust 2021 edition' },
  { category: 'Async Runtime', items: 'tokio (full)' },
  { category: 'CLI', items: 'clap (derive)' },
  { category: 'Serialization', items: 'serde, serde_json, serde_yaml, toml' },
  { category: 'HTTP', items: 'reqwest, axum (with WebSocket)' },
  { category: 'Database', items: 'rusqlite (SQLite), tokio-postgres + deadpool (PostgreSQL)' },
  { category: 'TUI', items: 'ratatui + crossterm' },
  { category: 'HTML Parsing', items: 'scraper, quick-xml' },
  { category: 'GUI', items: 'gpui (native desktop)' },
  { category: 'Error Handling', items: 'anyhow, thiserror' },
  { category: 'Logging', items: 'tracing + tracing-subscriber' },
  { category: 'Utilities', items: 'uuid, chrono, regex, globset, walkdir, similar, url, sha2, tempfile' },
  { category: 'WebSocket', items: 'tokio-tungstenite' },
  { category: 'Archiving', items: 'tar, flate2, zip' },
  { category: 'MCP', items: 'Model Context Protocol (client + server)' },
];
---

<Layout title="Code - Parallel">
  <main class="code-page">
    <div class="container">
      <div class="code-hero">
        <p class="eyebrow">Source Code</p>
        <h1 class="h2-sec">Parallel Rust <span class="muted">v{version}</span></h1>
        <p class="copy-lg mx-auto">Complete Rust source code of the Parallel project.</p>
      </div>

      <div class="stats-row">
        <div class="stat-card">
          <span class="stat-value">141,440</span>
          <span class="stat-label">Lines of Rust</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">314</span>
          <span class="stat-label">Source Files</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">28</span>
          <span class="stat-label">Crates</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">v{version}</span>
          <span class="stat-label">Version</span>
        </div>
      </div>

      <div class="download-section">
        <a href={downloadUrl} class="btn btn-primary download-btn" download>
          Download All Rust Code (v{version})
        </a>
        <p class="download-meta">ZIP archive, 1.4 MB - hosted on S3</p>
      </div>

      <div class="workspace-section">
        <h2 class="sec-head">Workspaces</h2>

        {
          workspaces.map((ws) => (
            <div class="ws-block">
              <h3 class="ws-name">{ws.name}</h3>
              <div class="crate-grid">
                {
                  ws.crates.map((c) => (
                    <div class="crate-card">
                      <code class="crate-name">{c.name}</code>
                      <p class="crate-desc">{c.desc}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>

      <div class="stack-section">
        <h2 class="sec-head">Tech Stack</h2>
        <div class="stack-table">
          {
            techStack.map((row) => (
              <div class="stack-row">
                <span class="stack-cat">{row.category}</span>
                <span class="stack-items">{row.items}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .code-page { padding: 70px 0 90px; }
  .code-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .code-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .code-hero h1 .muted { color: var(--grey-500); font-size: 0.55em; }
  .code-hero .copy-lg { margin-top: 20px; }
  .stats-row { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; margin-bottom: 48px; }
  .stat-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 28px 36px; text-align: center; min-width: 160px; transition: box-shadow .25s, transform .25s var(--ease-out); }
  .stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .stat-value { display: block; font-size: 32px; font-weight: 600; letter-spacing: -0.02em; color: var(--grey-900); }
  .stat-label { display: block; font-size: 13px; color: var(--grey-600); margin-top: 4px; font-family: var(--font-mono); }
  .download-section { text-align: center; margin-bottom: 64px; }
  .download-btn { font-size: 16px; padding: 14px 32px; }
  .download-meta { color: var(--grey-500); font-size: 13px; margin-top: 10px; }
  .sec-head { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 24px; color: var(--grey-900); }
  .workspace-section { max-width: 900px; margin: 0 auto 64px; }
  .ws-block { margin-bottom: 36px; }
  .ws-name { font-size: 17px; font-weight: 600; margin-bottom: 14px; color: var(--grey-700); font-family: var(--font-mono); }
  .crate-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .crate-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-md); padding: 16px; transition: border-color .2s; }
  .crate-card:hover { border-color: var(--grey-400); }
  .crate-name { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--grey-900); }
  .crate-desc { font-size: 13px; color: var(--grey-600); margin-top: 6px; line-height: 1.5; }
  .stack-section { max-width: 700px; margin: 0 auto; }
  .stack-table { display: flex; flex-direction: column; gap: 1px; background: var(--grey-200); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); overflow: hidden; }
  .stack-row { display: grid; grid-template-columns: 160px 1fr; gap: 16px; padding: 12px 20px; background: var(--bg-card); }
  .stack-row:nth-child(even) { background: var(--grey-100); }
  .stack-cat { font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--grey-700); text-transform: uppercase; letter-spacing: 0.04em; }
  .stack-items { font-size: 14px; color: var(--grey-800); line-height: 1.5; }
</style>