---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const workspaces = [
  {
    name: 'Fathom Rust workspace',
    key: 'main',
    crates: [
      { name: 'pr-core', key: 'core', desc: 'Shared agent types, coordination, steering and in-process async jobs' },
      { name: 'pr-llm', key: 'llm', desc: 'Streaming LLM provider abstraction' },
      { name: 'pr-agent', key: 'agent', desc: 'Hierarchical agents, batch spawn, output schemas and handoff' },
      { name: 'pr-tools', key: 'tools', desc: '51 always-registered tools, plus up to 5 CDP browser tools and up to 6 computer tools when configured' },
      { name: 'pr-mcp', key: 'mcp', desc: 'MCP client and server integration' },
      { name: 'pr-persistence', key: 'persistence', desc: 'SQLite/PostgreSQL sessions, contacts and durable jobs' },
      { name: 'pr-memory', key: 'memory', desc: 'Semantic memory with vector search, BM25 and entity graph' },
      { name: 'pr-server', key: 'server', desc: 'HTTP API, SSE events, steering, jobs and daemon management' },
      { name: 'pr-tui', key: 'tui', desc: 'Terminal interface for live sessions, agents and approvals' },
      { name: 'pr-lsp', key: 'lsp', desc: 'Language Server Protocol tool integration' },
      { name: 'pr-governance', key: 'governance', desc: 'Policy, capability and coordination governance' },
      { name: 'pr-supervisor', key: 'supervisor', desc: 'Supervisor and lifecycle runtime services' },
    ],
  }
];

const features = [
  { key: 'discovery', text: 'IrcBus and AgentRegistry for peer discovery and hub messaging' },
  { key: 'lifecycle', text: 'Steering plus park/revive lifecycle controls' },
  { key: 'batch', text: 'Batch spawn with output_schema, isolated workers and handoff' },
  { key: 'jobs', text: 'In-process async jobs and daemon management' },
];

const techStack = [
  { category: 'Language', key: 'lang', items: 'Rust 2021 edition' },
  { category: 'Async Runtime', key: 'runtime', items: 'tokio (full)' },
  { category: 'CLI', key: 'cli', items: 'clap (derive) — the fathom binary' },
  { category: 'Serialization', key: 'serialization', items: 'serde, serde_json, toml' },
  { category: 'HTTP', key: 'http', items: 'reqwest, axum, SSE' },
  { category: 'Database', key: 'database', items: 'rusqlite (SQLite), tokio-postgres + deadpool (PostgreSQL)' },
  { category: 'TUI', key: 'tui', items: 'ratatui + crossterm' },
  { category: 'LSP', key: 'lsp', items: 'Language Server Protocol integration' },
  { category: 'MCP', key: 'mcp', items: 'Model Context Protocol (client + server)' },
];
---

<Layout title="Code & Tools - Fathom">
  <main class="code-page">
        <PageHero cls="code-hero">
        <p class="eyebrow" data-i18n="code.hero.badge">Source &amp; runtime map</p>
        <h1 class="h2-sec" data-i18n-html data-i18n="code.hero.title">Source &amp; runtime, <em class="it">mapped.</em></h1>
        <p class="copy-lg mx-auto" data-i18n="code.hero.sub">A current map of the Fathom binary, its 12 workspace crates, and the tools available at runtime.</p>
    </PageHero>
    <div class="container">

      <div class="stats-row">
        <div class="stat-card">
          <span class="stat-value">12</span>
          <span class="stat-label" data-i18n="code.stats.crates">Workspace crates</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">51 + 5</span>
          <span class="stat-label" data-i18n="code.stats.tools">Built-ins + conditional browser tools</span>
        </div>
        <div class="stat-card">
          <span class="stat-value">fathom</span>
          <span class="stat-label" data-i18n="code.stats.binary">Binary</span>
        </div>
      </div>

      <div class="download-section">
        <p class="copy-lg mx-auto" data-i18n="code.download.text">Fathom is distributed as a single binary rather than a stale archive download. Browse the source repository and build the workspace with Cargo.</p>
        <a href="https://github.com/yakushevhk/Fathom" class="btn btn-primary download-btn" data-i18n="code.download.btn">View Fathom on GitHub</a>
      </div>

      <div class="workspace-section">
        <h2 class="sec-head" data-i18n="code.features.title">Current coordination and runtime</h2>
        <ul class="feature-list">
          {features.map((feature) => <li data-i18n={'code.features.items.' + feature.key}>{feature.text}</li>)}
        </ul>
      </div>

      <div class="workspace-section">
        <h2 class="sec-head" data-i18n="code.workspace.title">Workspace crates</h2>

        {
          workspaces.map((ws) => (
            <div class="ws-block">
              <h3 class="ws-name" data-i18n="code.workspace.name">{ws.name}</h3>
              <div class="crate-grid">
                {
                  ws.crates.map((c) => (
                    <div class="crate-card">
                      <code class="crate-name">{c.name}</code>
                      <p class="crate-desc" data-i18n={'code.workspace.crates.' + c.key + '.desc'}>{c.desc}</p>
                    </div>
                  ))
                }
              </div>
            </div>
          ))
        }
      </div>

      <div class="stack-section">
        <h2 class="sec-head" data-i18n="code.techStack.title">Tech Stack</h2>
        <div class="stack-table">
          {
            techStack.map((row) => (
              <div class="stack-row">
                <span class="stack-cat" data-i18n={'code.techStack.rows.' + row.key + '.cat'}>{row.category}</span>
                <span class="stack-items" data-i18n={'code.techStack.rows.' + row.key + '.items'}>{row.items}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .code-page { padding: 70px 0 90px; }
  .code-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .code-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .code-hero h1 .muted { color: var(--grey-500); font-size: 0.55em; }
  .code-hero .copy-lg { margin-top: 20px; }
  .stats-row { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; margin-bottom: 48px; }
  .stat-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 28px 36px; text-align: center; min-width: 160px; transition: box-shadow .25s, transform .25s var(--ease-out); }
  .stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .stat-value { display: block; font-size: 32px; font-weight: 600; letter-spacing: -0.02em; color: var(--grey-900); }
  .stat-label { display: block; font-size: 13px; color: var(--grey-600); margin-top: 4px; font-family: var(--font-mono); }
  .download-section { text-align: center; margin-bottom: 64px; }
  .download-btn { font-size: 16px; padding: 14px 32px; }
  .download-meta { color: var(--grey-500); font-size: 13px; margin-top: 10px; }
  .feature-list { display: grid; gap: 10px; margin: 0 0 28px; padding-left: 22px; color: var(--grey-700); line-height: 1.55; }
  .sec-head { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; margin-bottom: 24px; color: var(--grey-900); }
  .workspace-section { max-width: 900px; margin: 0 auto 64px; }
  .ws-block { margin-bottom: 36px; }
  .ws-name { font-size: 17px; font-weight: 600; margin-bottom: 14px; color: var(--grey-700); font-family: var(--font-mono); }
  .crate-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
  .crate-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-md); padding: 16px; transition: border-color .2s; }
  .crate-card:hover { border-color: var(--grey-400); }
  .crate-name { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--grey-900); }
  .crate-desc { font-size: 13px; color: var(--grey-600); margin-top: 6px; line-height: 1.5; }
  .stack-section { max-width: 700px; margin: 0 auto; }
  .stack-table { display: flex; flex-direction: column; gap: 1px; background: var(--grey-200); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); overflow: hidden; }
  .stack-row { display: grid; grid-template-columns: 160px 1fr; gap: 16px; padding: 12px 20px; background: var(--bg-card); }
  .stack-row:nth-child(even) { background: var(--grey-100); }
  .stack-cat { font-family: var(--font-mono); font-size: 12px; font-weight: 600; color: var(--grey-700); text-transform: uppercase; letter-spacing: 0.04em; }
  .stack-items { font-size: 14px; color: var(--grey-800); line-height: 1.5; }
</style>