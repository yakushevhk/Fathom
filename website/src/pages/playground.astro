---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Playground — Fathom Research" description="Interactive console: launch research, watch agents live, browse memory, manage jobs and inspect metrics — all against your local Fathom server.">
  <main class="pg-page">
    <div class="container">
      <!-- Hero -->
      <div class="pg-hero">
        <p class="eyebrow" data-i18n="playground.hero.badge">Playground</p>
        <h1 class="h2-sec" data-i18n="playground.hero.title">Deep research, live.</h1>
        <p class="copy-lg mx-auto" data-i18n="playground.hero.sub">Launch a research session, watch the agent fleet work in real time, steer it mid-run, browse long-term memory, manage background jobs and inspect live metrics — the whole platform in one console.</p>
      </div>

      <!-- Console: connection + composer -->
      <section class="pg-console reveal">
        <div class="pg-connbar">
          <span class="pg-dot" id="pg-dot"></span>
          <span class="pg-conn-text" id="pg-conn-text" data-i18n="playground.conn.connecting">connecting…</span>
          <span class="pg-conn-spacer"></span>
          <button class="pg-ghost-btn" id="pg-settings-btn" data-i18n="playground.conn.settings">Settings</button>
        </div>

        <div class="pg-settings" id="pg-settings" hidden>
          <label class="pg-field">
            <span data-i18n="playground.conn.url">Fathom server URL</span>
            <input id="pg-url" type="text" spellcheck="false" placeholder="http://127.0.0.1:8080" />
          </label>
          <label class="pg-field">
            <span data-i18n="playground.conn.key">API key</span>
            <input id="pg-key" type="password" spellcheck="false" placeholder="FATHOM_API_KEYS" />
          </label>
          <div class="pg-settings-actions">
            <p class="pg-hint" data-i18n="playground.conn.hint">Start the Fathom server with: fathom serve --port 8080 (set FATHOM_API_KEYS to enable authenticated access).</p>
            <button class="btn btn-primary" id="pg-save-settings" data-i18n="playground.conn.save">Save &amp; reconnect</button>
          </div>
        </div>

        <div class="pg-composer">
          <textarea id="pg-query" rows="3" data-i18n-placeholder="playground.composer.placeholder" placeholder="What should we research? e.g. “Map the competitive landscape of AI research agents — pricing, features, traction”"></textarea>
          <div class="pg-composer-actions">
            <span class="pg-endpoint">POST /api/v1/sessions</span>
            <button class="btn btn-primary" id="pg-run" data-i18n="playground.composer.run">Run research</button>
          </div>
        </div>
      </section>

      <!-- Tabs -->
      <nav class="pg-tabs" id="pg-tabs">
        <button class="pg-tab active" data-tab="research" data-i18n="playground.tabs.research">Research</button>
        <button class="pg-tab" data-tab="fleet" data-i18n="playground.tabs.fleet">Fleet</button>
        <button class="pg-tab" data-tab="memory" data-i18n="playground.tabs.memory">Memory</button>
        <button class="pg-tab" data-tab="jobs" data-i18n="playground.tabs.jobs">Jobs</button>
        <button class="pg-tab" data-tab="metrics" data-i18n="playground.tabs.metrics">Metrics</button>
      </nav>

      <!-- Workspace -->
      <section class="pg-workspace">
        <aside class="pg-sidebar">
          <div class="pg-panel-head">
            <h3 data-i18n="playground.sessions.title">Sessions</h3>
            <button class="pg-ghost-btn" id="pg-refresh-sessions" title="Refresh">⟳</button>
          </div>
          <div class="pg-session-list" id="pg-session-list">
            <div class="pg-empty" data-i18n="playground.sessions.empty">No sessions yet — run your first research above.</div>
          </div>
        </aside>

        <div class="pg-main">
          <!-- ===== TAB: RESEARCH (live session) ===== -->
          <div class="pg-tabpane active" id="pg-pane-research">
            <div class="pg-statusbar" id="pg-statusbar" hidden>
              <div class="pg-status-main">
                <span class="pg-badge pg-badge-idle" id="pg-s-status">—</span>
                <span class="pg-s-query" id="pg-s-query"></span>
              </div>
              <div class="pg-status-meta">
                <span class="pg-meta-item"><span class="pg-meta-k" data-i18n="playground.status.agents">agents</span> <b id="pg-s-agents">0</b></span>
                <span class="pg-meta-item"><span class="pg-meta-k" data-i18n="playground.status.tokens">tokens</span> <b id="pg-s-tokens">0</b></span>
                <span class="pg-meta-item"><span class="pg-meta-k" data-i18n="playground.status.elapsed">elapsed</span> <b id="pg-s-elapsed">0s</b></span>
                <button class="pg-ghost-btn pg-danger" id="pg-cancel" data-i18n="playground.status.cancel">Cancel</button>
              </div>
            </div>

            <div class="pg-panels">
              <div class="pg-panel">
                <div class="pg-panel-head"><h4 data-i18n="playground.agents.title">Agent fleet</h4><span class="pg-count" id="pg-agent-count">0</span></div>
                <div class="pg-agent-tree" id="pg-agent-tree">
                  <div class="pg-empty" data-i18n="playground.agents.empty">Agents appear here as they spawn.</div>
                </div>
              </div>
              <div class="pg-panel">
                <div class="pg-panel-head">
                  <h4 data-i18n="playground.feed.title">Live activity</h4>
                  <div class="pg-feed-ctrl">
                    <button class="pg-ghost-btn pg-feed-scope active" id="pg-feed-scope-session" data-i18n="playground.feed.scopeThis">This session</button>
                    <button class="pg-ghost-btn pg-feed-scope" id="pg-feed-scope-all" data-i18n="playground.feed.scopeAll">All sessions</button>
                    <span class="pg-live-tag" id="pg-live-tag" hidden>● live</span>
                  </div>
                </div>
                <div class="pg-feed" id="pg-feed">
                  <div class="pg-empty" data-i18n="playground.feed.empty">Waiting for events…</div>
                </div>
              </div>
            </div>

            <div class="pg-panel pg-stream-panel" id="pg-stream-panel" hidden>
              <div class="pg-panel-head">
                <h4 data-i18n="playground.stream.title">Model stream</h4>
                <span class="pg-stream-agent" id="pg-stream-agent"></span>
              </div>
              <div class="pg-stream" id="pg-stream"></div>
            </div>

            <div class="pg-panel pg-agent-detail" id="pg-agent-detail" hidden>
              <div class="pg-panel-head">
                <h4 data-i18n="playground.agentDetail.title">Agent detail</h4>
                <button class="pg-ghost-btn" id="pg-agent-detail-close" data-i18n="playground.agentDetail.close">Close</button>
              </div>
              <div class="pg-agent-detail-body" id="pg-agent-detail-body"></div>
            </div>

            <div class="pg-panel pg-findings" id="pg-live-findings" hidden>
              <div class="pg-panel-head">
                <h4 data-i18n="playground.findings.title">Findings</h4>
                <span class="pg-findings-count" id="pg-findings-count">0</span>
              </div>
              <div class="pg-live-findings-body" id="pg-live-findings-body"><div class="pg-empty" data-i18n="playground.findings.empty">No findings captured in this live view yet.</div></div>
            </div>

            <div class="pg-prompts" id="pg-prompts"></div>

            <div class="pg-steer" id="pg-steer" hidden>
              <input id="pg-steer-input" type="text" data-i18n-placeholder="playground.steer.placeholder" placeholder="Steer the research — add instructions mid-run…" />
              <button class="btn btn-primary" id="pg-steer-btn" data-i18n="playground.steer.send">Send</button>
            </div>

            <div class="pg-panel pg-results" id="pg-results-panel" hidden>
              <div class="pg-panel-head">
                <h4 data-i18n="playground.results.title">Report</h4>
                <div class="pg-report-actions">
                  <button class="pg-ghost-btn" id="pg-report-copy" data-i18n="playground.report.copy">Copy markdown</button>
                  <button class="pg-ghost-btn" id="pg-report-download" data-i18n="playground.report.download">Download .md</button>
                  <span class="pg-results-meta" id="pg-results-meta"></span>
                </div>
              </div>
              <div class="pg-results-body" id="pg-results"></div>
            </div>

            <div class="pg-placeholder" id="pg-placeholder">
              <p data-i18n="playground.main.placeholder">Run a query or pick a session on the left — the live view opens here.</p>
            </div>
          </div>

          <!-- ===== TAB: FLEET (all agents) ===== -->
          <div class="pg-tabpane" id="pg-pane-fleet">
            <div class="pg-pane-head">
              <h4 data-i18n="playground.fleet.title">All agents</h4>
              <div class="pg-pane-actions">
                <button class="pg-ghost-btn" id="pg-fleet-refresh">⟳ Refresh</button>
              </div>
            </div>
            <div class="pg-table-wrap">
              <table class="pg-table" id="pg-fleet-table">
                <thead><tr><th>id</th><th>session</th><th>role</th><th>status</th><th>task</th><th>tokens</th></tr></thead>
                <tbody><tr><td colspan="6" class="pg-empty">Loading…</td></tr></tbody>
              </table>
            </div>
          </div>

          <!-- ===== TAB: MEMORY ===== -->
          <div class="pg-tabpane" id="pg-pane-memory">
            <div class="pg-mem-stats" id="pg-mem-stats"><div class="pg-empty">Loading memory stats…</div></div>

            <div class="pg-panel">
              <div class="pg-panel-head"><h4 data-i18n="playground.memory.search">Search memories</h4></div>
              <div class="pg-mem-search">
                <input id="pg-mem-q" type="text" data-i18n-placeholder="playground.memory.searchPh" placeholder="Semantic query (hybrid search)…" />
                <select id="pg-mem-scope">
                  <option value="">all scopes</option>
                  <option value="agent">agent</option>
                  <option value="user">user</option>
                  <option value="run">run</option>
                </select>
                <button class="btn btn-primary" id="pg-mem-search-btn" data-i18n="playground.memory.search">Search</button>
                <button class="pg-ghost-btn" id="pg-mem-list-btn" data-i18n="playground.memory.listAll">List all</button>
              </div>
              <div class="pg-mem-results" id="pg-mem-results"><div class="pg-empty">Run a search to see memories.</div></div>
            </div>

            <div class="pg-panel">
              <div class="pg-panel-head"><h4 data-i18n="playground.memory.absorb">Absorb facts</h4><span class="pg-endpoint">POST /memories/absorb</span></div>
              <div class="pg-mem-absorb">
                <label class="pg-field"><span data-i18n="playground.memory.source">Source</span><input id="pg-abs-source" type="text" placeholder="manual" /></label>
                <label class="pg-field"><span data-i18n="playground.memory.scope">Scope</span>
                  <select id="pg-abs-scope"><option value="">default</option><option value="agent">agent</option><option value="user">user</option><option value="run">run</option></select>
                </label>
                <label class="pg-field pg-field-grow"><span data-i18n="playground.memory.facts">Facts (one per line)</span>
                  <textarea id="pg-abs-facts" rows="3" placeholder="Rust was first released in 2010.&#10;Rust uses a borrow checker for memory safety."></textarea>
                </label>
                <button class="btn btn-primary" id="pg-abs-btn" data-i18n="playground.memory.absorb">Absorb</button>
              </div>
              <div class="pg-mem-report" id="pg-abs-report"></div>
            </div>

            <div class="pg-panel">
              <div class="pg-panel-head"><h4 data-i18n="playground.memory.maint">Maintenance</h4></div>
              <div class="pg-mem-maint">
                <div class="pg-mem-maint-block">
                  <span class="pg-mem-maint-label">Distill run → agent</span>
                  <label class="pg-check"><input id="pg-distill-dry" type="checkbox" checked /> dry_run</label>
                  <button class="pg-ghost-btn" id="pg-distill-btn">Distill</button>
                </div>
                <div class="pg-mem-maint-block">
                  <span class="pg-mem-maint-label">Garbage collect</span>
                  <label class="pg-field pg-field-inline"><span>TTL days</span><input id="pg-gc-ttl" type="number" value="30" style="width:70px" /></label>
                  <label class="pg-check"><input id="pg-gc-dry" type="checkbox" checked /> dry_run</label>
                  <button class="pg-ghost-btn" id="pg-gc-btn">Run GC</button>
                </div>
              </div>
              <div class="pg-mem-report" id="pg-maint-report"></div>
            </div>
          </div>

          <!-- ===== TAB: JOBS ===== -->
          <div class="pg-tabpane" id="pg-pane-jobs">
            <div class="pg-pane-head">
              <h4 data-i18n="playground.jobs.title">Background jobs</h4>
              <div class="pg-pane-actions">
                <button class="pg-ghost-btn" id="pg-jobs-refresh">⟳ Refresh</button>
              </div>
            </div>

            <div class="pg-panel">
              <div class="pg-panel-head"><h4 data-i18n="playground.jobs.new">New job</h4><span class="pg-endpoint">POST /api/v1/jobs</span></div>
              <div class="pg-job-create">
                <input id="pg-job-task" type="text" data-i18n-placeholder="playground.jobs.taskPh" placeholder="Task description…" />
                <label class="pg-field pg-field-inline"><span>attempts</span><input id="pg-job-attempts" type="number" value="3" min="1" max="10" style="width:80px" /></label>
                <button class="btn btn-primary" id="pg-job-create-btn" data-i18n="playground.jobs.create">Create</button>
              </div>
            </div>

            <div class="pg-table-wrap">
              <table class="pg-table" id="pg-jobs-table">
                <thead><tr><th>id</th><th>task</th><th>status</th><th>attempts</th><th>actions</th></tr></thead>
                <tbody><tr><td colspan="5" class="pg-empty">Loading…</td></tr></tbody>
              </table>
            </div>

            <div class="pg-panel" id="pg-joblog-panel" hidden>
              <div class="pg-panel-head">
                <h4 data-i18n="playground.jobs.log">Job log</h4>
                <span class="pg-stream-agent" id="pg-joblog-meta"></span>
              </div>
              <pre class="pg-joblog" id="pg-joblog"></pre>
            </div>
          </div>

          <!-- ===== TAB: METRICS ===== -->
          <div class="pg-tabpane" id="pg-pane-metrics">
            <div class="pg-pane-head">
              <h4 data-i18n="playground.metrics.title">Server metrics</h4>
              <div class="pg-pane-actions">
                <button class="pg-ghost-btn" id="pg-metrics-refresh">⟳ Refresh</button>
              </div>
            </div>
            <div class="pg-metric-cards" id="pg-metric-cards"><div class="pg-empty">Loading…</div></div>
            <div class="pg-panel">
              <div class="pg-panel-head"><h4 data-i18n="playground.metrics.raw">Raw (Prometheus)</h4></div>
              <pre class="pg-rawmetrics" id="pg-rawmetrics"></pre>
            </div>
          </div>
        </div>
      </section>

      <p class="pg-footnote" data-i18n="playground.footnote">The playground talks directly to your Fathom server over /api/v1 (REST + SSE) and /metrics. Nothing leaves your machine.</p>
    </div>
  </main>

  <style>
    .pg-page { padding: 72px 0 96px; }
    .pg-hero { text-align: center; max-width: 760px; margin: 0 auto 40px; }
    .pg-hero .copy-lg { color: var(--text-secondary); }

    .pg-console {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-xl);
      box-shadow: var(--shadow-md); overflow: hidden; margin-bottom: 20px;
    }
    .pg-connbar {
      display: flex; align-items: center; gap: 10px; padding: 10px 18px;
      border-bottom: 1px solid var(--border-light); background: var(--bg-secondary);
      font-size: 13px; color: var(--text-secondary);
    }
    .pg-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--grey-400); flex: none; transition: background .3s; }
    .pg-dot.ok { background: #3fae6a; box-shadow: 0 0 0 3px rgba(63,174,106,.15); }
    .pg-dot.bad { background: #d4574e; box-shadow: 0 0 0 3px rgba(212,87,78,.12); }
    .pg-conn-spacer { flex: 1; }
    .pg-ghost-btn {
      border: 1px solid var(--border); background: var(--bg-primary); color: var(--text-secondary);
      font-size: 12px; font-family: var(--font-mono); padding: 5px 10px; border-radius: var(--radius-sm); transition: all .15s; cursor: pointer;
    }
    .pg-ghost-btn:hover { color: var(--text-primary); border-color: var(--grey-400); }
    .pg-ghost-btn.pg-danger:hover { color: #d4574e; border-color: #d4574e; }
    .pg-ghost-btn:disabled { opacity: .5; cursor: default; }

    .pg-settings { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end; padding: 16px 18px; border-bottom: 1px solid var(--border-light); background: var(--bg-primary); }
    .pg-settings[hidden] { display: none; }
    .pg-field { display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--text-secondary); flex: 1; min-width: 200px; }
    .pg-field-inline { flex-direction: row; align-items: center; gap: 8px; min-width: auto; }
    .pg-field-grow { flex: 2 1 300px; }
    .pg-field input, .pg-field select, .pg-field textarea {
      border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 8px 10px; font-size: 13px;
      font-family: var(--font-mono); background: var(--bg-card); color: var(--text-primary);
    }
    .pg-field input:focus, .pg-field select:focus, .pg-field textarea:focus { outline: none; border-color: var(--grey-500); }
    .pg-settings-actions { display: flex; flex-direction: column; gap: 8px; align-items: flex-end; }
    .pg-hint { font-size: 11.5px; color: var(--text-tertiary); font-family: var(--font-mono); max-width: 420px; text-align: right; }

    .pg-composer { padding: 18px; display: flex; flex-direction: column; gap: 12px; }
    .pg-composer textarea {
      width: 100%; resize: vertical; border: 1px solid var(--border); border-radius: var(--radius-md);
      padding: 14px 16px; font-size: 15px; line-height: 1.55; font-family: var(--font-sans); background: var(--bg-primary); color: var(--text-primary);
    }
    .pg-composer textarea:focus { outline: none; border-color: var(--grey-500); box-shadow: 0 0 0 3px var(--accent-glow); }
    .pg-composer-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .pg-endpoint { font-family: var(--font-mono); font-size: 11.5px; color: var(--text-tertiary); }

    /* ---- Tabs ---- */
    .pg-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 20px; overflow-x: auto; }
    .pg-tab {
      border: none; background: none; cursor: pointer; padding: 12px 18px; font-size: 13px; font-family: var(--font-mono);
      font-weight: 600; color: var(--text-tertiary); border-bottom: 2px solid transparent; transition: all .15s; white-space: nowrap;
    }
    .pg-tab:hover { color: var(--text-secondary); }
    .pg-tab.active { color: var(--text-primary); border-bottom-color: var(--text-primary); }

    /* ---- Workspace ---- */
    .pg-workspace { display: grid; grid-template-columns: 280px 1fr; gap: 20px; align-items: start; }
    .pg-sidebar {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg);
      box-shadow: var(--shadow-sm); position: sticky; top: 84px; max-height: calc(100vh - 110px); display: flex; flex-direction: column;
    }
    .pg-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--border-light); }
    .pg-panel-head h3, .pg-panel-head h4 { margin: 0; font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--text-tertiary); }
    .pg-pane-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
    .pg-pane-head h4 { margin: 0; font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--text-tertiary); }
    .pg-pane-actions { display: flex; gap: 8px; }

    .pg-session-list { overflow-y: auto; padding: 8px; display: flex; flex-direction: column; gap: 6px; }
    .pg-session-item { border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 10px 12px; cursor: pointer; transition: all .15s; background: var(--bg-primary); }
    .pg-session-item:hover { border-color: var(--grey-400); }
    .pg-session-item.active { border-color: var(--grey-600); background: var(--bg-card-hover); }
    .pg-session-item .pg-si-q { font-size: 13px; color: var(--text-primary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 6px; line-height: 1.4; }
    .pg-session-item .pg-si-meta { display: flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 10.5px; color: var(--text-tertiary); }

    .pg-badge { display: inline-block; font-family: var(--font-mono); font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; padding: 2px 8px; border-radius: var(--radius-full); }
    .pg-badge-running { background: color-mix(in srgb, var(--sky) 24%, transparent); color: var(--text-primary); }
    .pg-badge-completed { background: color-mix(in srgb, var(--emerald) 30%, transparent); color: var(--text-primary); }
    .pg-badge-failed, .pg-badge-cancelled { background: color-mix(in srgb, var(--orange) 26%, transparent); color: var(--text-primary); }
    .pg-badge-idle, .pg-badge-spawned { background: var(--bg-tertiary); color: var(--text-secondary); }

    .pg-main { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
    .pg-tabpane { display: none; flex-direction: column; gap: 16px; }
    .pg-tabpane.active { display: flex; }

    .pg-statusbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 12px 16px; box-shadow: var(--shadow-sm); }
    .pg-statusbar[hidden] { display: none; }
    .pg-status-main { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .pg-s-query { font-size: 14px; font-weight: 500; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 460px; }
    .pg-status-meta { display: flex; align-items: center; gap: 14px; font-size: 12px; color: var(--text-secondary); }
    .pg-meta-item { font-family: var(--font-mono); font-size: 11.5px; }
    .pg-meta-k { color: var(--text-tertiary); }
    .pg-meta-item b { color: var(--text-primary); font-weight: 600; }

    .pg-panels { display: grid; grid-template-columns: 1fr 1.2fr; gap: 16px; }
    .pg-panel { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); min-width: 0; }
    .pg-panel-head .pg-count { font-family: var(--font-mono); font-size: 11px; color: var(--text-tertiary); border: 1px solid var(--border); border-radius: var(--radius-full); padding: 1px 8px; }
    .pg-live-tag { font-family: var(--font-mono); font-size: 10.5px; color: #3fae6a; animation: pg-pulse 1.6s ease-in-out infinite; }
