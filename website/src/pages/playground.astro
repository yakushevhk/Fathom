  </style>

  <script is:inline>
  (function () {
    'use strict';

    // ---------- config ----------
    var LS_URL = 'pg_fathom_url';
    var LS_KEY = 'pg_fathom_key';
    var cfg = {
      url: (localStorage.getItem(LS_URL) || 'http://127.0.0.1:8080').replace(/\/+$/, ''),
      key: localStorage.getItem(LS_KEY) || '',
    };

    var $ = function (id) { return document.getElementById(id); };
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function fmtNum(n) { n = Number(n) || 0; return n >= 1000 ? (n / 1000).toFixed(1) + 'k' : String(n); }
    function timeStr(d) { d = d || new Date(); return d.toTimeString().slice(0, 8); }

    function headers(json) {
      var h = {};
      if (cfg.key) h['X-Api-Key'] = cfg.key;
      if (json) h['Content-Type'] = 'application/json';
      return h;
    }
    function api(path, opts) {
      opts = opts || {};
      return fetch(cfg.url + '/api/v1' + path, {
        method: opts.method || 'GET',
        headers: headers(!!opts.body),
        body: opts.body ? JSON.stringify(opts.body) : undefined,
      }).then(function (r) {
        if (!r.ok) {
          return r.text().then(function (t) {
            var msg = 'HTTP ' + r.status;
            try { msg = (JSON.parse(t).error) || msg; } catch (e) { /* keep */ }
            throw new Error(msg);
          });
        }
        return r.status === 204 ? null : r.json();
      });
    }
    function rawGet(path) {
      return fetch(cfg.url + path, { headers: headers(false) }).then(function (r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.text();
      });
    }
    function badgeClass(status) {
      if (status === 'running') return 'pg-badge-running';
      if (status === 'completed') return 'pg-badge-completed';
      if (status === 'failed' || status === 'cancelled') return 'pg-badge-' + status;
      if (status === 'spawned') return 'pg-badge-spawned';
      return 'pg-badge-idle';
    }

    // ---------- els ----------
    var els = {
      dot: $('pg-dot'), connText: $('pg-conn-text'),
      settingsBtn: $('pg-settings-btn'), settings: $('pg-settings'),
      url: $('pg-url'), key: $('pg-key'), saveSettings: $('pg-save-settings'),
      query: $('pg-query'), run: $('pg-run'),
      sessionList: $('pg-session-list'), refreshSessions: $('pg-refresh-sessions'),
      statusbar: $('pg-statusbar'), sStatus: $('pg-s-status'), sQuery: $('pg-s-query'),
      sAgents: $('pg-s-agents'), sTokens: $('pg-s-tokens'), sElapsed: $('pg-s-elapsed'),
      cancel: $('pg-cancel'),
      agentTree: $('pg-agent-tree'), agentCount: $('pg-agent-count'),
      feed: $('pg-feed'), liveTag: $('pg-live-tag'),
      feedScopeSession: $('pg-feed-scope-session'), feedScopeAll: $('pg-feed-scope-all'),
      agentDetail: $('pg-agent-detail'), agentDetailBody: $('pg-agent-detail-body'), agentDetailClose: $('pg-agent-detail-close'),
      liveFindings: $('pg-live-findings'), liveFindingsBody: $('pg-live-findings-body'), findingsCount: $('pg-findings-count'),
      streamPanel: $('pg-stream-panel'), stream: $('pg-stream'), streamAgent: $('pg-stream-agent'),
      prompts: $('pg-prompts'),
      steer: $('pg-steer'), steerInput: $('pg-steer-input'), steerBtn: $('pg-steer-btn'),
      resultsPanel: $('pg-results-panel'), resultsMeta: $('pg-results-meta'), results: $('pg-results'),
      reportCopy: $('pg-report-copy'), reportDownload: $('pg-report-download'),
      placeholder: $('pg-placeholder'),
    };

    // ---------- state ----------
    var state = {
      sessions: [], current: null,
      agents: {}, agentOrder: [], prompts: {},
      selectedAgent: null, followAgent: null, streamAbort: null,
      statusTimer: null, startedAt: null, running: false, serverOk: false,
      findings: [], feedScope: 'session', currentReport: null,
      activeTab: 'research',
    };

    // ---------- tabs ----------
    function switchTab(name) {
      state.activeTab = name;
      document.querySelectorAll('.pg-tab').forEach(function (b) { b.classList.toggle('active', b.dataset.tab === name); });
      document.querySelectorAll('.pg-tabpane').forEach(function (p) { p.classList.toggle('active', p.id === 'pg-pane-' + name); });
      if (name === 'fleet') loadFleet();
      if (name === 'memory') loadMemoryStats();
      if (name === 'jobs') loadJobs();
      if (name === 'metrics') loadMetrics();
    }
    document.getElementById('pg-tabs').addEventListener('click', function (e) {
      var t = e.target.closest('.pg-tab');
      if (t) switchTab(t.dataset.tab);
    });

    // ---------- connection ----------
    function checkHealth() {
      return fetch(cfg.url + '/health', { headers: headers(false) })
        .then(function (r) { return r.json(); })
        .then(function (h) {
          state.serverOk = true;
          els.dot.className = 'pg-dot ok';
          els.connText.textContent = 'online · ' + (h.service || 'fathom') + ' v' + (h.version || '?') +
            (h.active_sessions ? ' · ' + h.active_sessions + ' active' : '');
        })
        .catch(function () {
          state.serverOk = false;
          els.dot.className = 'pg-dot bad';
          els.connText.textContent = 'offline — ' + cfg.url + ' unreachable (is the Fathom server running? cross-origin needs an API key)';
        });
    }
    els.settingsBtn.addEventListener('click', function () {
      els.settings.hidden = !els.settings.hidden;
      els.url.value = cfg.url; els.key.value = cfg.key;
    });
    els.saveSettings.addEventListener('click', function () {
      cfg.url = (els.url.value.trim() || 'http://127.0.0.1:8080').replace(/\/+$/, '');
      cfg.key = els.key.value.trim();
      localStorage.setItem(LS_URL, cfg.url); localStorage.setItem(LS_KEY, cfg.key);
      els.settings.hidden = true;
      checkHealth(); refreshSessions();
      if (state.current) openSession(state.current);
      if (state.activeTab !== 'research') switchTab(state.activeTab);
    });

    // ---------- sessions ----------
    function refreshSessions() {
      return api('/sessions').then(function (data) {
        state.sessions = (data.sessions || []).slice().sort(function (a, b) {
          return String(b.created_at || '').localeCompare(String(a.created_at || ''));
        });
        renderSessionList();
      }).catch(function () { /* offline banner already shown */ });
    }
    function renderSessionList() {
      if (!state.sessions.length) { els.sessionList.innerHTML = '<div class="pg-empty">No sessions yet — run your first research above.</div>'; return; }
      els.sessionList.innerHTML = state.sessions.map(function (s) {
        return '<div class="pg-session-item' + (s.id === state.current ? ' active' : '') + '" data-id="' + esc(s.id) + '">' +
          '<div class="pg-si-q">' + esc(s.query || '(no query)') + '</div>' +
          '<div class="pg-si-meta"><span class="pg-badge ' + badgeClass(s.status) + '">' + esc(s.status) + '</span>' +
          '<span>' + esc(String(s.id).slice(0, 8)) + '</span>' +
          (s.total_tokens ? '<span>' + fmtNum(s.total_tokens) + ' tk</span>' : '') + '</div></div>';
      }).join('');
    }
    els.sessionList.addEventListener('click', function (e) {
      var item = e.target.closest('.pg-session-item');
      if (item) { switchTab('research'); openSession(item.dataset.id); }
    });
    els.refreshSessions.addEventListener('click', refreshSessions);

    // ---------- run ----------
    els.run.addEventListener('click', runResearch);
    els.query.addEventListener('keydown', function (e) { if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') runResearch(); });
    function runResearch() {
      var q = els.query.value.trim();
      if (!q) { els.query.focus(); return; }
      if (!state.serverOk) { els.settings.hidden = false; return; }
      els.run.disabled = true; els.run.textContent = 'Starting…';
      api('/sessions', { method: 'POST', body: { query: q } }).then(function (s) {
        els.query.value = ''; refreshSessions(); switchTab('research'); openSession(s.id);
      }).catch(function (err) { alert('Failed to start session: ' + err.message); })
        .finally(function () { els.run.disabled = false; els.run.textContent = 'Run research'; });
    }

    // ---------- open session ----------
    function openSession(id) {
      state.current = id; state.agents = {}; state.agentOrder = []; state.prompts = {};
      state.selectedAgent = null; state.followAgent = null; state.startedAt = null; state.running = false;
      if (state.streamAbort) state.streamAbort.abort();
      if (state.statusTimer) clearInterval(state.statusTimer);

      els.placeholder.hidden = true; els.statusbar.hidden = false;
      els.feed.innerHTML = '<div class="pg-empty">Waiting for events…</div>';
      els.agentTree.innerHTML = '<div class="pg-empty">Agents appear here as they spawn.</div>';
      els.agentCount.textContent = '0';
      els.streamPanel.hidden = true; els.stream.textContent = '';
      els.prompts.innerHTML = ''; els.resultsPanel.hidden = true; els.results.innerHTML = '';
      els.steer.hidden = true; els.liveTag.hidden = true; els.cancel.hidden = false;
      els.agentDetail.hidden = true; els.agentDetailBody.innerHTML = '';
      els.liveFindings.hidden = true; els.liveFindingsBody.innerHTML = '<div class="pg-empty">No findings captured in this live view yet.</div>';
      state.findings = []; updateFindings();
      renderSessionList();

      api('/sessions/' + encodeURIComponent(id)).then(function (s) {
        els.sQuery.textContent = s.query || '';
        setSessionStatus(s.status);
        els.sAgents.textContent = s.total_agents || 0;
        els.sTokens.textContent = fmtNum(s.total_tokens || 0);
        state.startedAt = s.created_at ? new Date(s.created_at) : null;
        state.running = s.status === 'running';
        if (state.running) { if (state.feedScope === 'session') startStream(id); startStatusPolling(id); els.steer.hidden = false; els.liveTag.hidden = false; }
        else if (s.status === 'completed') loadResults(id);
        if (!state.running) hydrateAgents(id);
      }).catch(function (err) { els.sQuery.textContent = 'error: ' + err.message; });
    }
    function hydrateAgents(id) {
      api('/agents').then(function (data) {
        (data.agents || []).forEach(function (a) {
          if (a.session_id && a.session_id !== id) return;
          if (!state.agents[a.id]) {
            state.agents[a.id] = { role: a.role || 'agent', task: a.task || '', depth: 0, parent: a.parent_id || null, state: a.status || 'unknown', tokens: a.tokens_used || 0, stream: '' };
            state.agentOrder.push(a.id);
          } else {
            var ex = state.agents[a.id];
            ex.role = a.role || ex.role; ex.task = a.task || ex.task; ex.state = a.status || ex.state; ex.tokens = a.tokens_used || ex.tokens;
          }
        });
        renderAgents();
      }).catch(function () { /* optional */ });
    }
    function startStatusPolling(id) {
      if (state.statusTimer) clearInterval(state.statusTimer);
      state.statusTimer = setInterval(function () {
        if (state.current !== id) { clearInterval(state.statusTimer); return; }
        api('/sessions/' + encodeURIComponent(id)).then(function (s) {
          if (state.current !== id) return;
          setSessionStatus(s.status);
          els.sAgents.textContent = s.total_agents || 0;
          els.sTokens.textContent = fmtNum(s.total_tokens || 0);
          if (s.status !== 'running' && state.running) { state.running = false; onSessionFinished(s.status); }
        }).catch(function () { /* transient */ });
      }, 4000);
    }
    function setSessionStatus(status) { els.sStatus.textContent = status || '—'; els.sStatus.className = 'pg-badge ' + badgeClass(status); }
    setInterval(function () {
      if (!state.running || !state.startedAt) return;
      var s = Math.max(0, Math.floor((Date.now() - state.startedAt.getTime()) / 1000));
      var m = Math.floor(s / 60);
      els.sElapsed.textContent = m ? m + 'm ' + (s % 60) + 's' : s + 's';
    }, 1000);
    function onSessionFinished(status) {
      els.liveTag.hidden = true; els.steer.hidden = true; els.cancel.hidden = true;
      clearInterval(state.statusTimer); refreshSessions();
      if (status === 'completed' && state.current) loadResults(state.current);
      if (status === 'failed') pushFeed(null, 'session_failed', 'see status bar / server logs');
    }
    els.cancel.addEventListener('click', function () {
      if (!state.current || !confirm('Cancel this session?')) return;
      api('/sessions/' + encodeURIComponent(state.current), { method: 'DELETE' }).then(function () {
        state.running = false; onSessionFinished('cancelled'); setSessionStatus('cancelled');
      }).catch(function (err) { alert('Cancel failed: ' + err.message); });
    });

    // ---------- SSE over fetch ----------
    function startStream(id) {
      if (state.streamAbort) state.streamAbort.abort();
      var abort = new AbortController(); state.streamAbort = abort;
      var url = cfg.url + '/api/v1/sessions/' + encodeURIComponent(id) + '/events';
      connectSse(url, abort, function (ev) { handleEvent(ev); }, function () { return state.running; });
    }
    // Generic SSE consumer over fetch: builds a JSON event per chunk frame
    // and dispatches to `onEvent`. `shouldRetry` gates the reconnect loop.
    function connectSse(url, abort, onEvent, shouldRetry) {
      function connect(retries) {
        fetch(url, { headers: headers(false), signal: abort.signal })
          .then(function (res) {
            if (!res.ok || !res.body) throw new Error('HTTP ' + res.status);
            var reader = res.body.getReader(); var dec = new TextDecoder(); var buf = '';
            function pump() {
              return reader.read().then(function (chunk) {
                if (chunk.done) return;
                buf += dec.decode(chunk.value, { stream: true });
                var idx;
                while ((idx = buf.indexOf('\n\n')) >= 0) {
                  var frame = buf.slice(0, idx); buf = buf.slice(idx + 2);
                  frame.split('\n').forEach(function (line) {
                    if (line.indexOf('data:') !== 0) return;
                    try { onEvent(JSON.parse(line.slice(5))); } catch (e) { /* partial */ }
                  });
                }
                return pump();
              });
            }
            return pump();
          }).catch(function () {
            if (abort.signal.aborted) return;
            if (shouldRetry && shouldRetry() && retries > 0) { setTimeout(function () { connect(retries - 1); }, 2000); }
          });
      }
      connect(15);
    }

    // Global live feed from GET /api/v1/events — activity across every
    // session on the server. Lightweight: surfaces feed + findings only,
    // leaving the open session's agent tree / stream untouched.
    var feedAbort = null;
    function startGlobalFeed() {
      if (feedAbort) feedAbort.abort();
      var abort = new AbortController(); feedAbort = abort;
      els.feed.innerHTML = '';
      connectSse(cfg.url + '/api/v1/events', abort, function (ev) {
        if (!ev || !ev.type) return;
        var t = ev.type;
        var label = t, text = '';
        if (t === 'session_started') { label = 'session_started'; text = (ev.query || '').slice(0, 120); }
        else if (t === 'session_completed') { label = 'session_completed'; text = 'tokens ' + fmtNum(ev.total_tokens) + ' · ' + (ev.total_agents || 0) + ' agents'; }
        else if (t === 'session_failed') { label = 'session_failed'; text = ev.error || ''; }
        else if (t === 'agent_spawned') { label = 'agent_spawned'; text = (ev.role || 'agent') + ' · ' + (ev.task || ''); }
        else if (t === 'tool_call_started') { label = 'tool ▸ ' + (ev.tool || '?'); text = shortArgs(ev.args); }
        else if (t === 'tool_call_completed') { label = 'tool ✓ ' + (ev.tool || '?'); text = (ev.result_preview || '').slice(0, 140); }
        else if (t === 'finding') { var f = ev.finding || {}; state.findings.push(f); updateFindings(); label = 'finding'; text = (f.title || ''); }
        else if (t === 'agent_completed') { label = 'agent_completed'; text = (ev.summary || '').slice(0, 120); }
        else if (t === 'agent_failed') { label = 'agent_failed'; text = ev.error || ''; }
        else if (t === 'question_asked') { label = 'question_asked'; text = (ev.question || '').slice(0, 120); }
        else if (t === 'approval_requested') { label = 'approval_requested'; text = 'tool ' + (ev.tool || '?'); }
        else { label = t; }
        globalFeedLine(label, text, ev.agent_id || ev.id || null);
      }, function () { return true; });
    }
    function globalFeedLine(label, text, agentId) {
      var first = els.feed.querySelector('.pg-empty'); if (first) els.feed.innerHTML = '';
      var line = document.createElement('div'); line.className = 'pg-feed-line';
      line.innerHTML = '<span class="pg-feed-time">' + timeStr() + '</span>' +
        (agentId ? '<span class="pg-feed-role">' + esc(String(agentId).slice(0, 8)) + '</span>' : '') +
        '<span class="pg-feed-ev">' + esc(label) + '</span>' +
        '<span>' + esc(text || '') + '</span>';
      els.feed.prepend(line);
      while (els.feed.children.length > 300) els.feed.removeChild(els.feed.lastChild);
    }
    function stopGlobalFeed() { if (feedAbort) { feedAbort.abort(); feedAbort = null; } }

    // Feed scope toggle: 'session' vs 'all'.
    function setFeedScope(mode) {
      state.feedScope = mode;
      els.feedScopeSession.classList.toggle('active', mode === 'session');
      els.feedScopeAll.classList.toggle('active', mode === 'all');
      if (mode === 'all') {
        if (state.streamAbort) state.streamAbort.abort();
        state.streamAbort = null;
        stopGlobalFeed(); startGlobalFeed();
      } else {
        stopGlobalFeed();
        if (state.streamAbort) state.streamAbort.abort();
        state.streamAbort = null;
        if (state.current && state.running) startStream(state.current);
        if (!state.current) { els.feed.innerHTML = '<div class="pg-empty">Waiting for events…</div>'; }
      }
    }
    els.feedScopeSession.addEventListener('click', function () { setFeedScope('session'); });
    els.feedScopeAll.addEventListener('click', function () { setFeedScope('all'); });

    // ---------- events ----------
    function handleEvent(ev) {
      if (!ev || !ev.type) return;
      var t = ev.type;
      if (t === 'session_started') { state.startedAt = state.startedAt || new Date(); state.running = true; setSessionStatus('running'); pushFeed(null, 'session_started', ev.query || ''); return; }
      if (t === 'agent_spawned') { ensureAgent(ev.id, ev); var a = state.agents[ev.id]; a.role = ev.role || a.role; a.task = ev.task || a.task; a.depth = ev.depth || 0; a.parent = ev.parent || null; a.state = 'spawned'; renderAgents(); pushFeed(ev.id, 'spawned', (ev.role || 'agent') + ' · ' + (ev.task || '')); return; }
      if (t === 'agent_state_changed') { var ag = ensureAgent(ev.id); var st = ev.state && ev.state.state ? ev.state.state : String(ev.state || ''); ag.state = st; renderAgents(); pushFeed(ev.id, st, (ev.state && ev.state.sub_tasks) ? ev.state.sub_tasks.length + ' subtasks' : ''); return; }
      if (t === 'tool_call_started') { ensureAgent(ev.agent_id); pushFeed(ev.agent_id, 'tool ▸ ' + (ev.tool || '?'), shortArgs(ev.args)); return; }
      if (t === 'tool_call_completed') { ensureAgent(ev.agent_id); pushFeed(ev.agent_id, 'tool ✓ ' + (ev.tool || '?'), (ev.result_preview || '').slice(0, 140) + ' · ' + ((ev.duration_ms || 0) / 1000).toFixed(1) + 's'); return; }
      if (t === 'finding') { ensureAgent(ev.agent_id); var f = ev.finding || {}; state.findings.push(f); updateFindings(); pushFeed(ev.agent_id, 'finding', (f.title || '') + (f.confidence != null ? ' · conf ' + Number(f.confidence).toFixed(2) : ''), true); return; }
      if (t === 'llm_stream_chunk') { var sa = ensureAgent(ev.agent_id); sa.stream += ev.chunk || ''; state.followAgent = ev.agent_id; if (!state.selectedAgent) selectAgent(ev.agent_id, true); if (state.selectedAgent === ev.agent_id) renderStream(true); els.streamPanel.hidden = false; return; }
      if (t === 'agent_completed') { var ca = ensureAgent(ev.id); ca.state = 'complete'; ca.tokens = ev.tokens_used || ca.tokens; renderAgents(); pushFeed(ev.id, 'completed', (ev.summary || '').slice(0, 160) + ' · ' + fmtNum(ev.tokens_used) + ' tk'); return; }
      if (t === 'agent_failed') { var fa = ensureAgent(ev.id); fa.state = 'error'; renderAgents(); pushFeed(ev.id, 'failed', ev.error || ''); return; }
      if (t === 'session_completed') { state.running = false; setSessionStatus('completed'); els.sAgents.textContent = ev.total_agents || els.sAgents.textContent; els.sTokens.textContent = fmtNum(ev.total_tokens || 0); pushFeed(null, 'session_completed', fmtNum(ev.total_tokens) + ' tokens · ' + (ev.total_agents || 0) + ' agents'); onSessionFinished('completed'); return; }
      if (t === 'session_failed') { state.running = false; setSessionStatus('failed'); pushFeed(null, 'session_failed', ev.error || ''); onSessionFinished('failed'); return; }
      if (t === 'question_asked') { state.prompts[ev.request_id] = { kind: 'question', question: ev.question || '', agent_id: ev.agent_id }; renderPrompts(); return; }
      if (t === 'approval_requested') { state.prompts[ev.request_id] = { kind: 'approval', tool: ev.tool || '?', args: ev.args_preview || '', agent_id: ev.agent_id }; renderPrompts(); return; }
      pushFeed(ev.agent_id || null, t, '');
    }
    function shortArgs(args) { if (args == null) return ''; try { var s = typeof args === 'string' ? args : JSON.stringify(args); return s.length > 120 ? s.slice(0, 120) + '…' : s; } catch (e) { return ''; } }
    function ensureAgent(id, seed) {
      if (!state.agents[id]) {
        state.agents[id] = { role: (seed && seed.role) || 'agent', task: (seed && seed.task) || '', depth: (seed && seed.depth) || 0, parent: (seed && seed.parent) || null, state: 'spawned', tokens: 0, stream: '' };
        state.agentOrder.push(id);
      }
      return state.agents[id];
    }

    // ---------- rendering: agents/feed/stream ----------
    function renderAgents() {
      var ids = state.agentOrder.filter(function (id) { return state.agents[id]; });
      els.agentCount.textContent = String(ids.length);
      if (!ids.length) return;
      els.agentTree.innerHTML = ids.map(function (id) {
        var a = state.agents[id]; var indent = ''; var p = a.parent; var hops = 0;
        while (p && state.agents[p] && hops < 6) { indent += '\u00a0\u00a0\u00a0\u00a0'; p = state.agents[p].parent; hops++; }
        var stateCls = a.state === 'complete' ? 'complete' : (a.state === 'error' || a.state === 'failed' ? 'error' : '');
        return '<div class="pg-agent' + (state.selectedAgent === id ? ' selected' : '') + '" data-id="' + esc(id) + '" title="' + esc(a.task) + '">' +
          '<div class="pg-agent-top">' + (indent ? '<span class="pg-agent-depth">' + indent + '↳</span>' : '') +
          '<span class="pg-agent-role">' + esc(a.role) + '</span>' +
          '<span class="pg-agent-state ' + stateCls + '">' + esc(a.state) + '</span>' +
          '<span class="pg-agent-tokens">' + fmtNum(a.tokens) + ' tk</span></div>' +
          (a.task ? '<div class="pg-agent-task">' + esc(a.task) + '</div>' : '') + '</div>';
      }).join('');
    }
    els.agentTree.addEventListener('click', function (e) { var el = e.target.closest('.pg-agent'); if (el) selectAgent(el.dataset.id, false); });
    function selectAgent(id, auto) {
      state.selectedAgent = id;
      var a = state.agents[id];
      els.streamAgent.textContent = a ? (a.role + ' · ' + String(id).slice(0, 8)) : '';
      renderAgents(); renderStream(false);
      if (a && a.stream) els.streamPanel.hidden = false;
      loadAgentDetail(id);
    }
    els.agentDetailClose.addEventListener('click', function () { els.agentDetail.hidden = true; });

    // Fetch full agent detail from GET /api/v1/agents/:id (summary, session,
    // timestamps, parent). Falls back silently to the live in-memory record.
    function loadAgentDetail(id) {
      api('/agents/' + encodeURIComponent(id)).then(function (d) {
        if (state.selectedAgent !== id) return;
        els.agentDetail.hidden = false;
        var kv = '';
        kv += row('session', d.session_id || '—');
        kv += row('role', d.role || '—');
        kv += row('status', d.status || '—');
        kv += row('parent', d.parent_id || '—');
        kv += row('depth', d.depth != null ? String(d.depth) : '—');
        kv += row('tokens', d.tokens_used != null ? fmtNum(d.tokens_used) + ' tk' : '—');
        kv += row('created', d.created_at ? new Date(d.created_at).toLocaleString() : '—');
        kv += row('completed', d.completed_at ? new Date(d.completed_at).toLocaleString() : '—');
        var sum = d.summary ? '<div class="pg-ad-summary">' + mdToHtml(d.summary) + '</div>' : '';
        els.agentDetailBody.innerHTML = '<div class="pg-ad-kv">' + kv + '</div>' + sum;
      }).catch(function () {
        if (state.selectedAgent !== id) return;
        var a = state.agents[id];
        if (!a) return;
        els.agentDetail.hidden = false;
        els.agentDetailBody.innerHTML = '<div class="pg-ad-kv">' + row('role', a.role || '—') + row('status', a.state || '—') + row('task', a.task || '—') + '</div><div class="pg-empty">No extra detail on disk for this agent.</div>';
      });
    }
    function row(k, v) { return '<span class="k">' + esc(k) + '</span><span class="v">' + esc(String(v == null ? '—' : v)) + '</span>'; }

    // Live findings gathered from the candidate events. Each entry is the raw
    // Finding (title, content, confidence, sources). Click to expand.
    function updateFindings() {
      els.findingsCount.textContent = String(state.findings.length);
      if (!state.findings.length) {
        els.liveFindings.hidden = true;
        els.liveFindingsBody.innerHTML = '<div class="pg-empty">No findings captured in this live view yet.</div>';
        return;
      }
      els.liveFindings.hidden = false;
      els.liveFindingsBody.innerHTML = state.findings.slice().reverse().map(function (f, i) {
        var srcs = (f.sources || []).map(function (s) {
          var url = typeof s === 'string' ? s : (s.url || s.title || '');
          var label = typeof s === 'string' ? s : (s.title || s.url || 'source');
          if (!url && s === Object(s) && s.title) url = s.title;
          var isHttp = /^https?:\/\//.test(url);
          var domain = '';
          if (isHttp) { try { domain = new URL(url).hostname; } catch (e) { domain = ''; } }
          if (!url) return '';
          if (!isHttp) return '<span>' + esc(label) + '</span>';
          return '<a href="' + esc(url) + '" target="_blank" rel="noopener">' + esc(label) + (domain ? ' · ' + esc(domain) : '') + '</a>';
        }).filter(Boolean).join('');
        return '<details class="pg-finding-card"><summary>' + esc(f.title || 'finding') +
          (f.confidence != null ? '<span class="pg-finding-conf">conf ' + Number(f.confidence).toFixed(2) + '</span>' : '') +
          (srcs ? '<span class="pg-finding-conf">' + esc((f.sources || []).length) + ' src</span>' : '') +
          '</summary><div class="pg-finding-content">' + mdToHtml(f.content || '') +
          (srcs ? '<div class="pg-finding-srcs">' + srcs + '</div>' : '') + '</div></details>';
      }).join('');
    }
    function renderStream(appending) {
      var a = state.agents[state.selectedAgent]; if (!a) return;
      var text = a.stream || '';
      var atBottom = els.stream.scrollTop + els.stream.clientHeight >= els.stream.scrollHeight - 40;
      if (!appending || atBottom) {
        els.stream.textContent = text;
        if (state.running) { var cur = document.createElement('span'); cur.className = 'pg-stream-cursor'; els.stream.appendChild(cur); }
        els.stream.scrollTop = els.stream.scrollHeight;
      }
    }
    function pushFeed(agentId, label, text, strong) {
      var first = els.feed.querySelector('.pg-empty'); if (first) els.feed.innerHTML = '';
      var line = document.createElement('div'); line.className = 'pg-feed-line';
      var role = agentId && state.agents[agentId] ? state.agents[agentId].role : '';
      line.innerHTML = '<span class="pg-feed-time">' + timeStr() + '</span>' +
        (role ? '<span class="pg-feed-role">' + esc(role) + '</span>' : '') +
        '<span class="pg-feed-ev">' + esc(label) + '</span>' +
        '<span' + (strong ? ' class="pg-feed-finding"' : '') + '>' + esc(text || '') + '</span>';
      els.feed.prepend(line);
      while (els.feed.children.length > 300) els.feed.removeChild(els.feed.lastChild);
    }

    // ---------- prompts ----------
    function renderPrompts() {
      var ids = Object.keys(state.prompts);
      if (!ids.length) { els.prompts.innerHTML = ''; return; }
      els.prompts.innerHTML = ids.map(function (rid) {
        var p = state.prompts[rid];
        if (p.kind === 'question') {
          return '<div class="pg-prompt" data-rid="' + esc(rid) + '"><span class="pg-prompt-kind">Agent question</span>' +
            '<div class="pg-prompt-text">' + esc(p.question) + '</div>' +
            '<textarea rows="2" placeholder="Your answer…"></textarea>' +
            '<div class="pg-prompt-actions"><button class="btn btn-primary pg-answer">Answer</button></div></div>';
        }
        return '<div class="pg-prompt" data-rid="' + esc(rid) + '"><span class="pg-prompt-kind">Approval requested</span>' +
          '<div class="pg-prompt-text">Tool: <b>' + esc(p.tool) + '</b></div>' +
          (p.args ? '<div class="pg-prompt-args">' + esc(p.args) + '</div>' : '') +
          '<div class="pg-prompt-actions"><button class="pg-btn-deny pg-deny">Deny</button><button class="pg-btn-approve pg-approve">Approve</button></div></div>';
      }).join('');
    }
    els.prompts.addEventListener('click', function (e) {
      var card = e.target.closest('.pg-prompt'); if (!card || !state.current) return;
      var rid = card.dataset.rid; var base = '/sessions/' + encodeURIComponent(state.current);
      if (e.target.classList.contains('pg-answer')) {
        var text = card.querySelector('textarea').value.trim(); if (!text) return;
        api(base + '/answer', { method: 'POST', body: { request_id: rid, text: text } }).then(function () { delete state.prompts[rid]; renderPrompts(); }).catch(function (err) { alert(err.message); });
      } else if (e.target.classList.contains('pg-approve') || e.target.classList.contains('pg-deny')) {
        var approved = e.target.classList.contains('pg-approve');
        api(base + '/approve', { method: 'POST', body: { request_id: rid, approved: approved } }).then(function () { delete state.prompts[rid]; renderPrompts(); }).catch(function (err) { alert(err.message); });
      }
    });

    // ---------- steering ----------
    els.steerBtn.addEventListener('click', sendSteer);
    els.steerInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') sendSteer(); });
    function sendSteer() {
      var msg = els.steerInput.value.trim(); if (!msg || !state.current) return;
      els.steerBtn.disabled = true;
      api('/sessions/' + encodeURIComponent(state.current) + '/steer', { method: 'POST', body: { message: msg } })
        .then(function () { els.steerInput.value = ''; pushFeed(null, 'steer', msg); })
        .catch(function (err) { alert('Steer failed: ' + err.message); })
        .finally(function () { els.steerBtn.disabled = false; });
    }

    // ---------- results ----------
    function loadResults(id) {
      api('/sessions/' + encodeURIComponent(id) + '/results').then(function (r) {
        els.resultsPanel.hidden = false;
        els.resultsMeta.textContent = (r.output_dir || '') + ' · ' + fmtNum(r.total_tokens) + ' tokens · ' + (r.total_agents || 0) + ' agents';
        var html = '';
        if (r.summary) html += '<div class="pg-md">' + mdToHtml(r.summary) + '</div>';
        (r.findings || []).forEach(function (f) {
          html += '<details class="pg-finding-block"><summary>' + esc(f.file || 'finding') + '</summary><div class="pg-md">' + mdToHtml(f.content || '') + '</div></details>';
        });
        els.results.innerHTML = html || '<div class="pg-empty">No report files found.</div>';
        // Build the raw markdown bundle once for export.
        var md = r.summary ? '\n' + r.summary + '\n' : '';
        (r.findings || []).forEach(function (f) {
          md += '\n---\n\n## ' + (f.file || 'finding') + '\n\n' + (f.content || '') + '\n';
        });
        state.currentReport = { id: id, markdown: md.trim() };
      }).catch(function (err) { els.resultsPanel.hidden = false; els.results.innerHTML = '<div class="pg-error-banner">Results unavailable: ' + esc(err.message) + '</div>'; });
    }

    // ---------- report export ----------
    els.reportCopy.addEventListener('click', function () {
      var md = state.currentReport ? state.currentReport.markdown : '';
      if (!md) return;
      var done = function () {
        els.reportCopy.textContent = 'Copied ✓';
        setTimeout(function () { els.reportCopy.textContent = 'Copy markdown'; }, 1800);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(md).then(done).catch(function () { legacyCopy(md, done); });
      } else { legacyCopy(md, done); }
    });
    els.reportDownload.addEventListener('click', function () {
      var md = state.currentReport ? state.currentReport.markdown : '';
      if (!md) return;
      var blob = new Blob([md], { type: 'text/markdown' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = 'research-report' + (state.currentReport.id ? '-' + state.currentReport.id.slice(0, 8) : '') + '.md';
      document.body.appendChild(a); a.click();
      setTimeout(function () { document.body.removeChild(a); URL.revokeObjectURL(url); }, 0);
    });
    function legacyCopy(text, done) {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); done(); } catch (e) { /* noop */ }
      document.body.removeChild(ta);
    }

    // ---------- markdown ----------
    function inlineMd(s) {
      s = esc(s);
      s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
      s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      s = s.replace(/(^|[\s(])\*([^*\n]+)\*/g, '$1<em>$2</em>');
      s = s.replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
      return s;
    }
    function mdToHtml(md) {
      var lines = String(md || '').split(/\r?\n/); var html = ''; var inCode = false; var codeBuf = []; var listType = null; var para = [];
      function flushPara() { if (para.length) { html += '<p>' + inlineMd(para.join(' ')) + '</p>'; para = []; } }
      function flushList() { if (listType) { html += '</' + listType + '>'; listType = null; } }
      for (var i = 0; i < lines.length; i++) {
        var line = lines[i];
        if (/^```/.test(line)) { if (inCode) { html += '<pre><code>' + esc(codeBuf.join('\n')) + '</code></pre>'; codeBuf = []; inCode = false; } else { flushPara(); flushList(); inCode = true; } continue; }
        if (inCode) { codeBuf.push(line); continue; }
        var h = line.match(/^(#{1,4})\s+(.*)$/);
        if (h) { flushPara(); flushList(); html += '<h' + h[1].length + '>' + inlineMd(h[2]) + '</h' + h[1].length + '>'; continue; }
        if (/^\s*(---|\*\*\*)\s*$/.test(line)) { flushPara(); flushList(); html += '<hr>'; continue; }
        var bq = line.match(/^>\s?(.*)$/);
        if (bq) { flushPara(); flushList(); html += '<blockquote>' + inlineMd(bq[1]) + '</blockquote>'; continue; }
        var ul = line.match(/^\s*[-*]\s+(.*)$/);
        if (ul) { flushPara(); if (listType !== 'ul') { flushList(); html += '<ul>'; listType = 'ul'; } html += '<li>' + inlineMd(ul[1]) + '</li>'; continue; }
        var ol = line.match(/^\s*\d+[.)]\s+(.*)$/);
        if (ol) { flushPara(); if (listType !== 'ol') { flushList(); html += '<ol>'; listType = 'ol'; } html += '<li>' + inlineMd(ol[1]) + '</li>'; continue; }
        if (!line.trim()) { flushPara(); flushList(); continue; }
        para.push(line.trim());
      }
      flushPara(); flushList();
      if (inCode) html += '<pre><code>' + esc(codeBuf.join('\n')) + '</code></pre>';
      return html;
    }

    // ============================================================
    // FLEET TAB
    // ============================================================
    function loadFleet() {
      api('/agents').then(function (data) {
        var agents = data.agents || [];
        var tb = $('pg-fleet-table').querySelector('tbody');
        if (!agents.length) { tb.innerHTML = '<tr><td colspan="6" class="pg-empty">No agents.</td></tr>'; return; }
        tb.innerHTML = agents.map(function (a) {
          return '<tr><td class="pg-table-mono">' + esc(String(a.id).slice(0, 8)) + '</td>' +
            '<td class="pg-table-mono">' + esc(String(a.session_id || '').slice(0, 8)) + '</td>' +
            '<td><span class="pg-agent-role">' + esc(a.role || '?') + '</span></td>' +
            '<td><span class="pg-badge ' + badgeClass(a.status) + '">' + esc(a.status) + '</span></td>' +
            '<td class="wrap">' + esc((a.task || '').slice(0, 120)) + '</td>' +
            '<td class="pg-table-mono">' + fmtNum(a.tokens_used) + '</td></tr>';
        }).join('');
      }).catch(function (err) {
        $('pg-fleet-table').querySelector('tbody').innerHTML = '<tr><td colspan="6" class="pg-empty">Error: ' + esc(err.message) + '</td></tr>';
      });
    }
    $('pg-fleet-refresh').addEventListener('click', loadFleet);

    // ============================================================
    // MEMORY TAB
    // ============================================================
    function loadMemoryStats() {
      api('/memories/stats').then(function (s) {
        var sc = s.scopes || {};
        var eg = s.entity_graph || {};
        var cards = [
          { k: 'embedding model', v: s.embedding_model || '?', sub: '' },
          { k: 'agent scope', v: sc.agent ? (sc.agent.active || 0) : 0, sub: sc.agent ? (sc.agent.superseded + ' superseded · ' + sc.agent.archived + ' archived') : '' },
          { k: 'user scope', v: sc.user ? (sc.user.active || 0) : 0, sub: 'active' },
          { k: 'run scope', v: sc.run ? (sc.run.active || 0) : 0, sub: 'active' },
          { k: 'entity nodes', v: eg.nodes || 0, sub: '' },
          { k: 'entity edges', v: eg.edges || 0, sub: '' },
        ];
        $('pg-mem-stats').innerHTML = cards.map(function (c) {
          return '<div class="pg-mem-stat-card"><div class="k">' + esc(c.k) + '</div><div class="v">' + esc(String(c.v)) + '</div>' + (c.sub ? '<div class="sub">' + esc(c.sub) + '</div>' : '') + '</div>';
        }).join('');
      }).catch(function (err) { $('pg-mem-stats').innerHTML = '<div class="pg-error-banner">Memory unavailable: ' + esc(err.message) + '</div>'; });
    }

    function memQuery() {
      var q = $('pg-mem-q').value.trim();
      var scope = $('pg-mem-scope').value;
      var path = q ? '/memories?q=' + encodeURIComponent(q) : '/memories';
      if (scope) path += (path.includes('?') ? '&' : '?') + 'scope=' + scope;
      api(path).then(function (data) {
        renderMemories(data.memories || []);
      }).catch(function (err) { $('pg-mem-results').innerHTML = '<div class="pg-error-banner">' + esc(err.message) + '</div>'; });
    }
    $('pg-mem-search-btn').addEventListener('click', memQuery);
    $('pg-mem-list-btn').addEventListener('click', memQuery);
    $('pg-mem-q').addEventListener('keydown', function (e) { if (e.key === 'Enter') memQuery(); });

    function renderMemories(list) {
      var el = $('pg-mem-results');
      if (!list.length) { el.innerHTML = '<div class="pg-empty">No memories found.</div>'; return; }
      el.innerHTML = list.map(function (m) {
        return '<div class="pg-mem-item" data-id="' + esc(m.id) + '">' +
          '<div class="pg-mem-item-top">' +
          '<span class="pg-mem-item-scope">' + esc(m.scope) + (m.scope_key ? '/' + esc(m.scope_key) : '') + '</span>' +
          '<span class="pg-mem-item-status">' + esc(m.status) + '</span>' +
          (m.score != null ? '<span class="pg-mem-item-score">score ' + Number(m.score).toFixed(3) + '</span>' : '') +
          '</div>' +
          '<div class="pg-mem-item-content">' + esc(m.content) + '</div>' +
          '<div class="pg-mem-item-meta">' +
          '<span>conf ' + esc(m.confidence != null ? m.confidence : '?') + '</span>' +
          '<span>imp ' + esc(m.importance != null ? m.importance : '?') + '</span>' +
          (m.source ? '<span>src ' + esc(m.source) + '</span>' : '') +
          '<button class="pg-mem-item-del pg-mem-expand">history</button>' +
          '<button class="pg-mem-item-del pg-mem-del">archive</button>' +
          '</div>' +
          '<div class="pg-mem-history" hidden></div>' +
          '</div>';
      }).join('');
    }
    $('pg-mem-results').addEventListener('click', function (e) {
      var item = e.target.closest('.pg-mem-item'); if (!item) return;
      var id = item.dataset.id;
      if (e.target.classList.contains('pg-mem-expand')) {
        var box = item.querySelector('.pg-mem-history');
        if (!box.hidden) { box.hidden = true; return; }
        box.hidden = false; box.innerHTML = '<div class="pg-empty">Loading history…</div>';
        api('/memories/' + encodeURIComponent(id) + '?follow=full_history').then(function (r) {
          var rows = r.memories || [];
          if (!rows.length) { box.innerHTML = '<div class="pg-empty">No history.</div>'; return; }
          box.innerHTML = rows.map(function (h) {
            return '<div class="pg-mem-history-line"><span class="pg-mem-item-status">' + esc(h.status) + '</span> · ' + esc(h.created_at) + '<div>' + esc(h.content) + '</div></div>';
          }).join('');
        }).catch(function (err) {
          box.innerHTML = '<div class="pg-empty">' + esc(err.message) + '</div>';
        });
        return;
      }
      if (!e.target.classList.contains('pg-mem-del')) return;
      if (!confirm('Archive this memory?')) return;
      api('/memories/' + encodeURIComponent(id), { method: 'DELETE' })
        .then(function () { item.remove(); })
        .catch(function (err) { alert(err.message); });
    });

    // absorb
    $('pg-abs-btn').addEventListener('click', function () {
      var factsRaw = $('pg-abs-facts').value.trim();
      var facts = factsRaw.split(/\n+/).map(function (s) { return s.trim(); }).filter(Boolean);
      if (!facts.length) { alert('Enter at least one fact'); return; }
      var body = { source: $('pg-abs-source').value.trim() || 'manual', facts: facts };
      var scope = $('pg-abs-scope').value;
      if (scope) body.scope = scope;
      $('pg-abs-btn').disabled = true;
      api('/memories/absorb', { method: 'POST', body: body })
        .then(function (r) {
          $('pg-abs-report').innerHTML = '<pre>' + esc(JSON.stringify(r, null, 2)) + '</pre>';
          $('pg-abs-facts').value = '';
          loadMemoryStats();
        }).catch(function (err) { $('pg-abs-report').innerHTML = '<div class="pg-error-banner">' + esc(err.message) + '</div>'; })
        .finally(function () { $('pg-abs-btn').disabled = false; });
    });

    // maintenance
    $('pg-distill-btn').addEventListener('click', function () {
      var dry = $('pg-distill-dry').checked;
      $('pg-distill-btn').disabled = true;
      api('/memories/distill?dry_run=' + dry, { method: 'POST' })
        .then(function (r) { $('pg-maint-report').innerHTML = '<pre>' + esc(JSON.stringify(r, null, 2)) + '</pre>'; loadMemoryStats(); })
        .catch(function (err) { $('pg-maint-report').innerHTML = '<div class="pg-error-banner">' + esc(err.message) + '</div>'; })
        .finally(function () { $('pg-distill-btn').disabled = false; });
    });
    $('pg-gc-btn').addEventListener('click', function () {
      var ttl = $('pg-gc-ttl').value || '30';
      var dry = $('pg-gc-dry').checked;
      $('pg-gc-btn').disabled = true;
      api('/memories/gc?ttl_days=' + encodeURIComponent(ttl) + '&dry_run=' + dry, { method: 'POST' })
        .then(function (r) { $('pg-maint-report').innerHTML = '<pre>' + esc(JSON.stringify(r, null, 2)) + '</pre>'; loadMemoryStats(); })
        .catch(function (err) { $('pg-maint-report').innerHTML = '<div class="pg-error-banner">' + esc(err.message) + '</div>'; })
        .finally(function () { $('pg-gc-btn').disabled = false; });
    });

    // ============================================================
    // JOBS TAB
    // ============================================================
    function loadJobs() {
      api('/jobs').then(function (data) {
        var jobs = data.jobs || [];
        var tb = $('pg-jobs-table').querySelector('tbody');
        if (!jobs.length) { tb.innerHTML = '<tr><td colspan="5" class="pg-empty">No jobs.</td></tr>'; return; }
        tb.innerHTML = jobs.map(function (j) {
          return '<tr data-id="' + esc(j.id) + '"><td class="pg-table-mono">' + esc(String(j.id).slice(0, 8)) + '</td>' +
            '<td class="wrap">' + esc((j.task || '').slice(0, 80)) + '</td>' +
            '<td><span class="pg-badge ' + badgeClass(j.status) + '">' + esc(j.status) + '</span></td>' +
            '<td class="pg-table-mono">' + esc(j.attempt || 0) + '/' + esc(j.max_attempts || 0) + '</td>' +
            '<td><div class="pg-row-actions">' +
            '<button class="pg-ghost-btn pg-job-log">log</button>' +
            '<button class="pg-ghost-btn pg-job-rerun">rerun</button>' +
            '<button class="pg-ghost-btn pg-danger pg-job-cancel">cancel</button>' +
            '</div></td></tr>';
        }).join('');
      }).catch(function (err) {
        $('pg-jobs-table').querySelector('tbody').innerHTML = '<tr><td colspan="5" class="pg-empty">Error: ' + esc(err.message) + '</td></tr>';
      });
    }
    $('pg-jobs-refresh').addEventListener('click', loadJobs);

    $('pg-job-create-btn').addEventListener('click', function () {
      var task = $('pg-job-task').value.trim();
      if (!task) { alert('Enter a task'); return; }
      var attempts = parseInt($('pg-job-attempts').value, 10) || 3;
      $('pg-job-create-btn').disabled = true;
      api('/jobs', { method: 'POST', body: { task: task, attempts: attempts } })
        .then(function (r) {
          $('pg-job-task').value = '';
          loadJobs();
        }).catch(function (err) { alert(err.message); })
        .finally(function () { $('pg-job-create-btn').disabled = false; });
    });

    $('pg-jobs-table').addEventListener('click', function (e) {
      var tr = e.target.closest('tr[data-id]'); if (!tr) return;
      var id = tr.dataset.id;
      if (e.target.classList.contains('pg-job-log')) {
        api('/jobs/' + encodeURIComponent(id) + '/log?lines=200').then(function (r) {
          $('pg-joblog-panel').hidden = false;
          $('pg-joblog-meta').textContent = 'job ' + String(id).slice(0, 8) + ' · ' + (r.total_lines || 0) + ' lines';
          $('pg-joblog').textContent = (r.lines || []).join('\n');
        }).catch(function (err) { alert(err.message); });
      } else if (e.target.classList.contains('pg-job-rerun')) {
        api('/jobs/' + encodeURIComponent(id) + '/rerun', { method: 'POST' }).then(loadJobs).catch(function (err) { alert(err.message); });
      } else if (e.target.classList.contains('pg-job-cancel')) {
        if (!confirm('Cancel this job?')) return;
        api('/jobs/' + encodeURIComponent(id), { method: 'DELETE' }).then(loadJobs).catch(function (err) { alert(err.message); });
      }
    });

    // ============================================================
    // METRICS TAB
    // ============================================================
    function loadMetrics() {
      rawGet('/metrics').then(function (text) {
        $('pg-rawmetrics').textContent = text;
        var metrics = {};
        text.split('\n').forEach(function (line) {
          var m = line.match(/^([a-zA-Z_:][a-zA-Z0-9_:]*)\s+([0-9eE.+-]+)/);
          if (m) { metrics[m[1]] = metrics[m[1]] || []; metrics[m[1]].push({ labels: '', val: parseFloat(m[2]) }); }
          var labeled = line.match(/^([a-zA-Z_:][a-zA-Z0-9_:]*)\{([^}]*)\}\s+([0-9eE.+-]+)/);
          if (labeled) { metrics[labeled[1]] = metrics[labeled[1]] || []; metrics[labeled[1]].push({ labels: labeled[2], val: parseFloat(labeled[3]) }); }
        });
        var cards = [
          { k: 'sessions total', key: 'pr_sessions_total' },
          { k: 'sessions active', key: 'pr_sessions_active' },
          { k: 'agents spawned', key: 'pr_agents_spawned_total' },
          { k: 'tokens used', key: 'pr_tokens_used_total' },
          { k: 'tool calls', key: 'pr_tool_calls_total' },
          { k: 'http requests', key: 'pr_http_requests_total' },
        ];
        $('pg-metric-cards').innerHTML = cards.map(function (c) {
          var list = metrics[c.key] || [];
          var total = list.reduce(function (a, b) { return a + b.val; }, 0);
          var sub = list.length > 1 ? list.length + ' series' : (list[0] && list[0].labels ? list[0].labels : '');
          return '<div class="pg-metric-card"><div class="k">' + esc(c.k) + '</div><div class="v">' + fmtNum(total) + '</div>' + (sub ? '<div class="sub">' + esc(sub) + '</div>' : '') + '</div>';
        }).join('') || '<div class="pg-empty">No metrics parsed.</div>';
      }).catch(function (err) {
        $('pg-metric-cards').innerHTML = '<div class="pg-error-banner">Metrics unavailable: ' + esc(err.message) + '</div>';
        $('pg-rawmetrics').textContent = '';
      });
    }
    $('pg-metrics-refresh').addEventListener('click', loadMetrics);

    // ============================================================
    // boot
    // ============================================================
    checkHealth();
    setInterval(checkHealth, 10000);
    refreshSessions().then(function () {
      var m = location.hash.match(/session=([0-9a-f-]+)/i);
      if (m) { switchTab('research'); openSession(m[1]); }
    });
    setInterval(function () { if (!state.running) refreshSessions(); }, 8000);
    // auto-refresh fleet/jobs/metrics when their tab is active
    setInterval(function () {
      if (!state.serverOk) return;
      if (state.activeTab === 'fleet') loadFleet();
      if (state.activeTab === 'jobs') loadJobs();
      if (state.activeTab === 'metrics') loadMetrics();
      if (state.activeTab === 'memory') loadMemoryStats();
    }, 12000);
  })();
  </script>
</Layout>
