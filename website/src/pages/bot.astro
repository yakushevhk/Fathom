---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const features = [
  { key: 'persona', name: 'Configurable Personas', d: 'Customize system prompts, role boundaries, behavioral instructions, and dedicated persistent memory per digital coworker.' },
  { key: 'thinking', name: 'Live Chain-of-Thought', d: 'Real-time streaming of internal agent reasoning and dynamic tool selection so you always know why and how decisions are made.' },
  { key: 'routines', name: '24/7 Scheduled Routines', d: 'Schedule recurring autonomous research, daily briefings, and automated database syncs while your human team sleeps.' },
  { key: 'research', name: 'Deep Web Intelligence', d: 'Autonomous crawling, multi-source registry synthesis, and structured tabular deliverables for market intelligence.' },
  { key: 'cards', name: 'Interactive Action Cards', d: 'Deliverables render as interactive visual cards, widgets, and mini-dashboards directly in the conversation stream.' },
  { key: 'telemetry', name: 'Telemetry & Governance', d: 'Live tracking of server resources (CPU, RAM, tokens) and signed verification receipts for every executed action.' },
];

const steps = [
  { n: '01', key: 's1', t: 'Deploy Private Core', d: 'Launch the ultra-fast Rust runtime on your bare-metal server or private cloud node in under 5 minutes.' },
  { n: '02', key: 's2', t: 'Define Agent Roles', d: 'Configure system directives, connected internal tools (CRM, ERP, SQL), and choose local or private LLMs.' },
  { n: '03', key: 's3', t: 'Collaborate in Chat', d: 'Invite your team to Fathom Bot. Talk 1-on-1, create multi-bot channels, and delegate complex tasks.' },
  { n: '04', key: 's4', t: 'Automate & Audit', d: 'Schedule 24/7 background workflows and inspect cryptographic verification receipts for full compliance.' },
];
---

<Layout title="Fathom Bot — Sovereign Autonomous AI Workforce in a Chat App" description="Fathom Bot is a local-first team messaging app where every sidebar contact is an autonomous digital employee executing complex workflows on your private infrastructure.">
  <main class="bot-page">
    <PageHero cls="bot-hero">
      <p class="eyebrow" data-i18n="botPage.hero.badge">Fathom Bot</p>
      <h1 data-i18n="botPage.hero.title">Your autonomous AI workforce,<br />in a <em class="it">chat app.</em></h1>
      <p class="copy-lg mx-auto" data-i18n="botPage.hero.sub">Every contact in the sidebar is a real, universal AI coworker running on your private infrastructure. They execute terminal commands, conduct deep web intelligence, automate recurring operations, and deliver interactive rich cards right in the discussion.</p>
      <div class="bot-hero-chips">
        <span class="bchip" data-i18n="botPage.hero.chip1">Universal Coworkers</span>
        <span class="bchip" data-i18n="botPage.hero.chip2">100% On-Premise</span>
        <span class="bchip" data-i18n="botPage.hero.chip3">Multi-Tool Execution</span>
        <span class="bchip" data-i18n="botPage.hero.chip4">Human Governance</span>
      </div>
    </PageHero>

    <div class="container">

      <!-- Hero showcase: Thinking Stream & Live Tool Calls -->
      <div class="bot-showcase">
        <div class="product-screenshot-frame">
          <img src="/images/bot/fathom-agent-thinking-stream-tool-call.png" alt="Fathom Bot — Live Autonomous Agent Execution with Chain of Thought" loading="lazy" width="2596" height="1958" />
        </div>
      </div>

      <!-- Capabilities grid -->
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="botPage.features.badge">Universal Capabilities</p>
        <h2 class="h3-sec" data-i18n="botPage.features.title">Digital coworkers that <em class="it">execute</em></h2>
        <p class="copy-lg mx-auto" data-i18n="botPage.features.sub">Fathom Bot connects your team with sovereign autonomous agents capable of performing complex multi-hour tasks with transparent reasoning and verifiable results.</p>
      </div>

      <div class="bot-grid">
        {features.map((f) => (
          <div class="bot-card">
            <h3 data-i18n={'botPage.features.' + f.key + '.name'}>{f.name}</h3>
            <p data-i18n={'botPage.features.' + f.key + '.d'}>{f.d}</p>
          </div>
        ))}
      </div>

      <!-- Feature 1: Agent Setup & Personas -->
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.sections.s2.badge">Personalization & Roles</p>
          <h2 class="h3-sec" data-i18n="botPage.sections.s2.title">Dedicated Personas & Behavioral Profiles</h2>
          <p class="copy-lg" data-i18n="botPage.sections.s2.sub">Assign dedicated avatars, specialized skillsets, custom instructions, and long-term vector memory to build the exact digital colleague your department requires.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/fathom-bot-identity-settings.png" alt="Fathom Bot Identity, Soul & Skill Settings" loading="lazy" width="2596" height="1958" />
        </div>
      </div>

      <!-- Feature 2: Automations & Calendar Schedules -->
      <div class="feat feat-reverse">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.sections.s3.badge">Automations & Triggers</p>
          <h2 class="h3-sec" data-i18n="botPage.sections.s3.title">Autonomous Background Routines 24/7</h2>
          <p class="copy-lg" data-i18n="botPage.sections.s3.sub">Set up visual calendar triggers and cron schedules. Agents monitor competitor updates, compile daily briefings, and audit system states without waiting for human prompts.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/fathom-automations-calendar-schedule-modal.png" alt="Fathom Bot Automations & Calendar Scheduling" loading="lazy" width="2596" height="1958" />
        </div>
      </div>

      <!-- Feature 3: Deterministic Step Pipeline -->
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.sections.s1.badge">Reasoning & Tools</p>
          <h2 class="h3-sec" data-i18n="botPage.sections.s1.title">Autonomous Execution with Live Thinking</h2>
          <p class="copy-lg" data-i18n="botPage.sections.s1.sub">Watch agents break complex instructions into logical sub-tasks, execute shell commands, query external databases, and synthesize findings in real time with zero black-box obscurity.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/fathom-agent-setup-thought-run-steps.png" alt="Fathom Bot Step-by-Step Tool Execution Pipeline" loading="lazy" width="2596" height="1958" />
        </div>
      </div>

      <!-- Feature 4: Deep Web Research & Intelligence -->
      <div class="feat feat-reverse">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.sections.s4.badge">Market Intelligence</p>
          <h2 class="h3-sec" data-i18n="botPage.sections.s4.title">Deep Autonomous Research & OSINT</h2>
          <p class="copy-lg" data-i18n="botPage.sections.s4.sub">From mapping regional venture funds and analyzing legal registries to competitive pricing audits, agents extract, verify, and format unstructured web data into structured tables.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/fathom-uzbekistan-vc-funds-research.png" alt="Fathom Bot Autonomous Research on Uzbekistan Venture Funds" loading="lazy" width="2596" height="1958" />
        </div>
      </div>

      <!-- Feature 5: Interactive Action Cards -->
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.sections.s5.badge">Deliverables & Cards</p>
          <h2 class="h3-sec" data-i18n="botPage.sections.s5.title">Rich Action Cards in the Discussion Stream</h2>
          <p class="copy-lg" data-i18n="botPage.sections.s5.sub">Say goodbye to plain text replies. Fathom Bot renders structured interactive widgets, live weather forecasts, status monitors, and one-click approvals inline.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/fathom-tokyo-weather-report-card.png" alt="Fathom Bot Interactive Action Card Render" loading="lazy" width="2596" height="1958" />
        </div>
      </div>

      <!-- Feature 6: Telemetry & Host Diagnostics -->
      <div class="feat feat-reverse">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.sections.s6.badge">Observability & Diagnostics</p>
          <h2 class="h3-sec" data-i18n="botPage.sections.s6.title">Full Host Telemetry & Resource Diagnostics</h2>
          <p class="copy-lg" data-i18n="botPage.sections.s6.sub">Inspect CPU load, memory headroom, container health, and token throughput live. Agents proactively report anomalies and maintain self-healing server operations.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/fathom-system-resources-monitor-report.png" alt="Fathom Bot System Resource Monitor and Diagnostics" loading="lazy" width="2596" height="1958" />
        </div>
      </div>

      <!-- How it works -->
      <div class="sec-head center">
        <p class="eyebrow" data-i18n="botPage.flow.badge">Deployment Architecture</p>
        <h2 class="h3-sec" data-i18n="botPage.flow.title">From Private Server to Team Desktops</h2>
      </div>

      <div class="bot-steps">
        {steps.map((s) => (
          <div class="bot-step">
            <div class="bot-step-num">{s.n}</div>
            <h3 data-i18n={'botPage.flow.' + s.key + '.t'}>{s.t}</h3>
            <p data-i18n={'botPage.flow.' + s.key + '.d'}>{s.d}</p>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="bot-cta">
        <h2 data-i18n="botPage.cta.title">Deploy Sovereign AI Workforce Today</h2>
        <p data-i18n="botPage.cta.sub">Available as an on-premise binary, private cloud cluster, and local-first desktop application for macOS, Windows, and Linux.</p>
        <div class="more-links">
          <a href="/docs/bot" class="btn btn-primary" data-i18n="botPage.cta.readme">Read Bot Documentation →</a>
          <a href="/whitepaper" class="btn btn-secondary" data-i18n="botPage.cta.code">View Systems Whitepaper</a>
        </div>
      </div>

    </div>
  </main>
</Layout>

<style>
  .bot-page { padding: 70px 0 90px; }

  .bot-hero { max-width: 860px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .bot-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .bot-hero h1 .it { font-weight: 400; }
  .bot-hero .copy-lg { margin-top: 20px; }
  .bot-hero-chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 24px; }
  .bchip { font-family: var(--font-mono); font-size: 12px; color: var(--grey-600); border: 1px solid var(--grey-300); border-radius: var(--radius-full); padding: 6px 13px; background: var(--bg-card); }

  .bot-showcase { margin: 8px 0 64px; }
  .bot-showcase .product-screenshot-frame { border-radius: var(--radius-xl); box-shadow: 0 20px 60px rgba(0,0,0,0.5); overflow: hidden; }

  .sec-head { max-width: 760px; margin: 56px auto 34px; }
  .sec-head.center { text-align: center; }
  .sec-head.center .eyebrow { justify-content: center; display: flex; gap: 12px; align-items: center; }
  .h3-sec { font-size: clamp(24px, 3.2vw, 40px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; margin: 14px 0 16px; }
  .h3-sec .it { font-weight: 400; }
  .copy-lg { color: var(--grey-700); font-size: 16px; line-height: 1.6; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .bot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--grey-300); border: 1px solid var(--grey-300); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 72px; }
  .bot-card { background: var(--bg-primary); padding: 26px 24px; transition: background .25s var(--ease-out); }
  .bot-card:hover { background: var(--bg-card-hover); }
  .bot-card h3 { font-size: 16.5px; font-weight: 600; margin-bottom: 10px; letter-spacing: -0.01em; }
  .bot-card p { color: var(--grey-600); font-size: 13.5px; line-height: 1.6; }

  .feat { display: grid; grid-template-columns: 1fr 1.35fr; gap: 48px; align-items: center; margin: 72px 0; }
  .feat-reverse { grid-template-columns: 1.35fr 1fr; }
  .feat-reverse .feat-copy { order: 2; }
  .feat-reverse .product-screenshot-frame { order: 1; }
  .feat-copy { max-width: 520px; }
  .feat .product-screenshot-frame { border-radius: var(--radius-lg); box-shadow: 0 16px 48px rgba(0,0,0,0.4); overflow: hidden; }

  .bot-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 40px 0 72px; }
  .bot-step { background: var(--bg-card); border: 1px solid var(--grey-300); border-radius: var(--radius-lg); padding: 24px; }
  .bot-step-num { font-family: var(--font-mono); font-size: 12px; color: var(--accent); margin-bottom: 12px; font-weight: 600; }
  .bot-step h3 { font-size: 15px; font-weight: 600; margin-bottom: 8px; }
  .bot-step p { font-size: 13px; color: var(--grey-600); line-height: 1.55; }

  .bot-cta { text-align: center; max-width: 680px; margin: 48px auto 0; padding: 48px 32px; background: var(--bg-card); border: 1px solid var(--grey-300); border-radius: var(--radius-xl); }
  .bot-cta h2 { font-size: clamp(22px, 2.5vw, 32px); font-weight: 600; letter-spacing: -0.02em; margin-bottom: 12px; }
  .bot-cta p { color: var(--grey-600); font-size: 15px; line-height: 1.6; margin-bottom: 24px; }
  .more-links { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .bot-grid { grid-template-columns: 1fr; }
    .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; }
    .feat-reverse .feat-copy { order: 1; }
    .feat-reverse .product-screenshot-frame { order: 2; }
    .bot-steps { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .bot-steps { grid-template-columns: 1fr; }
  }
</style>
