---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const features = [
  { key: 'brain', name: 'Pick a brain per bot', d: 'A model picker with a provider rail — Claude and Codex models side by side, defaults marked, unavailable providers dimmed with the reason. Switch a bot\'s model mid-conversation.' },
  { key: 'computer', name: 'Every bot gets a computer', d: 'Open the Computer panel and the bot\'s cloud desktop spins up on its own — live screen preview while it works, "Open desktop" to take over in your browser, or point the bot at this machine instead.' },
  { key: 'approvals', name: 'Bots ask before they act', d: 'Shell commands, file edits, and questions surface as inline cards — Allow / Deny / answer in chat. A permission broker turns every risky action into a decision you make.' },
  { key: 'apps', name: 'Connected apps', d: 'A one-click marketplace over Composio Sessions: Gmail, Slack, GitHub, Notion, Linear and hundreds more. OAuth once, and every bot can use them as tools.' },
  { key: 'channels', name: 'Channels for every context', d: 'Keep Work, Personal, and each project in separate channels without cloning your bots. Every channel has its own transcript, instructions, working folder, and roster.' },
  { key: 'voice', name: 'Bots that talk back', d: 'Press the speaker on any reply, or switch a bot to read its answers out as they land. Hit call and it is a conversation — it hears you and asks for approvals out loud.' },
];

const steps = [
  { key: 's1', n: '01', t: 'Install the harness', d: 'One small server on 127.0.0.1 owns every agent process. Transcripts, keys, and events stay in ~/.openmausbot, not a cloud.' },
  { key: 's2', n: '02', t: 'Bring your agents', d: 'Bots run on the claude, codex, and grok CLIs already installed on your machine — your existing logins and subscriptions, no new accounts.' },
  { key: 's3', n: '03', t: 'Chat like contacts', d: 'Every bot in the sidebar is a real agent with its own personality, model, computer, and apps. Watch them work, approve what matters.' },
  { key: 's4', n: '04', t: 'Scale the team', d: 'Install an outcome-driven team from one Markdown file, or manage bots, channels, and routines right from the chat app.' },
];
---

<Layout title="Fathom Bot — Your Team of AI Agents in a Chat App" description="Fathom Bot is a local-first chat app where every sidebar contact is a real AI agent — bring your own Claude, Codex, or Grok CLI, give each bot its own model, cloud computer, and connected apps.">
  <main class="bot-page">
    <PageHero cls="bot-hero">
      <p class="eyebrow" data-i18n="botPage.hero.badge">Fathom Bot</p>
      <h1 class="h2-sec" data-i18n-html data-i18n="botPage.hero.title">Your team of AI bots,<br />in a <em class="it">chat app.</em></h1>
      <p class="copy-lg mx-auto" data-i18n="botPage.hero.sub">Every bot in the sidebar is a real agent — Claude, Codex, or Grok running locally under the hood — with its own personality, its own model, its own cloud computer, and its own connected apps. Talk to them like contacts, watch them work, approve what matters.</p>
      <div class="bot-hero-chips">
        <span class="bchip" data-i18n="botPage.hero.chip1">Bring-your-own agents</span>
        <span class="bchip" data-i18n="botPage.hero.chip2">Local first</span>
        <span class="bchip" data-i18n="botPage.hero.chip3">500+ connected apps</span>
        <span class="bchip" data-i18n="botPage.hero.chip4">Cloud computers</span>
      </div>
    </PageHero>
    <div class="container">

      <!-- Hero screenshot -->
      <div class="bot-showcase">
        <div class="product-screenshot-frame">
          <img src="/images/bot/hero.png" alt="Fathom Bot — a chat app where every chat is a real AI agent" loading="lazy" width="2880" height="1800" />
        </div>
      </div>

      <!-- Features grid -->
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="botPage.features.badge">Capabilities</p>
        <h2 class="h3-sec" data-i18n="botPage.features.title">Agents with <em class="it">hands</em></h2>
        <p class="copy-lg mx-auto" data-i18n="botPage.features.sub">Each bot can use a cloud Linux desktop, an isolated Local VM, or — where the platform safety boundary is certified — your own computer, plus hundreds of apps through Composio.</p>
      </div>

      <div class="bot-grid">
        {features.map((f) => (
          <div class="bot-card">
            <h3 data-i18n={'botPage.features.' + f.key + '.name'}>{f.name}</h3>
            <p data-i18n={'botPage.features.' + f.key + '.d'}>{f.d}</p>
          </div>
        ))}
      </div>

      <!-- Model picker -->
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.picker.badge">Model picker</p>
          <h2 class="h3-sec" data-i18n="botPage.picker.title">One bot, any model</h2>
          <p class="copy-lg" data-i18n="botPage.picker.sub">A provider rail puts Claude and Codex models side by side with defaults marked and unavailable providers dimmed. Point any engine at a custom CLI binary or wrapper in Settings → Engines, and switch a bot's model mid-conversation.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/model-picker.png" alt="Fathom Bot model picker with provider rail" loading="lazy" width="2880" height="1800" />
        </div>
      </div>

      <!-- Computer panel -->
      <div class="feat feat-reverse">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.computer.badge">Cloud computers</p>
          <h2 class="h3-sec" data-i18n="botPage.computer.title">A desktop for every bot</h2>
          <p class="copy-lg" data-i18n="botPage.computer.sub">Open the Computer panel and the bot's cloud desktop spins up on its own — live screen preview while it works, "Open desktop" to take over in your browser, or point the bot at a Local VM (or this Mac) instead.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/computer-panel.png" alt="Fathom Bot computer panel with live screen preview" loading="lazy" width="2880" height="1800" />
        </div>
      </div>

      <!-- Approval card -->
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.approval.badge">Approvals</p>
          <h2 class="h3-sec" data-i18n="botPage.approval.title">Ask before you act</h2>
          <p class="copy-lg" data-i18n="botPage.approval.sub">Shell commands, file edits, and questions surface as inline cards — Allow / Deny / answer in chat. A permission broker turns every risky action into a decision you make, for cloud and local computers alike.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/approval-card.png" alt="Fathom Bot approval and question cards in chat" loading="lazy" width="2880" height="1800" />
        </div>
      </div>

      <!-- Routines + settings -->
      <div class="feat feat-reverse">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="botPage.routines.badge">Routines</p>
          <h2 class="h3-sec" data-i18n="botPage.routines.title">Work that runs itself</h2>
          <p class="copy-lg" data-i18n="botPage.routines.sub">Routines run once, on selected weekdays, or every 5–1,440 minutes using an agent's configured model or the Cloud VM runner. Webhook triggers reuse the same queued executor — a webhook-only receiver listens on 127.0.0.1:8800 with a one-time secret.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/bot/tasks-routines.png" alt="Fathom Bot routines and webhook triggers" loading="lazy" width="2880" height="1800" />
        </div>
      </div>

      <!-- How it works -->
      <div class="sec-head center">
        <p class="eyebrow" data-i18n="botPage.flow.badge">How it works</p>
        <h2 class="h3-sec" data-i18n="botPage.flow.title">Two processes, one team</h2>
      </div>

      <div class="bot-steps">
        {steps.map((s) => (
          <div class="bot-step">
            <div class="bot-step-num">{s.n}</div>
            <h3 data-i18n={'botPage.flow.' + s.key + '.t'}>{s.t}</h3>
            <p data-i18n={'botPage.flow.' + s.key + '.d'}>{s.d}</p>
          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="bot-cta">
        <h2 data-i18n="botPage.cta.title">Run it from source, or download the app</h2>
        <p data-i18n="botPage.cta.sub">macOS, Windows, and Ubuntu 24.04 x64 builds are released with an embedded harness — no separate server setup required. From source it is pnpm, two dev commands, and your agent CLIs.</p>
        <div class="more-links">
          <a href="https://github.com/yakushevhk/Fathom/blob/main/Bot/README.md" class="btn btn-primary" target="_blank" rel="noopener noreferrer" data-i18n="botPage.cta.readme">Read the Bot README →</a>
          <a href="https://github.com/yakushevhk/Fathom/tree/main/Bot" class="btn btn-secondary" target="_blank" rel="noopener noreferrer" data-i18n="botPage.cta.code">Browse Bot/ source</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .bot-page { padding: 70px 0 90px; }

  .bot-hero { max-width: 860px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .bot-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .bot-hero h1 .it { font-weight: 400; }
  .bot-hero .copy-lg { margin-top: 20px; }
  .bot-hero-chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 24px; }
  .bchip { font-family: var(--font-mono); font-size: 12px; color: var(--grey-600); border: 1px solid var(--grey-300); border-radius: var(--radius-full); padding: 6px 13px; background: var(--bg-card); }

  .bot-showcase { margin: 8px 0 64px; }
  .bot-showcase .product-screenshot-frame { border-radius: var(--radius-xl); }

  .sec-head { max-width: 760px; margin: 56px auto 34px; }
  .sec-head.center { text-align: center; }
  .sec-head.center .eyebrow { justify-content: center; display: flex; gap: 12px; align-items: center; }
  .h3-sec { font-size: clamp(24px, 3.2vw, 40px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; margin: 14px 0 16px; }
  .h3-sec .it { font-weight: 400; }
  .copy-lg { color: var(--grey-700); font-size: 16px; line-height: 1.6; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .bot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--grey-300); border: 1px solid var(--grey-300); border-radius: var(--radius-lg); overflow: hidden; }
  .bot-card { background: var(--bg-primary); padding: 26px 24px; transition: background .25s var(--ease-out); }
  .bot-card:hover { background: var(--bg-card-hover); }
  .bot-card h3 { font-size: 16.5px; font-weight: 600; margin-bottom: 10px; letter-spacing: -0.01em; }
  .bot-card p { color: var(--grey-600); font-size: 13.5px; line-height: 1.6; }

  .feat { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; padding: 56px 0; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  .feat-copy p { margin-top: 0; }

  .bot-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 40px; }
  .bot-step { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; transition: box-shadow .25s, transform .25s var(--ease-out), border-color .25s; }
  .bot-step:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); border-color: var(--grey-400); }
  .bot-step-num { font-family: var(--font-mono); font-size: 12px; color: var(--grey-500); letter-spacing: .1em; margin-bottom: 10px; }
  .bot-step h3 { font-size: 16px; font-weight: 600; margin-bottom: 8px; letter-spacing: -0.01em; }
  .bot-step p { color: var(--grey-600); font-size: 13.5px; line-height: 1.55; }

  .bot-cta { max-width: 820px; margin: 40px auto 0; text-align: center; background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 44px 32px; }
  .bot-cta h2 { font-size: clamp(22px, 3vw, 34px); font-weight: 600; letter-spacing: -0.02em; margin-bottom: 12px; }
  .bot-cta p { color: var(--grey-600); font-size: 14.5px; line-height: 1.6; max-width: 560px; margin: 0 auto 24px; }
  .more-links { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 960px) {
    .bot-grid, .bot-steps { grid-template-columns: 1fr; }
    .feat, .feat-reverse { grid-template-columns: 1fr; gap: 32px; direction: ltr; }
  }
</style>
