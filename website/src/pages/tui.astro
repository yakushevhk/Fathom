---
import Layout from '../layouts/Layout.astro';

const features = [
  { key: 'live', name: 'Live streaming', d: 'Token deltas, tool calls, agent spawn/finish and findings appear in real-time — no polling, no page refresh.' },
  { key: 'replay', name: 'Session replay', d: 'Replay any past session with --replay — watch the full agent tree, tool calls and findings as if they were live.' },
  { key: 'memory', name: 'Memory panel', d: 'Periodic snapshots of the semantic memory store — watch facts being absorbed, search results and entity graph updates live.' },
  { key: 'jobs', name: 'Jobs panel', d: 'Browse durable background jobs: status, logs, cancel and rerun — all from the terminal.' },
  { key: 'steering', name: 'Mid-run steering', d: 'Redirect a running session by typing additional instructions — agents adapt without restarting. Peer coordination remains available through hub messaging.' },
  { key: 'control', name: 'Questions & approvals', d: 'Agents can ask you questions mid-task and request approval for side-effect tools — all handled inline in the TUI. Background work can continue as async jobs.' },
];

const steps = [
  { key: 's1', num: 1, t: 'Launch', d: 'fathom tui opens the interactive dashboard with input field, event log and agent tree.' },
  { key: 's2', num: 2, t: 'Watch', d: 'Agents stream their progress live — tool calls, findings, token usage and state changes appear as they happen.' },
  { key: 's3', num: 3, t: 'Steer', d: 'Type additional instructions to redirect agents. Answer questions or approve side-effect tools when prompted.' },
  { key: 's4', num: 4, t: 'Export', d: 'Results, contacts and reports are saved automatically. Browse jobs and memory from the same interface.' },
];
---

<Layout title="Terminal UI — Fathom">
  <main class="tui-page">
    <div class="container">
      <div class="tui-hero">
        <p class="eyebrow" data-i18n="tuiPage.hero.badge">Terminal UI</p>
        <h1 class="h2-sec" data-i18n-html data-i18n="tuiPage.hero.title">Your terminal,<br />your research lab.</h1>
        <p class="copy-lg mx-auto" data-i18n="tuiPage.hero.sub">An interactive ratatui-based interface with live event streaming, session replay, memory panel, jobs panel and mid-run steering — all without leaving the terminal.</p>
      </div>

      <!-- Features grid -->
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="tuiPage.features.badge">Capabilities</p>
        <h2 class="h2-sec" data-i18n="tuiPage.features.title">Six panels, one screen</h2>
      </div>

      <div class="tui-grid">
        {features.map((f) => (
          <div class="tui-card">
            <div class="tui-name" data-i18n={'tuiPage.features.' + f.key + '.name'}>{f.name}</div>
            <p data-i18n={'tuiPage.features.' + f.key + '.d'}>{f.d}</p>
          </div>
        ))}
      </div>

      <!-- How it works -->
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="tuiPage.flow.badge">How it works</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="tuiPage.flow.title">Four modes, one binary</h2>
      </div>

      <div class="flow">
        {steps.map((s) => (
          <div class="flow-step">
            <div class="flow-num">{s.num}</div>
            <h3 data-i18n={'tuiPage.flow.' + s.key + '.t'}>{s.t}</h3>
            <p data-i18n={'tuiPage.flow.' + s.key + '.d'}>{s.d}</p>
          </div>
        ))}
      </div>

      <!-- Code example -->
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="tuiPage.code.badge">CLI flags</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="tuiPage.code.title">One command, full control</h2>
        <p class="copy-lg mx-auto" data-i18n="tuiPage.code.sub">The TUI wraps the same engine as the headless CLI — all tools, profiles and configs work identically.</p>
      </div>

      <div class="code-card">
        <pre><code># Launch the interactive TUI
fathom tui

# Replay a past session
fathom tui --replay SESSION_ID

# Launch with a specific profile
fathom tui --profile hunter</code></pre>
      </div>

      <div class="tui-cta-link">
        <a href="/docs/cli" class="btn btn-outline" data-i18n="tuiPage.code.docs">CLI reference</a>
      </div>

      <!-- CTA -->
      <div class="tui-cta">
        <div class="bench-card-lg">
          <h3 data-i18n="tuiPage.cta.title">Try the TUI now</h3>
          <p class="bench-sub" data-i18n="tuiPage.cta.sub">Install Fathom and launch the interactive terminal in one command.</p>
          <div class="code-card">
            <pre><code>curl -sSf https://fathom.uz/install.sh | sh
fathom tui</code></pre>
          </div>
          <div style="margin-top: 16px;">
            <a href="/install" class="btn btn-outline" data-i18n="tuiPage.cta.install">Installation guide</a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .tui-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .center { text-align: center; }

  .tui-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .tui-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .tui-hero .copy-lg { margin-top: 20px; }

  .sec-head { max-width: 820px; margin: 0 auto 32px; padding: 0 24px; }
  .sec-head:not(:first-of-type) { margin-top: 64px; }
  .h2-sec { font-size: clamp(26px, 3.5vw, 48px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.08; margin-top: 12px; }

  .tui-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  .tui-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; transition: box-shadow .25s, transform .25s var(--ease-out), border-color .25s; }
  .tui-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: var(--grey-400); }
  .tui-name { font-family: var(--font-mono); font-weight: 600; font-size: 14px; margin-bottom: 10px; }
  .tui-card p { color: var(--grey-600); font-size: 14px; line-height: 1.55; }

  .flow { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; max-width: 960px; margin: 0 auto; padding: 0 24px; }
  .flow-step { text-align: center; }
  .flow-num { width: 40px; height: 40px; border-radius: 50%; background: var(--grey-900); color: var(--on-accent); display: inline-flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 600; font-size: 15px; margin-bottom: 14px; }
  .flow-step h3 { font-size: 15px; font-weight: 600; margin-bottom: 8px; }
  .flow-step p { color: var(--grey-600); font-size: 13px; line-height: 1.55; }

  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--grey-900); overflow: hidden; max-width: 640px; margin: 0 auto; }
  .code-card pre { padding: 20px 24px; margin: 0; overflow-x: auto; }
  .code-card code { color: var(--grey-200); font-family: var(--font-mono); font-size: 13px; line-height: 1.7; white-space: pre; }

  .tui-cta-link { text-align: center; margin: 24px 0 0; }

  .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 13px; font-weight: 600; padding: 10px 20px; border-radius: var(--radius-sm); transition: all .15s; }
  .btn-outline { border: 1px solid var(--grey-300); color: var(--grey-800); }
  .btn-outline:hover { border-color: var(--grey-500); background: var(--grey-100); }

  .tui-cta { max-width: 900px; margin: 48px auto 0; }
  .bench-card-lg { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 28px; }
  .bench-card-lg h3 { font-size: 22px; font-weight: 500; }
  .bench-sub { color: var(--grey-600); font-size: 14px; margin: 8px 0 18px; line-height: 1.6; }

  @media (max-width: 800px) {
    .flow { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 500px) {
    .flow { grid-template-columns: 1fr; }
  }
</style>
