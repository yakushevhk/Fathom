---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

interface Entry {
  hash: string;
  date: string;
  tags: string[];
  title: string;
}

const entries: Entry[] = [
  { hash: 'HEAD', date: 'Aug 28, 2026', tags: ['feat', 'llm', 'lsp'], title: 'v0.4.2 - Full LSP Refactoring, Multi-Compiler Spans, Streaming Reasoning Tokens & Anthropic Thinking' },
  { hash: '13f92f8', date: 'Aug 28, 2026', tags: ['feat', 'security'], title: 'v0.4.1 - 2PC Transactional Patching, Named Registers, AST Codemods, Hardware Cookie Vault & Watcher' },
  { hash: '74bff59', date: 'Aug 28, 2026', tags: ['feat'], title: 'v0.4.0 - High-precision coding harness, swarm pipelines, native Anthropic provider, and SIMD memory graph' },
  { hash: '01cede6', date: 'Aug 20, 2026', tags: ['fix'], title: 'Daemon generations tracked across restarts' },
  { hash: '95644b6', date: 'Aug 20, 2026', tags: ['chore'], title: 'Warnings removed from hardened coordination paths' },
  { hash: '3194817', date: 'Aug 20, 2026', tags: ['fix'], title: 'Daemon and async-job audit findings closed' },
  { hash: '3210efe', date: 'Aug 20, 2026', tags: ['fix'], title: 'Lifecycle, reply routing and documentation consistency hardened' },
  { hash: 'c5db80f', date: 'Aug 20, 2026', tags: ['fix'], title: 'Agent coordination hardened and stale docs updated' },
  { hash: 'badd34a', date: 'Aug 20, 2026', tags: ['docs'], title: 'Documentation updated for agent features #1–#9' },
  { hash: 'ebd8297', date: 'Aug 20, 2026', tags: ['fix'], title: 'Async-job cleanup removes duplicate delivery and unregisters sinks' },
  { hash: '692e6fe', date: 'Aug 20, 2026', tags: ['feat'], title: 'Handoff transfers a session between agents' },
  { hash: '28aae1f', date: 'Aug 20, 2026', tags: ['feat'], title: 'DaemonBroker manages long-running processes' },
  { hash: '1333d65', date: 'Aug 20, 2026', tags: ['feat'], title: 'AsyncJobManager tracks in-process background jobs' },
  { hash: 'f11f123', date: 'Aug 20, 2026', tags: ['feat'], title: 'Batch spawn adds output schemas and isolated subagents' },
  { hash: '775b3d7', date: 'Aug 20, 2026', tags: ['feat'], title: 'Steering interrupts a running agent through hub' },
  { hash: 'f641bcd', date: 'Aug 20, 2026', tags: ['feat'], title: 'Agents can park and revive with TTL lifecycle control' },
  { hash: '569c1e5', date: 'Aug 20, 2026', tags: ['feat'], title: 'IrcBus, AgentRegistry and Hub enable peer messaging' },
  { hash: 'd1898de', date: 'Aug 10, 2026', tags: ['update'], title: 'Fathom research runtime refactor — tools, memory, crawl and code modules' },
  { hash: 'f96be19', date: 'Aug 06, 2026', tags: ['fix'], title: 'Fleet round 2 — race / security / robustness batch + report' },
  { hash: 'efcb255', date: 'Aug 06, 2026', tags: ['perf', 'feat'], title: 'Structural refactor batch B8–B16 + Goal Mode light (sub-agent fleet)' },
  { hash: '5a4404a', date: 'Aug 06, 2026', tags: ['docs'], title: 'Batch 7+8 complete — 1000+ tests, fleet findings implemented (phases 1–6)' },
  { hash: '2c43be6', date: 'Aug 06, 2026', tags: ['feat'], title: 'Fleet findings phase 6 — interactivity & extensions' },
  { hash: 'f6198e5', date: 'Aug 06, 2026', tags: ['feat'], title: 'Fleet findings phase 5 — orchestration hardening' },
  { hash: '00c80fd', date: 'Aug 06, 2026', tags: ['feat'], title: 'Fleet findings phase 4 — planner, reflection, findings pipeline' },
  { hash: 'b4e1467', date: 'Aug 06, 2026', tags: ['feat'], title: 'Fleet findings phase 3 — behavior core' },
  { hash: '5009180', date: 'Aug 06, 2026', tags: ['perf'], title: 'Fleet findings phase 2 — bottleneck batch' },
  { hash: '36f0dc2', date: 'Aug 06, 2026', tags: ['fix'], title: 'Fleet findings phase 1 — security + reliability batch' },
  { hash: '90eca4f', date: 'Aug 06, 2026', tags: ['docs'], title: 'Fleet report 2026-08-06 — 7-agent research (bugs, bottlenecks, borrowable features)' },
  { hash: 'ce8816d', date: 'Aug 06, 2026', tags: ['feat'], title: 'P0 wiring batch — dormant subsystems connected (audit follow-up)' },
];
---

<Layout title="Changelog — Fathom">
  <main class="cl-page">
        <PageHero cls="cl-hero">
        <p class="eyebrow" data-i18n="changelog.hero.badge">Changelog</p>
        <h1 class="h2-sec" data-i18n="changelog.hero.title">Shipped, measured, logged.</h1>
        <p class="copy-lg mx-auto" data-i18n="changelog.hero.sub">What changed, when, and why — straight from the product repository. Fleet findings become phases, phases become batches, batches become releases.</p>
    </PageHero>
    <div class="container">

      <div class="cl-timeline">
        {
          entries.map((e) => (
            <div class="cl-item">
              <div class="cl-dot"></div>
              <div class="cl-card">
                <div class="cl-meta">
                  <span class="cl-date">{e.date}</span>
                  <span class="cl-hash">{e.hash}</span>
                </div>
                <div class="cl-title">{e.title}</div>
                <div class="cl-tags">
                  {e.tags.map((t) => (
                    <span class={`cl-tag cl-tag--${t}`}>{t}</span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <p class="cl-note" data-i18n-html data-i18n="changelog.note">* Full history ships with your deployment — run <code>fathom</code> on your own infrastructure; every build carries its own log.</p>

      <div class="cta-strip">
        <h2 data-i18n="changelog.cta.title">Every release is benchmarked.</h2>
        <div class="cta-actions">
          <a href="/benchmarks" class="btn btn-primary" data-i18n="changelog.cta.numbers">See the numbers</a>
          <a href="/blog" class="btn btn-ghost-light" data-i18n="changelog.cta.blog">Read the engineering blog</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .cl-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .cl-hero { max-width: 820px; margin: 0 auto 56px; text-align: center; padding: 0 24px; }
  .cl-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .cl-hero .copy-lg { margin-top: 20px; }

  .cl-timeline { max-width: 760px; margin: 0 auto; border-left: 2px solid var(--grey-200); padding-left: 28px; display: flex; flex-direction: column; gap: 8px; }
  .cl-item { position: relative; }
  .cl-dot { position: absolute; left: -36px; top: 26px; width: 10px; height: 10px; border-radius: 50%; background: var(--grey-900); box-shadow: 0 0 0 4px var(--grey-50); }
  .cl-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 18px 22px; transition: border-color .2s, box-shadow .25s; }
  .cl-card:hover { border-color: var(--grey-400); box-shadow: var(--shadow-md); }
  .cl-meta { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--grey-600); margin-bottom: 8px; }
  .cl-date { text-transform: uppercase; letter-spacing: .6px; }
  .cl-hash { color: var(--grey-500); background: var(--grey-100); border: 1px solid var(--grey-200); border-radius: 5px; padding: 1px 7px; }
  .cl-title { font-size: 15.5px; font-weight: 500; line-height: 1.45; color: var(--grey-900); }
  .cl-tags { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }
  .cl-tag { font-family: var(--font-mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: .6px; padding: 3px 10px; border-radius: 100px; border: 1px solid var(--grey-200); color: var(--grey-600); background: var(--grey-50); }
  .cl-tag--feat { color: #3d6b35; border-color: #cdddc4; background: #eef3e9; }
  .cl-tag--fix { color: #8a5a2b; border-color: #e5d3b8; background: #f7f0e3; }
  .cl-tag--perf { color: #2f5d77; border-color: #c4d8e3; background: #e9f1f5; }
  .cl-tag--docs { color: #5c5b59; border-color: var(--grey-300); background: var(--grey-100); }
  .cl-tag--update { color: #5c5b59; border-color: var(--grey-300); background: var(--grey-100); }
  .cl-tag--chore { color: #5c5b59; border-color: var(--grey-300); background: var(--grey-100); }

  .cl-note { max-width: 760px; margin: 36px auto 0; padding-left: 30px; font-size: 13px; color: var(--grey-600); line-height: 1.6; }
  .cl-note code { font-family: var(--font-mono); font-size: 12px; background: var(--grey-100); border: 1px solid var(--grey-200); padding: 1px 6px; border-radius: 5px; }

  .cta-strip { max-width: 900px; margin: 56px auto 0; background: var(--bg-dark); border-radius: var(--radius-xl); padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta-strip h2 { color: #fff; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; }
  .cta-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .cta-strip .btn-primary { background: #ffffff; color: #101010; }
  .btn-ghost-light { color: #fff; border: 1px solid rgba(255, 255, 255, .35); }
  .btn-ghost-light:hover { border-color: #fff; background: rgba(255, 255, 255, .08); }

  @media (max-width: 640px) {
    .cl-timeline { padding-left: 20px; }
    .cl-dot { left: -28px; }
  }
</style>
