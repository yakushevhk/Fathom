---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const pipeline = [
  { num: 1, key: 's1', t: 'Plan', d: 'A worker turns the request into a source-aware plan, then delegates discovery across the tools and services configured by the operator.' },
  { num: 2, key: 's2', t: 'Discover', d: 'search_business_directory, search_social and search_news gather public company, people and press context when those connectors are enabled.' },
  { num: 3, key: 's3', t: 'Parse', d: 'parse_corporate_site extracts structured company, team and contact context from fetched pages using JSON-LD, Schema.org and page content.' },
  { num: 4, key: 's4', t: 'Extract', d: 'extract_contacts identifies emails, phones, social profiles and person/company entities, retaining source context for later review.' },
  { num: 5, key: 's5', t: 'Enrich', d: 'enrich_company and enrich_person add useful industry, technology, role and location context when matching public evidence is available.' },
  { num: 6, key: 's6', t: 'Verify', d: 'verify_email and verify_phone apply syntax, DNS and normalization checks. Optional SMTP probing depends on network access and operator configuration.' },
  { num: 7, key: 's7', t: 'Review', d: 'suggest_emails can propose domain patterns for a worker or human to review; confidence and missing evidence stay explicit rather than guessed.' },
  { num: 8, key: 's8', t: 'Persist', d: 'save_contacts stores approved findings in SQLite or PostgreSQL with verification receipts, subject to the configured policy and review gates.' },
  { num: 9, key: 's9', t: 'Report', d: 'The worker summarizes evidence, remembers durable context and can export CSV, vCard, JSON or reports, or hand off to a configured CRM.' },
];

const techs = [
  { key: 'cms', name: 'CMS', d: 'WordPress, Shopify, Squarespace, Wix, Webflow, Drupal, Joomla, Magento' },
  { key: 'js', name: 'JS frameworks', d: 'Next.js, Nuxt.js, React, Vue.js, Angular, Svelte, Gatsby' },
  { key: 'analytics', name: 'Analytics', d: 'Google Analytics, Segment, Mixpanel, Amplitude, Hotjar, Matomo, Yandex Metrika' },
  { key: 'payments', name: 'Payments', d: 'Stripe, PayPal' },
  { key: 'hosting', name: 'Hosting & marketing', d: 'Vercel, Netlify, CloudFront, S3, HubSpot, Klaviyo, Mailchimp, Salesforce, Sentry' },
];
---

<Layout title="Research Workflows — Fathom">
  <main class="research-page">
      <!-- HERO -->
          <PageHero cls="research-hero">
        <p class="eyebrow" data-i18n="researchPage.hero.badge">Research workflow</p>
        <h1 class="h2-sec" data-i18n-html data-i18n="researchPage.hero.title">From a goal to<br /><em class="it">reviewable findings.</em></h1>
        <p class="copy-lg mx-auto" data-i18n="researchPage.hero.sub">A universal autonomous worker plans the investigation, delegates source work, keeps evidence in memory and pauses for governance where configured. Research, contact discovery and reporting are workflows—not a separate research engine.</p>
    </PageHero>
    <div class="container">

      <!-- PIPELINE -->
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="researchPage.pipeline.badge">Worker workflow</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="researchPage.pipeline.title">Plan, delegate, verify, remember</h2>
      </div>

      <div class="pipeline-grid">
        {pipeline.map((s) => (
          <div class="pipeline-card">
            <div class="pipeline-num">{s.num}</div>
            <div class="pipeline-body">
              <div class="pipeline-name" data-i18n={'researchPage.pipeline.' + s.key + '.t'}>{s.t}</div>
              <p data-i18n={'researchPage.pipeline.' + s.key + '.d'}>{s.d}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- DATA SOURCES -->
      <div class="sec-head center reveal" style="margin-top:72px">
        <p class="eyebrow" data-i18n="researchPage.sources.badge">Configured sources</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="researchPage.sources.title">Choose the sources your worker can use</h2>
      </div>

      <div class="src-grid">
        <div class="src-card src-card--wide">
          <div class="src-name" data-i18n="researchPage.sources.dirs.name">Business directories</div>
          <p data-i18n="researchPage.sources.dirs.d">Configured directory connectors such as 2GIS, Google Maps, Yandex Maps or Yellow Pages can be queried in parallel; review overlapping results before export.</p>
        </div>
        <div class="src-card">
          <div class="src-name" data-i18n="researchPage.sources.social.name">Social platforms</div>
          <p data-i18n="researchPage.sources.social.d">Configured Twitter/X, Telegram or site-restricted LinkedIn search can add public context where access permits. Findings retain platform and URL provenance for review.</p>
        </div>
        <div class="src-card">
          <div class="src-name" data-i18n="researchPage.sources.news.name">News & press</div>
          <p data-i18n="researchPage.sources.news.d">A configured news connector such as Serper or Google News RSS can provide press context. Entity extraction is heuristic, so workers keep source links and uncertainty visible.</p>
        </div>
      </div>

      <!-- VERIFICATION -->
      <div class="sec-head center reveal" style="margin-top:72px">
        <p class="eyebrow" data-i18n="researchPage.verification.badge">Verification and review</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="researchPage.verification.title">Evidence gates before side effects</h2>
        <p class="copy-lg mx-auto" data-i18n="researchPage.verification.sub">Workers can apply syntax and DNS checks, flag disposable or role-based addresses and—when network access is configured—probe SMTP. Receipts and confidence keep uncertainty visible; governance can require human approval before saving or syncing.</p>
      </div>

      <div class="verify-grid">
        <div class="verify-card">
          <code class="verify-name" data-i18n="researchPage.verification.gates.syntax.name">Syntax</code>
          <p data-i18n="researchPage.verification.gates.syntax.d">RFC 5322 subset: single @, local ≤64 chars, domain ≤253 chars, no leading/trailing/consecutive dots.</p>
        </div>
        <div class="verify-card">
          <code class="verify-name" data-i18n="researchPage.verification.gates.mx.name">MX lookup</code>
          <p data-i18n="researchPage.verification.gates.mx.d">DNS-over-HTTPS via Google then Cloudflare. Falls back to A/AAAA per RFC 5321 §5.1. Null MX (RFC 7505) detected and dropped.</p>
        </div>
        <div class="verify-card">
          <code class="verify-name" data-i18n="researchPage.verification.gates.disposable.name">Disposable</code>
          <p data-i18n="researchPage.verification.gates.disposable.d">Configured lists of known disposable providers can flag domains such as mailinator, yopmail, guerrillamail or tempmail; subdomain matching may be included.</p>
        </div>
        <div class="verify-card">
          <code class="verify-name" data-i18n="researchPage.verification.gates.role.name">Role-based</code>
          <p data-i18n="researchPage.verification.gates.role.d">Role and department patterns such as admin, info, support, sales, noreply, hr or billing can be flagged for review.</p>
        </div>
        <div class="verify-card">
          <code class="verify-name" data-i18n="researchPage.verification.gates.smtp.name">SMTP probe</code>
          <p data-i18n="researchPage.verification.gates.smtp.d">Optional port 25 handshake: banner → HELO → MAIL FROM → RCPT TO. Accepts 250/251, rejects 5xx, inconclusive 4xx (greylisting). Never sends message content.</p>
        </div>
      </div>

      <!-- ENRICHMENT -->
      <div class="sec-head center reveal" style="margin-top:72px">
        <p class="eyebrow" data-i18n="researchPage.enrich.badge">Context enrichment</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="researchPage.enrich.title">Add context when evidence supports it</h2>
        <p class="copy-lg mx-auto" data-i18n="researchPage.enrich.sub">enrich_company can inspect HTML signatures for CMS, JS frameworks, analytics, payments and hosting. enrich_person can compare public web evidence and configured social sources; workers preserve gaps instead of filling them with guesses.</p>
      </div>

      <div class="tech-grid">
        {techs.map((t) => (
          <div class="tech-card">
            <div class="tech-name" data-i18n={'researchPage.enrich.techs.' + t.key + '.name'}>{t.name}</div>
            <p data-i18n={'researchPage.enrich.techs.' + t.key + '.d'}>{t.d}</p>
          </div>
        ))}
      </div>

      <!-- QUALITY TRACKING -->
      <div class="sec-head center reveal" style="margin-top:72px">
        <p class="eyebrow" data-i18n="researchPage.quality.badge">Quality tracking</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="researchPage.quality.title">Append-only verification receipts</h2>
        <p class="copy-lg mx-auto" data-i18n="researchPage.quality.sub">Verification checks can write durable receipts to a JSONL ledger. Receipts are keyed by (kind, value), so a PASS on one check does not silence a FAIL on another. Reviewers and governance policies can use the resulting Verified, Partial or Unverified status before any external action.</p>
      </div>

      <div class="status-strip">
        <div class="status-card status-card--verified">
          <div class="status-label" data-i18n="researchPage.quality.verified">Verified</div>
          <p data-i18n="researchPage.quality.verifiedDesc">SMTP accepted the mailbox</p>
        </div>
        <div class="status-card status-card--partial">
          <div class="status-label" data-i18n="researchPage.quality.partial">Partial</div>
          <p data-i18n="researchPage.quality.partialDesc">Syntax + MX check passed</p>
        </div>
        <div class="status-card status-card--unverified">
          <div class="status-label" data-i18n="researchPage.quality.unverified">Unverified</div>
          <p data-i18n="researchPage.quality.unverifiedDesc">No passing verification receipts</p>
        </div>
      </div>

      <!-- SCHEDULED HARVESTING -->
      <div class="feat reveal" style="margin-top:72px">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="researchPage.harvesting.badge">Repeatable workflows</p>
          <h2 class="h2-sec" data-i18n-html data-i18n="researchPage.harvesting.title">Schedule, compare, notify</h2>
          <p class="copy-lg" data-i18n="researchPage.harvesting.sub">When the operator enables scheduling, <code class="ic">--repeat</code> can rerun a workflow and compare memory or stored findings. Notifications through a configured webhook, Telegram or email channel remain optional and policy-controlled.</p>
        </div>
        <div class="code-card">
          <pre><code># Run every 24 hours, alert on new contacts
fathom run --repeat 86400 \
  "Find VP Engineering at Series B startups in SF"

# Watch mode output:
# ── Findings changed since the previous run ──
# Reviewable contacts, evidence and gaps are written
# according to the configured output and approval policy.</code></pre>
        </div>
      </div>

      <!-- CRM & EXPORT -->
      <div class="sec-head center reveal" style="margin-top:72px">
<p class="eyebrow" data-i18n="researchPage.crm.badge">Handoff and export</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="researchPage.crm.title">Prepare findings for the next step</h2>
        <p class="copy-lg mx-auto" data-i18n="researchPage.crm.sub">Export contacts and reports as CSV, vCard, JSON or Excel. A worker can hand findings to amoCRM, Bitrix24, HubSpot or another configured integration after review and any required approval; integrations are not enabled by default.</p>
      </div>

      <div class="export-strip">
        <div class="export-card">
          <div class="export-name">CSV</div>
          <p data-i18n="researchPage.crm.csv">RFC 4180, 10 columns, semicolon-separated tags &amp; socials</p>
        </div>
        <div class="export-card">
          <div class="export-name">vCard 3.0</div>
          <p data-i18n="researchPage.crm.vcard">RFC 2426, N/FN/ORG/TITLE/EMAIL/TEL/X-SOCIALPROFILE</p>
        </div>
        <div class="export-card">
          <div class="export-name">JSON</div>
          <p data-i18n="researchPage.crm.json">Pretty-printed, all fields including social_profiles &amp; notes</p>
        </div>
        <div class="export-card">
          <div class="export-name">Excel</div>
          <p data-i18n="researchPage.crm.xlsx">XLSX via rust_xlsxwriter, "Contacts" worksheet</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="research-cta">
        <div class="bench-card-lg">
          <h3 data-i18n="researchPage.cta.title">Run a research workflow</h3>
          <p class="bench-sub" data-i18n="researchPage.cta.sub">Install Fathom, configure the worker's tools and ask it to produce reviewable findings.</p>
          <div class="code-card" style="max-width:560px">
            <pre><code>git clone https://github.com/yakushevhk/Fathom.git
cd Fathom
cargo build --release
./target/release/fathom run "Find CTOs at fintech startups in Berlin"</code></pre>
          </div>
          <div style="margin-top:16px">
            <a href="/docs/outreach" class="btn btn-outline" data-i18n="researchPage.cta.docs">Outreach &amp; leads docs</a>
          </div>
        </div>
      </div>

    </div>
  </main>
</Layout>

<style>
  .research-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .center { text-align: center; }

  .research-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .research-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .research-hero .copy-lg { margin-top: 20px; }

  .sec-head { max-width: 820px; margin: 0 auto 32px; padding: 0 24px; }
  .h2-sec { font-size: clamp(26px, 3.5vw, 48px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.08; margin-top: 12px; }

  /* Pipeline grid */
  .pipeline-grid { display: flex; flex-direction: column; gap: 2px; max-width: 900px; margin: 0 auto; }
  .pipeline-card { display: flex; gap: 20px; align-items: flex-start; background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 20px 24px; transition: box-shadow .25s, transform .25s var(--ease-out), border-color .25s; }
  .pipeline-card:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); border-color: var(--grey-400); }
  .pipeline-num { width: 36px; height: 36px; border-radius: 50%; background: var(--grey-900); color: var(--on-accent); display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 600; font-size: 14px; flex-shrink: 0; }
  .pipeline-name { font-family: var(--font-mono); font-weight: 600; font-size: 14px; margin-bottom: 6px; }
  .pipeline-card p { color: var(--grey-600); font-size: 13px; line-height: 1.55; }

  /* Sources grid */
  .src-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .src-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; transition: box-shadow .25s, transform .25s var(--ease-out); }
  .src-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .src-card--wide { grid-column: 1 / -1; }
  .src-name { font-family: var(--font-mono); font-weight: 600; font-size: 14px; margin-bottom: 10px; }
  .src-card p { color: var(--grey-600); font-size: 14px; line-height: 1.55; }
  @media (max-width: 700px) { .src-grid { grid-template-columns: 1fr; } }

  /* Verify grid */
  .verify-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .verify-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 20px; text-align: center; }
  .verify-name { font-family: var(--font-mono); font-weight: 700; font-size: 13px; display: block; margin-bottom: 10px; background: var(--grey-100); padding: 4px 10px; border-radius: var(--radius-sm); }
  .verify-card p { color: var(--grey-600); font-size: 12px; line-height: 1.5; }
  @media (max-width: 900px) { .verify-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 500px) { .verify-grid { grid-template-columns: 1fr; } }

  /* Tech grid */
  .tech-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .tech-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 20px; }
  .tech-name { font-family: var(--font-mono); font-weight: 600; font-size: 14px; margin-bottom: 8px; }
  .tech-card p { color: var(--grey-600); font-size: 13px; line-height: 1.5; }

  /* Status strip */
  .status-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 720px; margin: 0 auto; }
  .status-card { border-radius: var(--radius-lg); padding: 20px; text-align: center; border: 1px solid var(--grey-200); }
  .status-label { font-family: var(--font-mono); font-weight: 700; font-size: 14px; margin-bottom: 6px; }
  .status-card p { font-size: 13px; color: var(--grey-600); }
  .status-card--verified { background: rgba(168,204,176,.15); border-color: rgba(168,204,176,.4); }
  .status-card--verified .status-label { color: #3f7a52; }
  .status-card--partial { background: rgba(224,182,74,.1); border-color: rgba(224,182,74,.35); }
  .status-card--partial .status-label { color: #a07a20; }
  .status-card--unverified { background: var(--bg-card); }
  .status-card--unverified .status-label { color: var(--grey-500); }
  @media (max-width: 600px) { .status-strip { grid-template-columns: 1fr; } }

  /* Feat layout */
  .feat { display: grid; grid-template-columns: 1.2fr 1fr; gap: 48px; align-items: center; max-width: 1000px; margin: 0 auto; padding: 0 24px; }
  .feat-copy .h2-sec { font-size: clamp(24px, 3vw, 40px); }
  .feat-copy .btn { margin-top: 8px; }
  @media (max-width: 800px) { .feat { grid-template-columns: 1fr; gap: 24px; } }

  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--grey-900); overflow: hidden; }
  .code-card pre { padding: 20px 24px; margin: 0; overflow-x: auto; }
  .code-card code { color: var(--grey-200); font-family: var(--font-mono); font-size: 13px; line-height: 1.7; white-space: pre; }

  /* Export strip */
  .export-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; max-width: 800px; margin: 0 auto; }
  .export-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 20px; text-align: center; }
  .export-name { font-family: var(--font-mono); font-weight: 700; font-size: 15px; margin-bottom: 8px; }
  .export-card p { color: var(--grey-600); font-size: 12px; line-height: 1.5; }
  @media (max-width: 700px) { .export-strip { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 400px) { .export-strip { grid-template-columns: 1fr; } }

  /* CTA */
  .research-cta { max-width: 900px; margin: 64px auto 0; }
  .bench-card-lg { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 28px; }
  .bench-card-lg h3 { font-size: 22px; font-weight: 500; }
  .bench-sub { color: var(--grey-600); font-size: 14px; margin: 8px 0 18px; line-height: 1.6; }

  .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 13px; font-weight: 600; padding: 10px 20px; border-radius: var(--radius-sm); transition: all .15s; }
  .btn-outline { border: 1px solid var(--grey-300); color: var(--grey-800); }
  .btn-outline:hover { border-color: var(--grey-500); background: var(--grey-100); }
</style>
