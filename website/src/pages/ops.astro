---
import Layout from '../layouts/Layout.astro';

const blocks = [
  { key: 'jobs', name: 'Durable jobs', d: 'jobs submit/list/status/logs/cancel/rerun exposes persistent background work with recorded attempts and configured retry behavior. In-process async work can also be inspected through hub jobs.' },
  { key: 'multiprocess', name: 'Multi-process', d: 'Optional OS-process isolation per worker over Unix sockets, with operator-configured resource limits and independent process lifecycles.' },
  { key: 'hooks', name: 'Hooks', d: 'Subprocess hooks let operators gate or enrich runs: PreToolUse can allow or deny, PostToolUse can add context, and Stop can request a controlled continuation.' },
  { key: 'reliability', name: 'Reliability', d: 'Cancellation tokens propagate through the worker tree; classified errors can be retried with Retry-After. Web-content boundaries and loop detection add guardrails to long runs.' },
  { key: 'streaming', name: 'True streaming', d: 'With stream: true, text deltas reach the TUI as they arrive and tool calls are assembled from stream fragments; providers can be configured for a non-streaming path.' },
  { key: 'approval', name: 'Approval flow', d: 'Governance can pause side-effect tools such as save_contacts or git_push for an operator decision: y/n in the TUI or POST /api/v1/sessions/:id/approve in the API.' },
  { key: 'question', name: 'Question tool', d: 'Workers can ask the operator mid-task. Configure the unattended policy for how a run proceeds when no operator is connected.' },
  { key: 'watch', name: 'Watch mode', d: 'run --repeat runs a task on an operator-selected cadence, compares results between runs, and can send configured webhook, Telegram, or email notifications.' },
  { key: 'context', name: 'Context management', d: 'BPE token accounting (tiktoken cl100k_base), a CJK-aware fallback, per-tool truncation, persisted context, and cooldown-aware compaction keep long worker runs bounded.' },
  { key: 'export', name: 'Export & notify', d: 'Workers can produce PDF, HTML, JSON, or DOCX reports and notify configured webhook, email, or Telegram channels when a run completes.' },
  { key: 'crm', name: 'CRM sync', d: 'Configured amoCRM, Bitrix24, or HubSpot tools can push contacts and findings with crm_id-based deduplication where supported by the connector.' },
  { key: 'personas', name: 'Personas', d: 'run --profile selects a built-in or operator-defined TOML profile with prompt, model, depth, and tool settings. Per-role models use [agent.role_models].' },
  { key: 'goal', name: 'Goal Mode', d: 'After fan-out, an LLM judge can compare results with the goal and request configured gap-filling rounds. Reflection is useful for research and outreach workflows, not a quota guarantee.' },
  { key: 'tokens', name: 'Token budgets', d: 'Session limits and budget-capped sub-agent results help bound spend; per-tool latency and token statistics are available from real runs when observability is enabled.' },
  { key: 'verification_receipts', name: 'Verification receipts', d: 'An append-only JSONL ledger can record configured checks — email syntax, domain MX, SMTP probe, phone normalization, or social profile — with pass, fail, or inconclusive verdicts.' },
  { key: 'session_resume', name: 'Session resume', d: 'Interrupted sessions can be detected and state reconstructed so completed workers remain visible and unfinished subtasks can continue under operator policy.' },
  { key: 'file_history', name: 'File history & undo', d: 'Worker file modifications can be tracked for review, and undo can revert the last recorded change when an operator needs to recover.' },
  { key: 'fetch_cache', name: 'Fetch & MX cache', d: 'Session-scoped TTL caches can reuse fetched URLs and DNS MX lookups, reducing duplicate network requests within a run.' },
  { key: 'file_lock', name: 'File locking', d: 'Concurrent write serialization coordinates workers that share a workspace and avoids overlapping writes to the same file.' },
  { key: 'scratchpad', name: 'Scratchpad', d: 'A session-shared ledger gives coworkers a place for notes, partial results, and status updates during delegated work.' },
  { key: 'output_truncation', name: 'Output truncation', d: 'Per-tool byte and line caps plus turn budgets bound context growth; oversized outputs carry an explicit truncation marker.' },
  { key: 'coordination', name: 'Worker coordination', d: 'hub supports peer messaging, list, jobs, and activity updates; steer can redirect a live run. Workers may park and revive, while batch spawn accepts configured task groups with output schemas and handoffs.' },
  { key: 'daemon', name: 'Daemon management', d: 'The daemon tool starts, stops, restarts, lists, and reports status for long-running processes, with optional port or log-regex readiness checks.' },
  { key: 'stall_detection', name: 'Stall detection', d: 'Operator-configured warn and kill timeouts, heartbeat monitoring, and cancellation propagation help identify stuck workers and stop their descendants.' },
  { key: 'coworkers', name: 'Persistent coworkers', d: 'Durable worker profiles and collaboration channels retain identity, goals, and delivery surfaces across sessions.' },
  { key: 'schedules', name: 'Scheduled operations', d: 'An optional scheduler can trigger coworker work on cron-like schedules; atomic claims coordinate runs when multiple server processes are active.' },
  { key: 'credentials', name: 'Credential vault', d: 'Store named secrets through the authenticated API; list responses expose metadata while secret values remain server-side.' },
  { key: 'replay', name: 'Redacted replay', d: 'Inspect governed action history through a bounded replay endpoint, with credential values redacted before persistence.' },
  { key: 'observability', name: 'Operational observability', d: 'When enabled, Prometheus metrics and a bounded summary endpoint expose live sessions, tokens, tool calls, and governance audit counts.' },
  { key: 'notifications', name: 'Notifications', d: 'Test configured webhook, email, or Telegram channels through a bounded symbolic-channel endpoint; destinations and credentials stay server-side.' },
  { key: 'computer', name: 'Computer use', d: 'An authenticated, optionally configured computer relay can provide navigation, accessibility snapshots, screenshots, files, and human-control leases.' },
];
---

<Layout title="Operations — Fathom">
  <main class="ops-page">
    <div class="container">
      <div class="ops-hero">
        <p class="eyebrow" data-i18n="opsPage.hero.badge">Operations</p>
        <h1 class="h2-sec" data-i18n-html data-i18n="opsPage.hero.title">Built to run <em class="it">unattended.</em></h1>
        <p class="copy-lg mx-auto" data-i18n="opsPage.hero.sub">Beyond the agent loop: persistent coworkers, delegated jobs, memory, governance, optional computer use, configured notifications, durability, and observability for self-hosted runs you can inspect and steer.</p>
      </div>

      <div class="ops-grid">
        {
          blocks.map((b) => (
            <div class="ops-card">
              <div class="ops-name" data-i18n={'opsPage.blocks.' + b.key + '.name'}>{b.name}</div>
              <p data-i18n={'opsPage.blocks.' + b.key + '.d'}>{b.d}</p>
            </div>
          ))
        }
      </div>

      <div class="ops-cta">
        <div class="bench-card-lg">
          <h3 data-i18n="opsPage.cta.title">One runtime, several operator surfaces</h3>
          <p class="bench-sub" data-i18n="opsPage.cta.sub">The self-hosted distribution provides CLI, TUI, HTTP/SSE, AG-UI, and MCP surfaces from the Fathom runtime; enable workers and optional integrations in your deployment.</p>
          <div class="code-card">
            <pre><code>fathom run "..."            # one-shot
fathom run --repeat 24 ...  # every 24h with diff alerts
fathom jobs submit "..."    # durable background
fathom serve                # API + dashboard
fathom tui                  # interactive
fathom mcp-serve            # MCP server</code></pre>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .ops-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .ops-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .ops-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .ops-hero .copy-lg { margin-top: 20px; }

  .ops-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  .ops-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; transition: box-shadow .25s, transform .25s var(--ease-out), border-color .25s; }
  .ops-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: var(--grey-400); }
  .ops-name { font-family: var(--font-mono); font-weight: 600; font-size: 14px; margin-bottom: 10px; }
  .ops-card p { color: var(--grey-600); font-size: 14px; line-height: 1.55; }

  .ops-cta { max-width: 900px; margin: 48px auto 0; }
  .bench-card-lg { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 28px; }
  .bench-card-lg h3 { font-size: 22px; font-weight: 500; }
  .bench-sub { color: var(--grey-600); font-size: 14px; margin: 8px 0 18px; line-height: 1.6; }
  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--grey-900); overflow: hidden; }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 13px; line-height: 1.8; color: var(--grey-100); white-space: pre; }
</style>
