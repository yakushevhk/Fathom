---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Agency Multi-Tenant Fleets — Fathom Enterprise Solutions" description="Scale your agency with autonomous AI employee fleets: 12+ isolated client pods, white-label branding, and 92% net profit margin.">
  <main class="sol-detail-page">
    <PageHero cls="sol-detail-hero">
      <p class="eyebrow"><a href="/solutions" data-i18n="solutionsDetail.breadcrumb">Solutions</a> / <span data-i18n="solutionsDetail.agency.crumb">Agency Fleets</span></p>
      <h1 class="h2-sec" data-i18n-html data-i18n="solutionsDetail.agency.title">Agency <em class="it">Multi-Tenant Fleets</em></h1>
      <p class="copy-lg mx-auto" data-i18n="solutionsDetail.agency.sub">Deploy dedicated digital worker pods for each of your agency clients. Completely isolated memory graphs, custom branding, and flat-rate infrastructure economics.</p>
      
      <div class="sol-hero-metrics">
        <div class="metric-card">
          <div class="metric-val" data-i18n="solutionsDetail.agency.m1Val">92%</div>
          <div class="metric-lbl" data-i18n="solutionsDetail.agency.m1Lbl">Net Profit Margin</div>
        </div>
        <div class="metric-card">
          <div class="metric-val" data-i18n="solutionsDetail.agency.m2Val">12+</div>
          <div class="metric-lbl" data-i18n="solutionsDetail.agency.m2Lbl">Client Pods per Server</div>
        </div>
        <div class="metric-card">
          <div class="metric-val" data-i18n="solutionsDetail.agency.m3Val">$24k</div>
          <div class="metric-lbl" data-i18n="solutionsDetail.agency.m3Lbl">Typical Monthly Revenue</div>
        </div>
        <div class="metric-card">
          <div class="metric-val" data-i18n="solutionsDetail.agency.m4Val">&lt; $80</div>
          <div class="metric-lbl" data-i18n="solutionsDetail.agency.m4Lbl">Total Compute Cost / mo</div>
        </div>
      </div>
    </PageHero>

    <div class="container">
      <div class="sol-section">
        <div class="sec-head center">
          <p class="eyebrow"><span data-i18n="solutionsDetail.agency.sec1Eyebrow">Fleet Control Plane</span></p>
          <h2 class="h3-sec" data-i18n="solutionsDetail.agency.sec1Title">Agency Fleet Management Dashboard</h2>
          <p class="copy-lg mx-auto" data-i18n="solutionsDetail.agency.sec1Sub">Oversee 12 client pods across FinTech, HealthTech, and E-commerce from a single unified pane of glass with isolated SQLite memory vaults.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/mockups/15_agency_fleet_manager.png" alt="Agency White-Label Fleet Manager" loading="lazy" decoding="async" width="1220" height="780" />
        </div>
        <p class="screenshot-caption" data-i18n="solutionsDetail.agency.sec1Caption">Fig 4.1 — Agency Fleet Manager: Multi-tenant client isolation, task batch dispatch, and aggregate throughput telemetry.</p>
      </div>

      <div class="whitepaper-banner" style="margin-top: 80px;">
        <div>
          <p class="eyebrow" style="color:#60a5fa;"><span data-i18n="solutionsDetail.agency.bannerEyebrow">Agency Partnerships</span></p>
          <h2 style="font-size: 2.2rem; font-weight: 900; margin: 8px 0 16px 0;" data-i18n="solutionsDetail.agency.bannerTitle">Scale Your Agency Capacity 10×</h2>
          <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin-bottom: 24px;" data-i18n="solutionsDetail.agency.bannerSub">
            Deliver high-margin outbound, market research, and back-office automation to your clients without linear payroll expansion.
          </p>
          <div style="display:flex; gap: 16px; flex-wrap: wrap;">
            <a href="/#cta" class="btn btn-primary btn-lg" data-i18n="solutionsDetail.agency.bannerBtn">Request Agency Partnership Access →</a>
            <a href="/whitepaper" class="btn btn-secondary btn-lg" data-i18n="solutionsDetail.readWp">Read 42-Page Whitepaper</a>
          </div>
        </div>
        <div class="product-screenshot-frame" style="border-radius: var(--radius-md);">
          <img src="/images/mockups/14_outreach_campaign_dispatcher.png" alt="Campaign Dispatcher" loading="lazy" decoding="async" width="1220" height="780" />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .sol-detail-page { padding: 60px 0 90px; }
  .sol-detail-hero { text-align: center; max-width: 860px; margin: 0 auto 40px; padding: 0 20px; }
  .sol-detail-hero h1 { font-size: clamp(36px, 5.5vw, 68px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; margin-top: 12px; }
  .sol-hero-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-top: 36px; }
  .metric-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; text-align: center; }
  .metric-val { font-size: 2.2rem; font-weight: 800; color: var(--accent); }
  .metric-lbl { font-size: 0.84rem; font-weight: 600; color: var(--text-secondary); margin-top: 4px; }
  .product-screenshot-frame { border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-dark); box-shadow: var(--shadow-xl); }
  .product-screenshot-frame img { width: 100%; height: auto; display: block; }
  .screenshot-caption { text-align: center; font-size: 0.82rem; color: var(--text-tertiary); font-family: var(--font-mono); margin-top: 14px; }
</style>
