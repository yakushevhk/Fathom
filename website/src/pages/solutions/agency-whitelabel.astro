---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Agency Multi-Tenant Fleets — Fathom Enterprise Solutions" description="Scale your agency with autonomous AI employee fleets: 12+ isolated client pods, white-label branding, and 92% net profit margin.">
  <main class="sol-detail-page">
    <PageHero cls="sol-detail-hero">
      <p class="eyebrow"><a href="/solutions">Solutions</a> / <span>Agency Fleets</span></p>
      <h1 class="h2-sec">Agency <em class="it">Multi-Tenant Fleets</em></h1>
      <p class="copy-lg mx-auto">Deploy dedicated digital worker pods for each of your agency clients. Completely isolated memory graphs, custom branding, and flat-rate infrastructure economics.</p>
      
      <div class="sol-hero-metrics">
        <div class="metric-card">
          <div class="metric-val">92%</div>
          <div class="metric-lbl">Net Profit Margin</div>
        </div>
        <div class="metric-card">
          <div class="metric-val">12+</div>
          <div class="metric-lbl">Client Pods per Server</div>
        </div>
        <div class="metric-card">
          <div class="metric-val">$24k</div>
          <div class="metric-lbl">Typical Monthly Revenue</div>
        </div>
        <div class="metric-card">
          <div class="metric-val">&lt; $80</div>
          <div class="metric-lbl">Total Compute Cost / mo</div>
        </div>
      </div>
    </PageHero>

    <div class="container">
      <div class="sol-section">
        <div class="sec-head center">
          <p class="eyebrow"><span>Fleet Control Plane</span></p>
          <h2 class="h3-sec">Agency Fleet Management Dashboard</h2>
          <p class="copy-lg mx-auto">Oversee 12 client pods across FinTech, HealthTech, and E-commerce from a single unified pane of glass with isolated SQLite memory vaults.</p>
        </div>
        <div class="product-screenshot-frame">
          <img src="/images/mockups/15_agency_fleet_manager.png" alt="Agency White-Label Fleet Manager" loading="lazy" />
        </div>
        <p class="screenshot-caption">Fig 4.1 — Agency Fleet Manager: Multi-tenant client isolation, task batch dispatch, and aggregate throughput telemetry.</p>
      </div>

      <div class="whitepaper-banner" style="margin-top: 80px;">
        <div>
          <p class="eyebrow" style="color:#60a5fa;"><span>Agency Partnerships</span></p>
          <h2 style="font-size: 2.2rem; font-weight: 900; margin: 8px 0 16px 0;">Scale Your Agency Capacity 10×</h2>
          <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin-bottom: 24px;">
            Deliver high-margin outbound, market research, and back-office automation to your clients without linear payroll expansion.
          </p>
          <div style="display:flex; gap: 16px; flex-wrap: wrap;">
            <a href="/#cta" class="btn btn-primary btn-lg">Request Agency Partnership Access →</a>
            <a href="/whitepaper" class="btn btn-secondary btn-lg">Read 42-Page Whitepaper</a>
          </div>
        </div>
        <div class="product-screenshot-frame" style="border-radius: var(--radius-md);">
          <img src="/images/mockups/14_outreach_campaign_dispatcher.png" alt="Campaign Dispatcher" loading="lazy" />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .sol-detail-page { padding: 60px 0 90px; }
  .sol-detail-hero { text-align: center; max-width: 860px; margin: 0 auto 40px; padding: 0 20px; }
  .sol-detail-hero h1 { font-size: clamp(36px, 5.5vw, 68px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05; margin-top: 12px; }
  .sol-hero-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-top: 36px; }
  .metric-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 20px; text-align: center; }
  .metric-val { font-size: 2.2rem; font-weight: 800; color: var(--accent); }
  .metric-lbl { font-size: 0.84rem; font-weight: 600; color: var(--text-secondary); margin-top: 4px; }
</style>
