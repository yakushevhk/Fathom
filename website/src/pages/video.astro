    .scenario-card { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-card); text-align: left; padding: 0; transition: box-shadow 0.2s, transform 0.15s, border-color 0.2s; width: 100%; font-family: var(--font-sans); position: relative; }
    .scenario-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.08); transform: translateY(-3px); border-color: var(--accent); }
    .scenario-card.is-current-playing { border-color: #22c55e; box-shadow: 0 0 16px rgba(34, 197, 94, 0.25); transform: translateY(-2px); }
    .sc-card__bar { height: 4px; flex-shrink: 0; display: block; }
    .sc-card__thumb { aspect-ratio: 16/9; background: var(--bg-dark-card); overflow: hidden; position: relative; cursor: pointer; }
    .sc-card__img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
    .scenario-card:hover .sc-card__img { transform: scale(1.05); }
    .sc-play-badge { position: absolute; bottom: 6px; right: 6px; background: rgba(0, 0, 0, 0.75); color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 10px; font-family: var(--font-mono); font-weight: 600; backdrop-filter: blur(4px); }
    .sc-card__body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .sc-card__header { display: flex; gap: 8px; align-items: center; }
    .sc-card__avatar { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #fff; flex-shrink: 0; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.15); }
    .sc-card__name { font-size: 13px; font-weight: 600; color: var(--text-primary); letter-spacing: -0.01em; display: block; }
    .sc-card__role { font-size: 10px; color: var(--text-tertiary); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.04em; display: block; }
    .sc-card__desc { font-size: 12px; color: var(--text-secondary); line-height: 1.45; margin: 4px 0 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; flex: 1; }
    
    .sc-card__actions { display: flex; gap: 6px; align-items: center; border-top: 1px solid var(--border); padding-top: 8px; }
    .sc-btn { padding: 5px 8px; border-radius: 6px; font-size: 11px; font-weight: 500; text-decoration: none; cursor: pointer; border: 1px solid var(--border); background: var(--bg-tertiary); color: var(--text-primary); transition: all 0.15s; font-family: var(--font-sans); }
    .sc-btn:hover { background: var(--bg-card-hover); border-color: var(--accent); }
    .sc-btn--play { background: var(--accent-light); color: var(--accent); border-color: transparent; font-weight: 600; flex: 1; text-align: center; }
    .sc-btn--play:hover { background: var(--accent); color: var(--on-accent); }
    .sc-btn--demo { color: var(--text-secondary); }
    .sc-btn--deck { color: var(--text-tertiary); padding: 5px 6px; }

    /* Lightbox */
    .lightbox { position: fixed; inset: 0; z-index: 1000; background: rgba(0, 0, 0, 0.85); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(8px); }
    .lightbox[hidden] { display: none; }
    .lightbox__close { position: absolute; top: 20px; right: 24px; background: none; border: none; color: #fff; font-size: 24px; cursor: pointer; z-index: 10; font-family: var(--font-sans); }
    .lightbox__frame { max-width: 90vw; max-height: 88vh; display: flex; flex-direction: column; }
    .lightbox__bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: #1a1a2e; border-radius: 10px 10px 0 0; }
    .lightbox__traffic { display: flex; gap: 6px; }
    .lightbox__traffic i { width: 10px; height: 10px; border-radius: 50%; display: block; }
    .lightbox__traffic i:nth-child(1) { background: #ef4444; }
    .lightbox__traffic i:nth-child(2) { background: #eab308; }
    .lightbox__traffic i:nth-child(3) { background: #22c55e; }
    .lightbox__url { font-size: 12px; color: rgba(255, 255, 255, 0.5); font-family: var(--font-mono); margin-left: 8px; }
    .lightbox__img { max-width: 100%; max-height: 65vh; object-fit: contain; background: #0a0a1a; }
    .lightbox__caption-bar { display: flex; align-items: center; justify-content: space-between; background: #1a1a2e; padding: 12px 16px; border-radius: 0 0 10px 10px; gap: 16px; }
    .lightbox__caption { font-size: 13px; color: rgba(255, 255, 255, 0.85); margin: 0; }
    .lightbox__actions { display: flex; gap: 8px; flex-shrink: 0; }
    .btn-sm { padding: 6px 12px; font-size: 12px; }

    /* Deck CTA */
    .deck-cta { border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 40px; background: var(--bg-card); text-align: center; }
    .deck-cta__content { max-width: 500px; margin: 0 auto; }
    .deck-cta__content h2 { font-size: 22px; font-weight: 500; margin-bottom: 8px; }
    .deck-cta__content p { font-size: 15px; color: var(--text-secondary); margin-bottom: 20px; }
    .deck-cta__links { display: flex; gap: 12px; justify-content: center; }
    .deck-cta .btn { display: inline-block; padding: 10px 24px; border-radius: var(--radius-md); background: var(--accent); color: var(--on-accent); font-size: 14px; font-weight: 500; text-decoration: none; transition: background var(--duration); font-family: var(--font-sans); }
    .deck-cta .btn:hover { background: var(--accent-hover); }
    .deck-cta .btn-secondary { background: var(--bg-tertiary); color: var(--text-primary); }
    .deck-cta .btn-secondary:hover { background: var(--grey-400); }

    @media (max-width: 1200px) { .scenario-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 800px) { .scenario-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 500px) { .scenario-grid { grid-template-columns: 1fr; } }
