---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const SCENARIOS = [
  { id: 'sdr', icon: '✉️', color: '#f59e0b', name: 'Sales Outbound SDR', role: 'Lead Generation', mockup: '01_sales_outbound_sdr.png', desc: 'Discover 50+ verified CISO contacts at London fintech firms. SMTP validation, CRM push, zero bounces.' },
  { id: 'intel', icon: '📡', color: '#3b82f6', name: 'Market Intelligence', role: 'Competitive Research', mockup: '02_market_intelligence.png', desc: 'Track 15 competitors across fintech. Real-time alerts on pricing shifts, feature launches, exec hires.' },
  { id: 'talent', icon: '🎯', color: '#ec4899', name: 'Talent Scout', role: 'Technical Recruiting', mockup: '03_talent_scout.png', desc: 'Source 30 senior Rust engineers. GitHub AST mining, LinkedIn cross-check, verified emails.' },
  { id: 'onboard', icon: '🛟', color: '#10b981', name: 'Onboarding Agent', role: 'Client Setup', mockup: '13_customer_success_onboarding.png', desc: 'Provision API keys, configure webhooks, validate payloads in isolated sandbox REPL.' },
  { id: 'finance', icon: '📊', color: '#8b5cf6', name: 'Finance Ops', role: 'Invoice Processing', mockup: '04_backoffice_invoice.png', desc: 'Ingest 500 PDF invoices. 3-way match: PO / Receipt / Invoice. QuickBooks sync.' },
  { id: 'devops', icon: '🔧', color: '#ef4444', name: 'Software Maintainer', role: 'Bug Triage', mockup: '05_devops_engineer.png', desc: 'Triage Sentry errors. Map 240+ file repos, sandbox repro, fix + test + PR.' },
  { id: 'legal', icon: '⚖️', color: '#06b6d4', name: 'Compliance Auditor', role: 'Legal Risk', mockup: '12_legal_compliance_auditor.png', desc: 'Audit 200 vendor MSAs for GDPR. Parallel ingestion across 5 analysts.' },
  { id: 'orch', icon: '◈', color: '#a78bfa', name: 'Orchestrator', role: 'Swarm Coordinator', mockup: '11_swarm_coordinator.png', desc: 'Decompose research tasks, spawn sub-agents, parallel dispatch, synthesize, verify.' },
  { id: 'inbox', icon: '📬', color: '#f97316', name: 'Inbox Manager', role: 'Email Intelligence', mockup: '07_inbox_manager.png', desc: 'Process 1,000+ emails/day. Auto-categorize, priority triage, CRM sync.' },
  { id: 'lead', icon: '📋', color: '#14b8a6', name: 'Lead Audit Report', role: 'Data QA', mockup: '08_lead_audit_report.png', desc: 'Audit 10,000 leads. Deduplicate, validate emails, generate compliance-ready reports.' },
  { id: 'graph', icon: '🕸️', color: '#6366f1', name: 'Entity Knowledge Graph', role: 'Relationship Mapping', mockup: '09_entity_knowledge_graph.png', desc: 'Extract entities from 500+ docs. Build knowledge graph with SQLite FTS5.' },
  { id: 'vault', icon: '🔐', color: '#dc2626', name: 'Security Vault', role: 'Credential Governance', mockup: '10_security_credentials_vault.png', desc: 'AES-256-GCM vault. Fail-closed policy engine. Every tool call audited.' },
  { id: 'outreach', icon: '📣', color: '#d946ef', name: 'Outreach Dispatcher', role: 'Campaign Automation', mockup: '14_outreach_campaign_dispatcher.png', desc: 'Multi-channel campaigns. Personalize at scale: email, LinkedIn, phone.' },
  { id: 'fleet', icon: '🚀', color: '#0ea5e9', name: 'Agency Fleet Manager', role: 'Multi-Client Ops', mockup: '15_agency_fleet_manager.png', desc: 'Manage 15+ client accounts. Isolated worker fleets, SLA tracking.' },
  { id: 'computer', icon: '🖥️', color: '#84cc16', name: 'Computer Use', role: 'Desktop Automation', mockup: '06_computer_2fa_takeover.png', desc: 'Browser CDP control. Click, type, navigate SaaS UIs. 2FA human takeover.' },
];
---

<Layout
  title="Video — Fathom"
  description="Fathom 8-minute showreel: 15 autonomous AI worker scenarios. Sales outbound, market intelligence, talent scouting, desktop automation, and more."
>
  <main class="video-page">
    <PageHero cls="video-hero">
      <p class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span><span>Showreel</span></p>
      <h1 class="h2-sec">8 minutes. <em class="it">15 workers.</em></h1>
      <p class="copy-lg mx-auto">
        Every Fathom autonomous AI worker in action — from SDR outbound and market intelligence
        to computer use and 2FA takeover. <strong>60fps, 4K-ready, white backdrop.</strong>
        Full interactive demo at <a href="/demo" class="link-underline" style="color:var(--accent);">/demo</a>.
      </p>
    </PageHero>

    <section class="container">
      <!-- Video player -->
      <div class="feature-video">
        <div class="video-player">
          <video
            id="showreel"
            controls
            playsinline
            preload="metadata"
            poster="/images/mockups/mockup_01_sales_outbound.png"
            class="video-player__video"
          >
            <source src="https://cloud.y7.hk/videos/fathom_showreel.mp4" type="video/mp4" />
            <source src="/videos/fathom_showreel.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="video-meta">
          <span class="vm-chip">15 scenarios</span>
          <span class="vm-chip">8 min</span>
          <span class="vm-chip">60fps</span>
          <span class="vm-chip">H.264</span>
          <span class="vm-chip">10 MB</span>
        </div>
        <div class="video-links">
          <a href="/demo" class="btn btn-primary">&#x25B6; Try the live demo</a>
          <a href="/deck" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">Browse the slide deck</a>
        </div>
      </div>

      <!-- Timeline -->
      <div class="timeline">
        <div class="timeline__bar">
          <span class="tl-seg tl-intro" style="width:2%"><span class="tl-label">Intro</span></span>
          <span class="tl-seg" style="width:6.25%;background:#f59e0b"><span class="tl-label">SDR</span></span>
          <span class="tl-seg" style="width:6.25%;background:#3b82f6"><span class="tl-label">Intel</span></span>
          <span class="tl-seg" style="width:6.25%;background:#ec4899"><span class="tl-label">Scout</span></span>
          <span class="tl-seg" style="width:6.25%;background:#10b981"><span class="tl-label">Onboard</span></span>
          <span class="tl-seg" style="width:6.25%;background:#8b5cf6"><span class="tl-label">Finance</span></span>
          <span class="tl-seg" style="width:6.25%;background:#ef4444"><span class="tl-label">DevOps</span></span>
          <span class="tl-seg" style="width:6.25%;background:#06b6d4"><span class="tl-label">Audit</span></span>
          <span class="tl-seg" style="width:6.25%;background:#a78bfa"><span class="tl-label">Orch</span></span>
          <span class="tl-seg" style="width:6.25%;background:#f97316"><span class="tl-label">Inbox</span></span>
          <span class="tl-seg" style="width:6.25%;background:#14b8a6"><span class="tl-label">Leads</span></span>
          <span class="tl-seg" style="width:6.25%;background:#6366f1"><span class="tl-label">Graph</span></span>
          <span class="tl-seg" style="width:6.25%;background:#dc2626"><span class="tl-label">Vault</span></span>
          <span class="tl-seg" style="width:6.25%;background:#d946ef"><span class="tl-label">Outreach</span></span>
          <span class="tl-seg" style="width:6.25%;background:#0ea5e9"><span class="tl-label">Fleet</span></span>
          <span class="tl-seg" style="width:6.25%;background:#84cc16"><span class="tl-label">Computer</span></span>
          <span class="tl-seg tl-outro" style="width:2.5%"><span class="tl-label">Outro</span></span>
        </div>
        <p class="timeline__label">0:00 &nbsp;·&nbsp; <span class="tl-dot" style="background:#f59e0b"></span> SDR &nbsp;·&nbsp; <span class="tl-dot" style="background:#3b82f6"></span> Intel &nbsp;·&nbsp; <span class="tl-dot" style="background:#ec4899"></span> Scout &nbsp;·&nbsp; <span class="tl-dot" style="background:#10b981"></span> Onboard &nbsp;·&nbsp; <span class="tl-dot" style="background:#8b5cf6"></span> Finance &nbsp;·&nbsp; <span class="tl-dot" style="background:#ef4444"></span> DevOps &nbsp;·&nbsp; <span class="tl-dot" style="background:#06b6d4"></span> Audit &nbsp;·&nbsp; <span class="tl-dot" style="background:#a78bfa"></span> Orch &nbsp;·&nbsp; <span class="tl-dot" style="background:#f97316"></span> Inbox &nbsp;·&nbsp; <span class="tl-dot" style="background:#14b8a6"></span> Leads &nbsp;·&nbsp; <span class="tl-dot" style="background:#6366f1"></span> Graph &nbsp;·&nbsp; <span class="tl-dot" style="background:#dc2626"></span> Vault &nbsp;·&nbsp; <span class="tl-dot" style="background:#d946ef"></span> Outreach &nbsp;·&nbsp; <span class="tl-dot" style="background:#0ea5e9"></span> Fleet &nbsp;·&nbsp; <span class="tl-dot" style="background:#84cc16"></span> Computer &nbsp;·&nbsp; 8:00</p>
      </div>

      <!-- Scenario gallery -->
      <div class="scenario-section">
        <h2 class="scenario-section__title">All 15 workers <span class="scenario-count">in the showreel</span></h2>
        <div class="scenario-grid">
          {SCENARIOS.map((sc) => (
            <button type="button" class="scenario-card" data-scenario={sc.id} aria-label={'View ' + sc.name}>
              <span class="sc-card__bar" style={'background:' + sc.color}></span>
              <div class="sc-card__thumb">
                <img src={'/images/mockups/' + sc.mockup} alt={sc.name} class="sc-card__img" loading="lazy" />
              </div>
              <div class="sc-card__body">
                <span class="sc-card__avatar" style={'background:' + sc.color}>{sc.icon}</span>
                <span class="sc-card__name">{sc.name}</span>
                <span class="sc-card__role">{sc.role}</span>
                <span class="sc-card__desc">{sc.desc}</span>
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Lightbox -->
      <div class="lightbox" data-lightbox hidden>
        <button type="button" class="lightbox__close" aria-label="Close" data-lightbox-close>&#x2715;</button>
        <div class="lightbox__frame">
          <div class="lightbox__bar">
            <span class="lightbox__traffic"><i></i><i></i><i></i></span>
            <span class="lightbox__url" data-lightbox-url>fathom://worker/screen</span>
          </div>
          <img class="lightbox__img" data-lightbox-img alt="Worker screen" />
          <p class="lightbox__caption" data-lightbox-caption></p>
        </div>
      </div>

      <!-- Deck CTA -->
      <div class="deck-cta">
        <div class="deck-cta__content">
          <h2>Interactive slide deck</h2>
          <p>42 pages covering every scenario, architecture detail, and benchmark — rendered as an interactive HTML presentation.</p>
          <p class="deck-cta__links">
            <a href="/demo" class="btn btn-primary">&#x25B6; Live demo</a>
            <a href="/deck" class="btn btn-secondary" target="_blank" rel="noopener noreferrer">Browse the deck</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (function() {
      const lightbox = document.querySelector('[data-lightbox]');
      const lightboxImg = document.querySelector('[data-lightbox-img]');
      const lightboxUrl = document.querySelector('[data-lightbox-url]');
      const lightboxCaption = document.querySelector('[data-lightbox-caption]');
      const lightboxClose = document.querySelector('[data-lightbox-close]');

      // Open lightbox on card click
      document.querySelectorAll('.scenario-card').forEach(card => {
        card.addEventListener('click', function() {
          const img = this.querySelector('.sc-card__img');
          const name = this.querySelector('.sc-card__name').textContent;
          const role = this.querySelector('.sc-card__role').textContent;
          const desc = this.querySelector('.sc-card__desc').textContent;
          if (img) {
            lightboxImg.src = img.src;
            lightboxUrl.textContent = 'fathom://' + this.dataset.scenario + '/screen';
            lightboxCaption.textContent = name + ' — ' + role + '. ' + desc;
            lightbox.removeAttribute('hidden');
          }
        });
      });

      lightboxClose.addEventListener('click', function() {
        lightbox.setAttribute('hidden', '');
      });
      lightbox.addEventListener('click', function(e) {
        if (e.target === lightbox) lightbox.setAttribute('hidden', '');
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') lightbox.setAttribute('hidden', '');
      });
    })();
  </script>

  <style is:global>
    .video-page { padding: 0 0 90px; }
    .video-page .container { max-width: var(--container-max); margin: 0 auto; padding: 0 var(--container-padding); }
    .video-page .copy-lg a { color: var(--accent); text-decoration: none; }
    .video-page .copy-lg a:hover { text-decoration: underline; }

    /* Video player */
    .feature-video { margin-bottom: 32px; }
    .video-player { position: relative; aspect-ratio: 16/9; max-width: 900px; border-radius: var(--radius-lg); overflow: hidden; background: #fff; margin: 0 auto 16px; border: 1px solid var(--border); }
    .video-player__video { width: 100%; height: 100%; object-fit: contain; display: block; background: #fff; }
    .video-meta { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-bottom: 12px; }
    .vm-chip { font-size: 12px; padding: 2px 10px; border-radius: var(--radius-full); background: var(--bg-tertiary); color: var(--text-secondary); font-family: var(--font-mono); }
    .video-links { display: flex; gap: 12px; justify-content: center; margin-bottom: 40px; }
    .video-links .btn { padding: 10px 24px; border-radius: var(--radius-md); font-size: 14px; font-weight: 500; cursor: pointer; border: none; text-decoration: none; font-family: var(--font-sans); }
    .video-links .btn-primary { background: var(--accent); color: var(--on-accent); }
    .video-links .btn-primary:hover { background: var(--accent-hover); }
    .video-links .btn-secondary { background: var(--bg-tertiary); color: var(--text-primary); }
    .video-links .btn-secondary:hover { background: var(--grey-400); }

    /* Timeline */
    .timeline { margin-bottom: 48px; }
    .timeline__bar { display: flex; height: 20px; border-radius: 10px; overflow: hidden; margin-bottom: 8px; }
    .tl-seg { position: relative; display: flex; align-items: center; justify-content: center; }
    .tl-intro, .tl-outro { background: var(--grey-300); }
    .tl-label { font-size: 9px; font-weight: 600; color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,0.3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 2px; }
    .timeline__label { font-size: 12px; color: var(--text-tertiary); font-family: var(--font-mono); text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tl-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; vertical-align: middle; }

    /* Scenario gallery */
    .scenario-section { margin-bottom: 48px; }
    .scenario-section__title { font-size: 22px; font-weight: 500; margin-bottom: 20px; }
    .scenario-count { font-weight: 400; color: var(--text-tertiary); }
    .scenario-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }

    .scenario-card { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-card); cursor: pointer; text-align: left; padding: 0; transition: box-shadow var(--duration), transform 0.15s; width: 100; font-family: var(--font-sans); }
    .scenario-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
    .scenario-card:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
    .sc-card__bar { height: 4px; flex-shrink: 0; }
    .sc-card__thumb { aspect-ratio: 16/9; background: var(--bg-dark-card); overflow: hidden; }
    .sc-card__img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .sc-card__body { padding: 10px 12px 12px; display: flex; flex-direction: column; gap: 2px; }
    .sc-card__avatar { width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 11px; color: #fff; margin-bottom: 4px; }
    .sc-card__name { font-size: 13px; font-weight: 600; color: var(--text-primary); }
    .sc-card__role { font-size: 11px; color: var(--text-tertiary); font-family: var(--font-mono); }
    .sc-card__desc { font-size: 12px; color: var(--text-secondary); line-height: 1.4; margin-top: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    /* Lightbox (reuse from demo) */
    .lightbox { position: fixed; inset: 0; z-index: 1000; background: rgba(0, 0, 0, 0.8); display: flex; align-items: center; justify-content: center; backdrop-filter: blur(6px); }
    .lightbox[hidden] { display: none; }
    .lightbox__close { position: absolute; top: 20px; right: 24px; background: none; border: none; color: #fff; font-size: 24px; cursor: pointer; z-index: 10; font-family: var(--font-sans); }
    .lightbox__frame { max-width: 90vw; max-height: 88vh; display: flex; flex-direction: column; }
    .lightbox__bar { display: flex; align-items: center; gap: 8px; padding: 10px 14px; background: #1a1a2e; border-radius: 10px 10px 0 0; }
    .lightbox__traffic { display: flex; gap: 6px; }
    .lightbox__traffic i { width: 10px; height: 10px; border-radius: 50%; display: block; }
    .lightbox__traffic i:nth-child(1) { background: #ef4444; }
    .lightbox__traffic i:nth-child(2) { background: #eab308; }
    .lightbox__traffic i:nth-child(3) { background: #22c55e; }
    .lightbox__url { font-size: 12px; color: rgba(255, 255, 255, 0.5); font-family: var(--font-mono); margin-left: 8px; }
    .lightbox__img { max-width: 100%; max-height: 70vh; object-fit: contain; background: #0a0a1a; border-radius: 0 0 10px 10px; }
    .lightbox__caption { text-align: center; padding: 12px 0 0; font-size: 14px; color: rgba(255, 255, 255, 0.7); }

    /* Deck CTA */
    .deck-cta { border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 40px; background: var(--bg-card); text-align: center; }
    .deck-cta__content { max-width: 500px; margin: 0 auto; }
    .deck-cta__content h2 { font-size: 22px; font-weight: 500; margin-bottom: 8px; }
    .deck-cta__content p { font-size: 15px; color: var(--text-secondary); margin-bottom: 20px; }
    .deck-cta__links { display: flex; gap: 12px; justify-content: center; }
    .deck-cta .btn { display: inline-block; padding: 10px 24px; border-radius: var(--radius-md); background: var(--accent); color: var(--on-accent); font-size: 14px; font-weight: 500; text-decoration: none; transition: background var(--duration); font-family: var(--font-sans); }
    .deck-cta .btn:hover { background: var(--accent-hover); }
    .deck-cta .btn-secondary { background: var(--bg-tertiary); color: var(--text-primary); }
    .deck-cta .btn-secondary:hover { background: var(--grey-400); }

    @media (max-width: 1100px) { .scenario-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 700px) { .scenario-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 450px) { .scenario-grid { grid-template-columns: 1fr; } }
  </style>
</Layout>