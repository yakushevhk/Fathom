---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const posts = [
  {
    href: '/blog/benchmarks-repo-map',
    gradient: 'linear-gradient(160deg,#e9f0f5,#c9dfe9)',
    cat: 'Benchmarks',
    title: 'The benchmark that caught a 31× slowdown',
    meta: 'Aug 8, 2026 · Fathom Team',
  },
  {
    href: '/blog/memory-that-remembers',
    gradient: 'linear-gradient(160deg,#f3efe9,#dcd1c0)',
    cat: 'Memory',
    title: 'A memory that remembers: append-only knowledge for research agents',
    meta: 'Aug 9, 2026 · Fathom Team',
  },
  {
    href: '/blog/anatomy-of-fan-out',
    gradient: 'linear-gradient(160deg,#eef2e6,#cdd8b8)',
    cat: 'Architecture',
    title: 'Anatomy of a fan-out: one question, a fleet of agents',
    meta: 'Aug 10, 2026 · Fathom Team',
  },
  {
    href: '/blog/verification-pipeline',
    gradient: 'linear-gradient(160deg,#f0e9ef,#d9c8d7)',
    cat: 'Verification',
    title: 'Five gates: how we verify every email before it hits the CRM',
    meta: 'Aug 10, 2026 · Fathom Team',
  },
];
---

<Layout title="Blog — Fathom">
  <main class="blog-page">
        <PageHero cls="blog-hero">
        <p class="eyebrow" data-i18n="blog.hero.badge">Engineering Blog</p>
        <h1 class="h2-sec" data-i18n="blog.hero.title">Notes from the build.</h1>
        <p class="copy-lg mx-auto" data-i18n="blog.hero.sub">How Fathom actually works — benchmarks, memory design, agent orchestration. Written by the people who compile it.</p>
    </PageHero>
    <div class="container">

      <div class="blog-grid">
        {
          posts.map((p, i) => (
            <a class="blog-card" href={p.href}>
              <div class="bc-thumb" style={`background:${p.gradient}`}></div>
              <div class="bc-body">
                <div class="bc-cat" data-i18n={'blog.post.' + i + '.cat'}>{p.cat}</div>
                <div class="bc-title" data-i18n={'blog.post.' + i + '.title'}>{p.title}</div>
                <div class="bc-meta">{p.meta}</div>
              </div>
            </a>
          ))
        }
      </div>

      <div class="cta-strip">
        <h2 data-i18n="blog.cta.title">Numbers you can re-run.</h2>
        <div class="cta-actions">
          <a href="/benchmarks" class="btn btn-primary" data-i18n="blog.cta.benchmarks">See the benchmarks</a>
          <a href="/changelog" class="btn btn-ghost-light" data-i18n="blog.cta.changelog">Read the changelog</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .blog-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .blog-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .blog-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .blog-hero .copy-lg { margin-top: 20px; }

  .blog-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .blog-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); overflow: hidden; transition: transform .25s var(--ease-out), box-shadow .25s, border-color .25s; }
  .blog-card:hover { transform: translateY(-4px); border-color: var(--grey-400); box-shadow: 0 24px 50px -30px rgba(0, 0, 0, .3); }
  .blog-card .bc-thumb { height: 220px; position: relative; overflow: hidden; }
  .blog-card .bc-body { padding: 20px; }
  .blog-card .bc-cat { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .6px; color: var(--grey-600); }
  .blog-card .bc-title { font-size: 17px; font-weight: 500; margin: 8px 0; letter-spacing: -.01em; line-height: 1.3; color: var(--grey-900); }
  .blog-card .bc-meta { font-size: 13px; color: var(--grey-500); margin-top: 14px; }

  .cta-strip { margin-top: 64px; background: var(--bg-dark); border-radius: var(--radius-xl); padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta-strip h2 { color: #fff; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; }
  .cta-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .cta-strip .btn-primary { background: var(--bg-card); color: var(--grey-900); }
  .btn-ghost-light { color: #fff; border: 1px solid rgba(255, 255, 255, .35); }
  .btn-ghost-light:hover { border-color: #fff; background: rgba(255, 255, 255, .08); }
</style>
