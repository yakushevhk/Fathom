---
import Layout from '../layouts/Layout.astro';

const endpointGroups = [
  {
    key: 'sessions', name: 'Sessions',
    endpoints: [
      { m: 'POST', p: '/api/v1/sessions', d: 'Start an autonomous worker session (task, profile, model, budget)' },
      { m: 'GET', p: '/api/v1/sessions', d: 'List sessions with status and progress' },
      { m: 'GET', p: '/api/v1/sessions/:id', d: 'Session state, agent tree, token usage' },
      { m: 'GET', p: '/api/v1/sessions/:id/results', d: 'Findings, contacts, exports' },
      { m: 'DELETE', p: '/api/v1/sessions/:id', d: 'Cancel a running session' },
    ],
  },
  {
    key: 'agents', name: 'Agents',
    endpoints: [
      { m: 'GET', p: '/api/v1/agents', d: 'All agents across sessions (tree view)' },
      { m: 'GET', p: '/api/v1/agents/:id', d: 'Agent details, messages, tool calls' },
    ],
  },
  {
    key: 'control', name: 'Control plane',
    endpoints: [
      { m: 'POST', p: '/api/v1/sessions/:id/steer', d: 'Mid-run steering — redirect a running session' },
      { m: 'POST', p: '/api/v1/sessions/:id/answer', d: 'Answer an agent `question` tool call' },
      { m: 'POST', p: '/api/v1/sessions/:id/approve', d: 'Approve/deny a side-effect tool (approval flow)' },
    ],
  },
  {
    key: 'events', name: 'Events',
    endpoints: [
      { m: 'GET', p: '/api/v1/events', d: 'Global SSE stream of all agent events' },
      { m: 'GET', p: '/api/v1/sessions/:id/events', d: 'Per-session SSE stream (deltas, tool calls, findings)' },
    ],
  },
  {
    key: 'memory', name: 'Memory',
    endpoints: [
      { m: 'GET', p: '/api/v1/memories', d: 'Search the semantic memory store' },
      { m: 'POST', p: '/api/v1/memories/absorb', d: 'Ingest a fact (dedup + supersedes chains)' },
      { m: 'GET', p: '/api/v1/memories/stats', d: 'Store size, scopes, graph stats' },
      { m: 'POST', p: '/api/v1/memories/distill', d: 'Distill run-facts into durable knowledge' },
      { m: 'POST', p: '/api/v1/memories/gc', d: 'Archive stale facts, compact scope groups' },
      { m: 'GET / DELETE', p: '/api/v1/memories/:id', d: 'Inspect / archive a single memory' },
    ],
  },
  {
    key: 'jobs', name: 'Jobs',
    endpoints: [
      { m: 'POST', p: '/api/v1/jobs', d: 'Submit a durable background job (task, attempts)' },
      { m: 'GET', p: '/api/v1/jobs', d: 'List jobs' },
      { m: 'GET', p: '/api/v1/jobs/:id', d: 'Job status' },
      { m: 'GET', p: '/api/v1/jobs/:id/log', d: 'stdout + stderr of all attempts' },
      { m: 'DELETE', p: '/api/v1/jobs/:id', d: 'Cancel an active job' },
      { m: 'POST', p: '/api/v1/jobs/:id/rerun', d: 'Re-run a finished/stuck job' },
    ],
  },
  {
    key: 'governance', name: 'Governance & collaboration',
    endpoints: [
      { m: 'GET / PUT', p: '/api/v1/governance/policy', d: 'Read or replace the governance policy' },
      { m: 'POST', p: '/api/v1/governance/decide', d: 'Evaluate a governed action' },
      { m: 'GET', p: '/api/v1/governance/audit', d: 'Read governance audit events' },
      { m: 'GET / POST', p: '/api/v1/coworkers', d: 'List or create persistent coworker profiles' },
      { m: 'GET / PUT / PATCH / DELETE', p: '/api/v1/coworkers/:id', d: 'Inspect or update a coworker profile' },
      { m: 'GET / POST', p: '/api/v1/channels', d: 'List or create collaboration channels' },
      { m: 'PUT / PATCH / DELETE', p: '/api/v1/channels/:id', d: 'Update or remove a channel' },
      { m: 'GET / POST', p: '/api/v1/schedules', d: 'List or create cron-like coworker schedules' },
      { m: 'GET / PUT / PATCH / DELETE', p: '/api/v1/schedules/:id', d: 'Inspect, update, or remove a schedule' },
      { m: 'POST', p: '/api/v1/schedules/claim', d: 'Atomically claim due schedules for a scheduler tick' },
      { m: 'GET', p: '/api/v1/ag-ui/events', d: 'Stream AG-UI events' },
      { m: 'GET', p: '/api/v1/ag-ui/health', d: 'AG-UI health probe' },
    ],
  },
  {
    key: 'security', name: 'Credentials & audit',
    endpoints: [
      { m: 'GET / POST', p: '/api/v1/credentials', d: 'List redacted credential metadata or store a secret' },
      { m: 'DELETE', p: '/api/v1/credentials/:id', d: 'Delete a stored credential' },
      { m: 'GET', p: '/api/v1/replay', d: 'List redacted governed actions; filter by session or agent' },
      { m: 'GET', p: '/api/v1/observability/summary', d: 'Read bounded live metrics and audit counts' },
      { m: 'POST', p: '/api/v1/notifications/test', d: 'Send a bounded test through a configured notification channel' },
    ],
  },
  {
    key: 'computer', name: 'Computer relay',
    endpoints: [
      { m: 'POST', p: '/api/v1/computers/session', d: 'Start a computer session' },
      { m: 'GET', p: '/api/v1/computers/health', d: 'Check the default computer relay' },
      { m: 'GET', p: '/api/v1/computers/snapshot', d: 'Read the current computer snapshot' },
      { m: 'POST', p: '/api/v1/computers/navigate', d: 'Navigate the default computer relay' },
      { m: 'POST', p: '/api/v1/computers/click', d: 'Click through the computer relay' },
      { m: 'POST', p: '/api/v1/computers/type', d: 'Type through the computer relay' },
      { m: 'POST', p: '/api/v1/computers/key', d: 'Send a keyboard action' },
      { m: 'POST', p: '/api/v1/computers/secret', d: 'Enter a secret without returning or logging its value' },
      { m: 'GET', p: '/api/v1/computers/screenshot', d: 'Capture a screenshot' },
      { m: 'GET / POST', p: '/api/v1/computers/tabs*', d: 'List, open, activate, or close browser tabs' },
      { m: 'POST', p: '/api/v1/computers/control/take|release', d: 'Take or release operator control' },
      { m: 'GET / PUT / DELETE', p: '/api/v1/computers/files*', d: 'List, read, write, or delete confined workspace files' },
      { m: 'GET / POST', p: '/api/v1/computers', d: 'List computers or manage a supervisor-backed computer' },
    ],
  },
  {
    key: 'system', name: 'System',
    endpoints: [
      { m: 'GET', p: '/health', d: 'Liveness probe' },
      { m: 'GET', p: '/metrics', d: 'Prometheus metrics' },
      { m: 'GET', p: '/dashboard', d: 'Single-file web dashboard: sessions, agent tree, memory, jobs, live SSE feed' },
    ],
  },
];
---

<Layout title="API & Server — Fathom">
  <main class="api-page">
    <div class="container">
      <div class="api-hero">
        <p class="eyebrow" data-i18n="apiPage.hero.badge">API &amp; Server</p>
        <h1 class="h2-sec" data-i18n-html data-i18n="apiPage.hero.title">Run it headless.<br />Watch it live.</h1>
        <p class="copy-lg mx-auto" data-i18n="apiPage.hero.sub">An Axum HTTP control plane for autonomous workers: auth, rate limiting, SSE event streaming, mid-run steering, durable jobs, memory, governance, coworkers, schedules, computer use and an embedded dashboard — all in one binary.</p>
      </div>

      <!-- Auth -->
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="apiPage.auth.badge">Authentication</p>
          <h2 class="h3-sec" data-i18n="apiPage.auth.title">API keys + rate limiting</h2>
          <p class="copy-lg" data-i18n-html data-i18n="apiPage.auth.sub">Set <code class="ic">FATHOM_API_KEYS</code> (comma-separated) and every <code class="ic">/api/v1/*</code> request requires a key — Bearer token or <code class="ic">X-Api-Key</code> header. Sliding-window rate limiting from <code class="ic">FATHOM_RATE_LIMIT</code> returns <code class="ic">429</code> when exceeded. Unset = open access for development.</p>
        </div>
        <div class="code-card">
          <pre><code>curl -H "Authorization: Bearer $KEY" \
  http://localhost:8080/api/v1/sessions

curl -H "X-Api-Key: $KEY" \
  http://localhost:8080/api/v1/memories/stats</code></pre>
        </div>
      </div>

      <!-- Endpoints -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="apiPage.endpoints.badge">Endpoints</p>
        <h2 class="h3-sec" data-i18n="apiPage.endpoints.title">Everything is an endpoint</h2>
      </div>

      {
        endpointGroups.map((g) => (
          <div class="ep-group">
            <h3 class="ep-group__name" data-i18n={'apiPage.endpoints.groups.' + g.key + '.name'}>{g.name}</h3>
            <div class="ep-list">
              {
                g.endpoints.map((e, i) => (
                  <div class="ep-row">
                    <span class:list={['method', `method--${e.m.split(' ')[0].toLowerCase()}`]}>{e.m}</span>
                    <code class="ep-path">{e.p}</code>
                    <span class="ep-desc" data-i18n={'apiPage.endpoints.groups.' + g.key + '.endpoints.' + i + '.d'}>{e.d}</span>
                  </div>
                ))
              }
            </div>
          </div>
        ))
      }

      <!-- Example -->
      <div class="feat feat-reverse" id="example">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="apiPage.example.badge">Example</p>
          <h2 class="h3-sec" data-i18n="apiPage.example.title">Start a session, steer it mid-run</h2>
          <p class="copy-lg" data-i18n="apiPage.example.sub">Sessions start asynchronously. Follow progress on the SSE stream, then steer or answer questions while agents are still running.</p>
          <div class="more-links">
            <a href="/docs/api" class="btn btn-primary" data-i18n="apiPage.example.docs">Full API reference</a>
          </div>
        </div>
        <div class="code-card">
          <pre><code>{`curl -X POST localhost:8080/api/v1/sessions \\
  -H "Content-Type: application/json" \\
  -d '{"query":"Find VPs of Engineering
       at Series B fintech startups in SF"}'

# follow the live event stream
curl -N localhost:8080/api/v1/sessions/abc/events

# redirect mid-run
curl -X POST localhost:8080/api/v1/sessions/abc/steer \\
  -d '{"message":"Focus on Berlin instead"}'`}</code></pre>
        </div>
      </div>

      <!-- Observability -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="apiPage.observability.badge">Observability</p>
        <h2 class="h3-sec" data-i18n="apiPage.observability.title">Prometheus metrics</h2>
        <p class="copy-lg" data-i18n-html data-i18n="apiPage.observability.sub">Scrape <code class="ic">/metrics</code> and graph the whole fleet. The authenticated API also exposes <code class="ic">/api/v1/observability/summary</code> for bounded live counters and audit totals.</p>
      </div>
      <div class="mini-table-wrap">
        <table class="mini-table">
          <thead><tr><th>Metric</th><th>Type</th><th>What it counts</th></tr></thead>
          <tbody>
            <tr><td>pr_http_requests_total</td><td>counter</td><td>requests by route and status</td></tr>
            <tr><td>pr_request_duration_seconds</td><td>histogram</td><td>latency distribution</td></tr>
            <tr><td>pr_sessions_total</td><td>counter</td><td>sessions started</td></tr>
            <tr><td>pr_sessions_active</td><td>gauge</td><td>sessions running right now</td></tr>
            <tr><td>pr_agents_spawned_total</td><td>counter</td><td>sub-agents across all trees</td></tr>
            <tr><td>pr_tool_calls_total</td><td>counter</td><td>tool executions by name</td></tr>
            <tr><td>pr_tokens_used_total</td><td>counter</td><td>LLM tokens consumed</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Ops -->
      <div class="api-grid" id="ops">
        <div class="api-card">
          <div class="api-name" data-i18n="apiPage.ops.prom.name">Prometheus</div>
          <p data-i18n="apiPage.ops.prom.d">/metrics exposes request counts, latencies, session and tool gauges for Grafana dashboards.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="apiPage.ops.sse.name">SSE streaming</div>
          <p data-i18n="apiPage.ops.sse.d">Token deltas, tool calls, agent spawn/finish and findings arrive as server-sent events — no polling.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="apiPage.ops.dashboard.name">Web dashboard</div>
          <p data-i18n="apiPage.ops.dashboard.d">GET /dashboard serves the embedded single-file HTML dashboard: sessions, agent tree, memory, jobs, live event feed.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="apiPage.ops.cors.name">CORS</div>
          <p data-i18n="apiPage.ops.cors.d">Cross-origin access configurable via [server] config — restrict origins in production.</p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .api-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .h3-sec { font-size: clamp(20px, 2.4vw, 34px); font-weight: 500; letter-spacing: -0.02em; margin: 12px 0 16px; }
  .ic { font-family: var(--font-mono); font-size: .85em; background: var(--grey-100); border: 1px solid var(--grey-200); padding: 1px 6px; border-radius: 5px; }

  .api-hero { max-width: 820px; margin: 0 auto 56px; text-align: center; padding: 0 24px; }
  .api-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .api-hero .copy-lg { margin-top: 20px; }

  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .feat { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding: 56px 0; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  @media (max-width: 900px) { .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; direction: ltr; } }

  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--bg-dark); overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 13px; line-height: 1.65; color: var(--grey-100); white-space: pre; }

  .sec-head { margin: 40px 0 28px; }

  .ep-group { margin-bottom: 26px; }
  .ep-group__name { font-family: var(--font-mono); font-size: 13px; text-transform: uppercase; letter-spacing: .6px; color: var(--grey-500); margin-bottom: 10px; }
  .ep-list { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); overflow: hidden; }
  .ep-row { display: grid; grid-template-columns: 110px 320px 1fr; gap: 14px; align-items: center; padding: 13px 18px; border-bottom: 1px solid var(--grey-100); }
  .ep-row:last-child { border-bottom: none; }
  .ep-row:hover { background: var(--grey-50); }
  .method { font-family: var(--font-mono); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .4px; padding: 3px 8px; border-radius: 5px; text-align: center; }
  .method--get { background: rgba(143,182,204,.25); color: #4a7186; }
  .method--post { background: rgba(168,204,176,.3); color: #3f7a52; }
  .method--delete { background: rgba(224,140,74,.22); color: #a05a20; }
  .ep-path { font-family: var(--font-mono); font-size: 13px; color: var(--grey-900); }
  .ep-desc { font-size: 13px; color: var(--grey-600); line-height: 1.5; }
  @media (max-width: 800px) {
    .ep-row { grid-template-columns: 90px 1fr; }
    .ep-desc { grid-column: 1 / -1; }
  }

  .more-links { display: flex; gap: 10px; margin-top: 24px; }

  .api-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: var(--grey-300); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--grey-300); margin-top: 60px; }
  .api-card { background: var(--bg-card); padding: 26px 24px; display: flex; flex-direction: column; gap: 8px; }
  .api-card .api-name { font-family: var(--font-mono); font-weight: 600; font-size: 15px; }
  .api-card p { color: var(--text-secondary); font-size: 14px; line-height: 1.5; }
  @media (max-width: 800px) { .api-grid { grid-template-columns: 1fr; } }

  .mini-table-wrap { border: 1px solid var(--border); border-radius: 8px; overflow: auto; background: var(--bg-card); }
  .mini-table { width: 100%; border-collapse: collapse; font-size: 13px; font-family: var(--font-mono); }
  .mini-table th { font-size: 10px; text-transform: uppercase; letter-spacing: .6px; color: var(--text-secondary); text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--border); background: var(--bg-secondary); }
  .mini-table td { padding: 10px 14px; border-bottom: 1px solid var(--border-light); color: var(--text-primary); }
  .mini-table tr:last-child td { border-bottom: none; }
</style>
