---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import AgentCanvas from '../components/AgentCanvas.astro';
import RunTimeline from '../components/RunTimeline.astro';
import OceanField from '../components/OceanField.astro';
import HeroField from '../components/HeroField.astro';

const agents = [
  { name: 'Coordinator', mode: 'coordinator', hue: 206, href: '/agents/coordinator' },
  { name: 'Researcher', mode: 'researcher', hue: 180, href: '/agents/researcher' },
  { name: 'Coder', mode: 'coder', hue: 25, href: '/agents/coder' },
  { name: 'Operator', mode: 'operator', hue: 260, href: '/agents/operator' },
  { name: 'Browser', mode: 'browser', hue: 55, href: '/agents/browser' },
  { name: 'Memory keeper', mode: 'memoring', hue: 25, href: '/agents/memoring' },
  { name: 'Reviewer', mode: 'reviewer', hue: 205, href: '/agents/reviewer' },
];

const backends = ['Linkup', 'Exa', 'Tavily', 'Serper', 'Brave', 'Parallel.ai', 'DuckDuckGo'];

const usecases = [
  {
    k: 'landing.uc.outreach', n: '01', href: '/features/auto-outreach', cls: 'uc--wide',
    t: 'Outreach & lead generation',
    d: 'Find prospects across the web, verify every email through a five-gate pipeline, draft personalized sequences, and sync approved contacts to your CRM.',
    chips: ['find prospects', 'verify emails', 'draft sequences', 'sync CRM'],
  },
  {
    k: 'landing.uc.research', n: '02', href: '/features/research', cls: '',
    t: 'Deep research',
    d: 'Seven search backends fused into one query, then fetch, parse, cross-reference and synthesize findings into a sourced brief.',
    chips: ['7 search backends', 'cross-check sources', 'synthesized brief'],
  },
  {
    k: 'landing.uc.code', n: '03', href: '/tools', cls: '',
    t: 'Code & computer use',
    d: 'Write and run code, inspect repositories, drive a browser and operate an optional connected computer — inside explicit tool boundaries.',
    chips: ['write & run code', 'browser flows', 'desktop actions'],
  },
  {
    k: 'landing.uc.ops', n: '04', href: '/ops', cls: '',
    t: 'Scheduled operations',
    d: 'Durable background jobs survive restarts, repeat on a schedule, and resume interrupted work exactly where it stopped.',
    chips: ['durable jobs', 'repeat runs', 'auto-resume'],
  },
  {
    k: 'landing.uc.memory', n: '05', href: '/memory', cls: '',
    t: 'Memory that persists',
    d: 'Hybrid vector + BM25 search and an entity graph keep every finding across sessions — scanned for secrets before it lands.',
    chips: ['vector + BM25', 'entity graph', 'cross-session'],
  },
];

const capabilityRows = [
  { k: 'landing.capc.1', t: 'Code + optional computer tools', d: 'Web, files, shell, code, browser, vision, Git, and verification; computer tools appear when the optional service is configured.' },
  { k: 'landing.capc.2', t: 'Durable semantic memory', d: 'Vector + BM25 hybrid search, entity graph, and worker findings that persist across sessions.' },
  { k: 'landing.capc.3', t: 'Persistent workers and jobs', d: 'Durable background jobs can continue across restarts and scheduled runs.' },
  { k: 'landing.capc.4', t: 'Governance and approvals', d: 'Approval gates, policy hooks, protected surfaces, and secret scanning keep side effects reviewable.' },
  { k: 'landing.capc.5', t: 'MCP integrations', d: 'Connect external tools over stdio or HTTP, and expose Fathom tools through mcp-serve.' },
  { k: 'landing.capc.6', t: 'HTTP, SSE, AG-UI, and TUI', d: 'Serve workers through HTTP/SSE and AG-UI compatibility, or operate them from the terminal.' },
  { k: 'landing.capc.7', t: 'Profiles and roles', d: 'Use built-in personas or define your own TOML worker profile.' },
  { k: 'landing.capc.8', t: 'Scheduled operations', d: 'Run repeatable work on a schedule and notify operators when configured.' },
  { k: 'landing.capc.9', t: 'Replay and observability', d: 'Inspect sessions, replay events, and export Prometheus-compatible metrics.' },
  { k: 'landing.capc.10', t: 'Operator notifications', d: 'Webhook, email, and Telegram fan-out alerts when configured and triggered.' },
];

const steps = [
  { k: 'landing.step.1', n: '01', t: 'Goal', d: 'Describe an outcome in plain language. The coordinator turns it into durable sub-tasks.' },
  { k: 'landing.step.2', n: '02', t: 'Plan and act', d: 'Workers delegate, use configured tools, and coordinate research, code, computer, or operations work.' },
  { k: 'landing.step.3', n: '03', t: 'Remember and review', d: 'Findings persist in memory; policies and approval gates make side effects reviewable.' },
  { k: 'landing.step.4', n: '04', t: 'Deliver', d: 'Return a report, code change, approved update, or notification through the interface you choose.' },
];

const metrics = [
  { v: '3.78×', l: 'CPU-bound parallel speedup', k: 'landing.metrics.cpu' },
  { v: '531k', l: 'rows/s HTML parsing', k: 'landing.metrics.html' },
  { v: '1.1M', l: 'items/s feed parsing', k: 'landing.metrics.feed' },
  { v: '~2ms', l: 'hybrid memory search', k: 'landing.metrics.mem' },
];
---

<Layout title="Fathom — One Universal AI Worker for Every Job" description="Fathom is the universal autonomous AI worker: outreach and lead generation, deep research, code, computer use, and scheduled operations — with memory, governance, and human review in one self-hosted runtime.">

  <!-- ============ HERO ============ -->
  <section class="hero">
    <HeroField />
    <div class="container hero__grid">
      <div class="hero__main">
        <p class="hero-badge">
          <span class="hero-badge__dot" aria-hidden="true"></span>
          <span data-i18n="landing.badge">Universal autonomous AI worker</span>
        </p>
        <h1 class="hero__title" data-i18n-html data-i18n="landing.title">One worker.<br /><em class="it">Every</em> job done.</h1>
        <p class="hero__subtitle" data-i18n="landing.subtitle">
          Fathom is a universal AI worker you self-host: it runs outreach, does deep research, writes code, operates a computer, and works on a schedule — with durable memory, governance, and human review built into one runtime.
        </p>
        <div class="hero__actions">
          <a href="/#cta" class="btn btn-primary btn-lg" data-i18n="landing.cta1">Start building</a>
          <a href="#features" class="btn btn-secondary btn-lg" data-i18n="landing.cta2">See what it can do</a>
        </div>
        <div class="hero__mono-row">
          <a href="https://github.com/yakushevhk/Fathom" class="hero__gh" target="_blank" rel="noopener">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            <span data-i18n="landing.hero_gh">GitHub demo</span>
          </a>
          <a href="mailto:hello@fathom.uz" class="hero__mail">hello@fathom.uz</a>
        </div>
        <p class="hero__mono" data-i18n="landing.hero_mono">Rust · one binary · memory · governance · schedules</p>
      </div>

      <div class="hero__visual">
        <div class="machine">
          <div class="machine__bar">
            <div class="machine__dots"><i></i><i></i><i></i></div>
            <span class="machine__url" data-i18n="landing.hero_run_url">fathom run</span>
          </div>
          <div class="machine__body">
            <div class="prompt-line"><span class="p">$</span><span class="pc" data-i18n="landing.hero_run_cmd">fathom run "Find 50 fintech CTOs, verify emails, draft outreach"</span></div>
            <div class="tags-row">
              <span class="ptag ptag--plan" data-i18n="landing.term.tag_plan">Planning</span><span data-i18n="landing.term.plan">Decomposing into 4 sub-tasks…</span>
            </div>
            <div class="tags-row">
              <span class="ptag ptag--run" data-i18n="landing.term.tag_run">Researching</span><span data-i18n="landing.term.spawn">Spawning 4 parallel agents</span>
            </div>
            <div class="agent-lines">
              <div class="agent-line"><span class="od">●</span> <span data-i18n="landing.term.a1">Researching the market and sources</span></div>
              <div class="agent-line"><span class="od">●</span> <span data-i18n="landing.term.a2">Verifying emails through 5 gates</span></div>
              <div class="agent-line"><span class="od">●</span> <span data-i18n="landing.term.a3">Drafting personalized sequences</span></div>
              <div class="agent-line"><span class="od">●</span> <span data-i18n="landing.term.a4">Saving findings to shared memory</span></div>
            </div>
            <div class="tags-row">
              <span class="ptag ptag--ok" data-i18n="landing.term.tag_ok">Complete</span><span data-i18n="landing.term.done">50 contacts ready, checks passed</span>
            </div>
            <div class="tags-row">
              <span class="ptag ptag--save" data-i18n="landing.term.tag_save">Saving</span><span data-i18n="landing.term.save">Updating memory + notifying the team</span>
            </div>
            <div class="prompt-line"><span class="p">$</span><span class="cursor">▊</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PRODUCT SHOWCASE ============ -->
  <section class="product-showcase-section">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow"><span class="eyebrow__num">00</span><span data-i18n="landing.showcase.workspaceLabel">Autonomous Workspace</span></p>
        <h2 class="h2-sec" data-i18n="landing.showcase.workspaceTitle">Live GPUI Workspace <em class="it">in Action</em></h2>
        <p class="copy-lg mx-auto" data-i18n="landing.showcase.workspaceDesc">Complete multi-agent execution workspace: sub-agent swarm dispatch, live ARIA DOM browser control, and real-time CRM pipeline sync.</p>
      </div>
      <div class="product-screenshot-frame">
        <img src="/images/mockups/01_sales_outbound_sdr.png" alt="Fathom Autonomous Outbound SDR Command Center" loading="lazy" width="1220" height="780" />
      </div>
      <p class="screenshot-caption">Fig 1.0 — Fathom Command Center: Swarm coordinator breaking objectives into parallel worker tasks, inspecting live Playwright browser viewport, and executing verified CRM writes.</p>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <section class="marquee-section">
    <div class="marquee-head">
      <p class="eyebrow"><span data-i18n="landing.marquee_label">Workers connect to your stack</span></p>
    </div>
    <div class="marquee-track-wrap">
      <div class="marquee-track">
        {
          [...backends, ...backends].map((b) => (
            <span class="mlogo">{b}</span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ USE CASES / BENTO ============ -->
  <section class="section alt" id="features">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow"><span class="eyebrow__num">01</span><span data-i18n="landing.uc_label">What your worker does</span></p>
        <h2 class="h2-sec" data-i18n-html data-i18n="landing.uc_title">Delegate the <em class="it">whole pipeline</em></h2>
        <p class="copy-lg mx-auto" data-i18n="landing.uc_sub">One goal in — finished work out. The same worker runs outreach, research, code and operations, switching roles as the task demands.</p>
      </div>

      <div class="uc-grid">
        {
          usecases.map((u) => (
            <a href={u.href} class:list={['uc-card', u.cls]}>
              <div class="uc-top">
                <span class="uc-num">{u.n}</span>
                <span class="uc-go">→</span>
              </div>
              <h3 class="uc-name" data-i18n={u.k + '.t'}>{u.t}</h3>
              <p class="uc-desc" data-i18n={u.k + '.d'}>{u.d}</p>
              <div class="uc-chips">
                {u.chips.map((c, ci) => (
                  <span class="uc-chip" data-i18n={`${u.k}.c${ci + 1}`}>{c}</span>
                ))}
              </div>
            </a>
          ))
        }

        <div class="uc-card uc--strip">
          <div class="uc-strip-copy">
            <h3 class="uc-name" data-i18n="landing.uc.report.t">Reports &amp; notifications</h3>
            <p class="uc-desc" data-i18n="landing.uc.report.d">Every finished run lands where your team already looks — webhook, email or Telegram. One failing channel never blocks the rest.</p>
          </div>
          <div class="uc-chips uc-strip-chips">
            <span class="uc-chip" data-i18n="landing.uc.report.c1">Webhook</span>
            <span class="uc-chip" data-i18n="landing.uc.report.c2">Email SMTP</span>
            <span class="uc-chip" data-i18n="landing.uc.report.c3">Telegram</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AGENT TYPES (canvas) ============ -->
  <section class="section agents-sec">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow"><span class="eyebrow__num on-dark">02</span><span data-i18n="landing.agents_label">Agent types</span></p>
        <h2 class="h2-sec" data-i18n-html data-i18n="landing.agents_title">A crew of <em class="it">specialists</em></h2>
        <p class="copy-lg mx-auto" data-i18n="landing.agents_sub">Each sub-agent has a focused role and its own behavior. Coordinators decompose, fan out, reflect, and synthesize.</p>
      </div>

      <AgentCanvas agents={agents} />
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section" id="how-it-works">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow"><span class="eyebrow__num">03</span><span data-i18n="landing.how_label">How it works</span></p>
        <h2 class="h2-sec" data-i18n-html data-i18n="landing.how_title">From goal to <em class="it">governed</em> execution</h2>
      </div>

      <div class="steps-grid">
        {
          steps.map((s) => (
            <div class="step">
              <div class="step-number">{s.n}</div>
              <div class="step-body">
                <h3 data-i18n={s.k + '.t'}>{s.t}</h3>
                <p data-i18n={s.k + '.d'}>{s.d}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ BENCHMARK TEASER ============ -->
  <section class="section alt" id="benchmarks">
    <div class="container">
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow"><span class="eyebrow__num">04</span><span data-i18n="landing.bench_label">Performance</span></p>
          <h2 class="h2-sec" data-i18n-html data-i18n="landing.bench_title">Built for speed.<br /><em class="it">Measured</em>, not claimed.</h2>
          <p class="copy-lg" data-i18n="landing.bench_sub">Real benchmarks from the release build — parallel tool execution spreads CPU across cores and ships verified results with minimal dispatch overhead.</p>
          <a href="/benchmarks" class="btn btn-secondary" data-i18n="landing.bench_cta">See all benchmarks →</a>
        </div>
        <div class="bench-strip">
          {
            metrics.map((m) => (
              <div class="bench-card">
                <div class="metric">{m.v}</div>
                <div class="cap" data-i18n={m.k}>{m.l}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MORE CAPABILITIES ============ -->
  <section class="section">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow"><span class="eyebrow__num">05</span><span data-i18n="landing.overview_label">The full toolbox</span></p>
        <h2 class="h2-sec" data-i18n-html data-i18n="landing.overview_title">One engine, <em class="it">every</em> capability</h2>
      </div>

      <div class="api-grid">
        {
          capabilityRows.map((c) => (
            <div class="api-card">
              <div class="api-name" data-i18n={c.k + '.t'}>{c.t}</div>
              <p data-i18n={c.k + '.d'}>{c.d}</p>
            </div>
          ))
        }
      </div>
      <div class="sec-head center more-links">
        <a href="/tools" class="btn btn-primary" data-i18n="landing.tools_cta">Browse all Rust tools</a>
        <a href="/architecture" class="btn btn-secondary" data-i18n="landing.arch_cta">Architecture</a>
        <a href="/memory" class="btn btn-secondary" data-i18n="landing.mem_cta">Memory &amp; Graph</a>
      </div>
    </div>
  </section>

  <!-- ============ SAFETY & RELIABILITY ============ -->
  <section class="section alt">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow"><span class="eyebrow__num">06</span><span data-i18n="landing.safety_label">Safety &amp; Reliability</span></p>
        <h2 class="h2-sec" data-i18n-html data-i18n="landing.safety_title">Guardrails that <em class="it">never sleep</em></h2>
        <p class="copy-lg mx-auto" data-i18n="landing.safety_sub">Every agent action passes through multiple safety layers — from doom-loop detection to secret scanning to human approval gates.</p>
      </div>

      <div class="api-grid safety-grid">
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.doom.t">Doom Loop Detection</div>
          <p data-i18n="landing.safety.doom.d">Stuck agents repeating the same tool call are detected and stopped automatically — no runaway costs.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.approval.t">Approval Gates</div>
          <p data-i18n="landing.safety.approval.d">Side-effect tools like save_contacts and git_push wait for explicit human approval before executing.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.secrets.t">Secret Scanning</div>
          <p data-i18n="landing.safety.secrets.d">API keys, passwords and tokens are blocked before they can enter the long-term memory store.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.injection.t">Injection Defense</div>
          <p data-i18n="landing.safety.injection.d">Prompt injection attempts in web-fetched content are detected and neutralized before they reach the model.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.resume.t">Session Resume</div>
          <p data-i18n="landing.safety.resume.d">Crashed or interrupted sessions are detected and reconstructed — unfinished sub-tasks continue from where they stopped.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.protected.t">Protected Surfaces</div>
          <p data-i18n="landing.safety.protected.d">Safety configs, memory databases and own source code are guarded from self-modifying agent actions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ONE RUN, END TO END ============ -->
  <section class="section pipeline-sec">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow"><span class="eyebrow__num">07</span><span data-i18n="landing.pipe_label">One live run</span></p>
        <h2 class="h2-sec" data-i18n-html data-i18n="landing.pipe_title">Watch one run, <em class="it">end to end</em></h2>
        <p class="copy-lg mx-auto" data-i18n="landing.pipe_sub">The same honest path every time: goal → plan → tools → verification → approval → memory → delivery. Every stage is visible, every number is real.</p>
      </div>

      <RunTimeline />
    </div>
  </section>

  <!-- ============ DEEP WORK (three.js ocean) ============ -->
  <section class="ocean-sec">
    <OceanField />
    <div class="container ocean-content">
      <p class="eyebrow"><span class="eyebrow__num">08</span><span data-i18n="landing.ocean_label">Deep work</span></p>
      <h2 class="h2-sec" data-i18n-html data-i18n="landing.ocean_title">Built to go <em class="it">deep</em></h2>
      <p class="copy-lg" data-i18n="landing.ocean_sub">A fathom is a nautical measure of depth. Ours is measured in gates and backends: seven search engines deep, five verification gates deep, every session replayable to the bottom.</p>
      <p class="ocean-mono" data-i18n="landing.ocean_mono">1 fathom = 1.829 m · depth of work</p>
    </div>
  </section>

  <!-- ============ WHITEPAPER BANNER ============ -->
  <section class="section">
    <div class="container">
      <div class="whitepaper-banner">
        <div>
          <p class="eyebrow" style="color:#60a5fa;"><span data-i18n="landing.whitepaper.badge">Strategic Systems Whitepaper</span></p>
          <h2 style="font-size: 2.2rem; font-weight: 900; margin: 8px 0 16px 0; letter-spacing: -0.02em;" data-i18n="landing.whitepaper.title">42-Page Systems Architecture &amp; Workforce Blueprint</h2>
          <p style="color: #94a3b8; font-size: 1.05rem; line-height: 1.6; margin-bottom: 24px;" data-i18n="landing.whitepaper.desc">
            Explore the definitive architectural and economic breakdown of autonomous AI employees: ~0.75 ms tool dispatch, 94 µs memory assimilation, 15.4 MB RAM footprint, and unlimited neural compute economics.
          </p>
          <div style="display:flex; gap: 16px; flex-wrap: wrap;">
            <a href="/Fathom_Whitepaper.pdf" class="btn btn-primary" target="_blank" download data-i18n="landing.whitepaper.download">⬇ Download Whitepaper (PDF, 7.6 MB)</a>
            <a href="https://github.com/yakushevhk/Fathom/tree/main/whitepaper" class="btn btn-secondary" target="_blank" data-i18n="landing.whitepaper.deck">View 42-Slide Deck</a>
          </div>
        </div>
        <div class="product-screenshot-frame" style="border-radius: var(--radius-md);">
          <img src="/images/mockups/11_swarm_coordinator.png" alt="Swarm Coordinator DAG Architecture" loading="lazy" decoding="async" width="1220" height="780" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta" id="cta">
    <div class="container">
      <h2 class="h2-sec" data-i18n-html data-i18n="landing.cta_title">Put a worker on it <em class="it">today</em></h2>
      <p class="copy-lg mx-auto" data-i18n="landing.cta_sub">Self-hosted and reviewable. No vendor lock-in. Give your workers access to the tools, memory, and schedules your team controls.</p>
      <div class="cta__actions">
        <a href="https://github.com/yakushevhk/Fathom" class="btn btn-primary" target="_blank" rel="noopener" data-i18n="landing.cta_gh">See the demo on GitHub</a>
        <a href="mailto:hello@fathom.uz" class="btn btn-cta-ghost" data-i18n="landing.cta_mail">Request access →</a>
      </div>
      <p class="sub" data-i18n="landing.cta_mono">fathom run "your task here" · docs · request access</p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section alt" id="faq">
    <div class="container">
      <div class="sec-head center reveal">
