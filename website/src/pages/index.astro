---
import Layout from '../layouts/Layout.astro';
import JsonLd from '../components/JsonLd.astro';
import AgentCanvas from '../components/AgentCanvas.astro';
import Pipeline3D from '../components/Pipeline3D.astro';

const agents = [
  { name: 'Coordinator', mode: 'coordinator', hue: 206, href: '/profiles' },
  { name: 'Researcher', mode: 'researcher', hue: 180, href: '/agents/researcher' },
  { name: 'Coder', mode: 'coder', hue: 25, href: '/tools' },
  { name: 'Operator', mode: 'operator', hue: 260, href: '/ops' },
  { name: 'Browser', mode: 'browser', hue: 55, href: '/tools' },
  { name: 'Memory keeper', mode: 'memoring', hue: 25, href: '/memory' },
  { name: 'Reviewer', mode: 'reviewer', hue: 205, href: '/security' },
];

const backends = ['Linkup', 'Exa', 'Tavily', 'Serper', 'Brave', 'Parallel.ai', 'DuckDuckGo'];
const capabilities = [
  { k: 'landing.cap.r', t: 'Research & analysis', d: 'Workers search, fetch, parse, cross-reference, and synthesize findings from configured sources.', url: '/features/research' },
  { k: 'landing.cap.l', t: 'Code & computer use', d: 'Run code, inspect repositories, and operate an optional connected computer through explicit tool boundaries.', url: '/tools' },
  { k: 'landing.cap.o', t: 'Operations & outreach', d: 'Draft actions, sync approved records, schedule repeat runs, and notify your team when configured.', url: '/features/auto-outreach' },
];

const capabilityRows = [
  { k: 'landing.capc.1', t: 'Code + optional computer tools', d: 'Web, files, shell, code, browser, vision, Git, and verification; computer tools appear when the optional service is configured.' },
  { k: 'landing.capc.2', t: 'Durable semantic memory', d: 'Vector + BM25 hybrid search, entity graph, and worker findings that persist across sessions.' },
  { k: 'landing.capc.3', t: 'Persistent workers and jobs', d: 'Durable background jobs can continue across restarts and scheduled runs.' },
  { k: 'landing.capc.4', t: 'Governance and approvals', d: 'Approval gates, policy hooks, protected surfaces, and secret scanning keep side effects reviewable.' },
  { k: 'landing.capc.5', t: 'MCP integrations', d: 'Connect external tools over stdio or HTTP, and expose Fathom tools through mcp-serve.' },
  { k: 'landing.capc.6', t: 'HTTP, SSE, AG-UI, and TUI', d: 'Serve workers through HTTP/SSE and AG-UI compatibility, or operate them from the terminal.' },
  { k: 'landing.capc.7', t: 'Profiles and roles', d: 'Use built-in personas or define your own TOML worker profile.' },
  { k: 'landing.capc.8', t: 'Scheduled operations', d: 'Run repeatable work on a schedule and notify operators when configured.' },
  { k: 'landing.capc.9', t: 'Replay and observability', d: 'Inspect sessions, replay events, and export Prometheus-compatible metrics.' },
  { k: 'landing.capc.10', t: 'Operator notifications', d: 'Webhook, email, and Telegram fan-out alerts when configured and triggered.' },
];

const steps = [
  { k: 'landing.step.1', n: '01', t: 'Goal', d: 'Describe an outcome in plain language. The coordinator turns it into durable sub-tasks.' },
  { k: 'landing.step.2', n: '02', t: 'Plan and act', d: 'Workers delegate, use configured tools, and coordinate research, code, computer, or operations work.' },
  { k: 'landing.step.3', n: '03', t: 'Remember and review', d: 'Findings persist in memory; policies and approval gates make side effects reviewable.' },
  { k: 'landing.step.4', n: '04', t: 'Deliver', d: 'Return a report, code change, approved update, or notification through the interface you choose.' },
];

const metrics = [
  { v: '3.78×', l: 'CPU-bound parallel speedup' },
  { v: '531k', l: 'rows/s HTML parsing' },
  { v: '1.1M', l: 'items/s feed parsing' },
  { v: '~2ms', l: 'hybrid memory search' },
];
---

<Layout title="Fathom — Autonomous AI Workers" description="Fathom is a universal autonomous AI worker platform for research, code, computer use, scheduled operations, memory, governance, and reviewable automation.">

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container">
      <div class="hero__main">
        <p class="eyebrow" data-i18n="landing.badge">Universal autonomous AI workers</p>
        <h1 class="hero__title" data-i18n-html data-i18n="landing.title">Remote workers<br />that get things done.</h1>
        <p class="hero__subtitle" data-i18n="landing.subtitle">
          Fathom is a universal autonomous worker platform. Deploy persistent agents for research, outreach, code, computer use, and scheduled operations — with memory, governance, notifications, and human review built into one runtime.
        </p>
        <div class="hero__actions">
          <a href="#cta" class="btn btn-primary btn-lg" data-i18n="landing.cta1">Start building</a>
          <a href="#features" class="btn btn-secondary btn-lg" data-i18n="landing.cta2">Explore features</a>
        </div>
        <p class="hero__mono" data-i18n="landing.hero_mono">Rust · built-in tools plus optional browser and computer services · one runtime</p>
      </div>

      <div class="hero__visual">
        <div class="machine">
          <div class="machine__bar">
            <div class="machine__dots"><i></i><i></i><i></i></div>
            <span class="machine__url">fathom run</span>
          </div>
          <div class="machine__body">
            <div class="prompt-line"><span class="p">$</span><span class="pc">fathom run "Prepare a market brief and open a draft PR"</span></div>
            <div class="tags-row">
              <span class="ptag ptag--plan">Planning</span><span data-i18n="landing.term.plan">Decomposing into 4 sub-tasks…</span>
            </div>
            <div class="tags-row">
              <span class="ptag ptag--run">Researching</span><span data-i18n="landing.term.spawn">Spawning 4 parallel agents</span>
            </div>
            <div class="agent-lines">
              <div class="agent-line"><span class="od">●</span> <span data-i18n="landing.term.a1">Researching the market and sources</span></div>
              <div class="agent-line"><span class="od">●</span> <span data-i18n="landing.term.a2">Editing code in a sandbox</span></div>
              <div class="agent-line"><span class="od">●</span> <span data-i18n="landing.term.a3">Using the browser to check a workflow</span></div>
              <div class="agent-line"><span class="od">●</span> <span data-i18n="landing.term.a4">Saving findings to shared memory</span></div>
            </div>
            <div class="tags-row">
              <span class="ptag ptag--ok">Complete</span><span data-i18n="landing.term.done">Brief ready, checks passed</span>
            </div>
            <div class="tags-row">
              <span class="ptag ptag--save">Saving</span><span data-i18n="landing.term.save">Updating memory + notifying the team</span>
            </div>
            <div class="prompt-line"><span class="p">$</span><span class="cursor">▊</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <section class="marquee-section">
    <div class="marquee-head">
      <p class="eyebrow" data-i18n="landing.marquee_label">Workers connect to your stack</p>
    </div>
    <div class="marquee-track-wrap">
      <div class="marquee-track">
        {
          [...backends, ...backends].map((b) => (
            <span class="mlogo">{b}</span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CAPABILITIES / FEATURES ============ -->
  <section class="section alt" id="features">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="landing.value_label">What you get</p>
        <h2 class="h2-sec" data-i18n="landing.value_title">One worker, many missions</h2>
        <p class="copy-lg mx-auto" data-i18n="landing.value_sub">Give Fathom a goal and let autonomous workers research, write code, use a computer, and run repeatable operations with your approval.</p>
      </div>

      <div class="cap-grid">
        {
          capabilities.map((c, i) => (
            <a href={c.url} class:list={['cap-card', i === 1 ? 'cap-card--accent' : '']}>
              <h3 class="cap-name" data-i18n={c.k + '.t'}>{c.t}</h3>
              <p class="cap-desc" data-i18n={c.k + '.d'}>{c.d}</p>
              <span class="cap-go" data-i18n="landing.learn">Explore →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ AGENT TYPES (canvas) ============ -->
  <section class="section agents-sec">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="landing.agents_label">Agent types</p>
        <h2 class="h2-sec" data-i18n="landing.agents_title">Purpose-built agent roles</h2>
        <p class="copy-lg mx-auto" data-i18n="landing.agents_sub">Each sub-agent has a focused role and its own behavior. Coordinators decompose, fan out, reflect, and synthesize.</p>
      </div>

      <AgentCanvas agents={agents} />
    </div>
  </section>

  <!-- ============ BENCHMARK TEASER ============ -->
  <section class="section alt" id="benchmarks">
    <div class="container">
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="landing.bench_label">Performance</p>
          <h2 class="h2-sec" data-i18n-html data-i18n="landing.bench_title">Built for speed.<br />Measured, not claimed.</h2>
          <p class="copy-lg" data-i18n="landing.bench_sub">Real benchmarks from the release build — parallel tool execution spreads CPU across cores and ships verified results with minimal dispatch overhead.</p>
          <a href="/benchmarks" class="btn btn-secondary" data-i18n="landing.bench_cta">See all benchmarks →</a>
        </div>
        <div class="bench-strip">
          {
            metrics.map((m) => (
              <div class="bench-card">
                <div class="metric">{m.v}</div>
                <div class="cap">{m.l}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MORE CAPABILITIES ============ -->
  <section class="section">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="landing.overview_label">The full toolbox</p>
        <h2 class="h2-sec" data-i18n="landing.overview_title">One engine, every capability</h2>
      </div>

      <div class="api-grid">
        {
          capabilityRows.map((c) => (
            <div class="api-card">
              <div class="api-name" data-i18n={c.k + '.t'}>{c.t}</div>
              <p data-i18n={c.k + '.d'}>{c.d}</p>
            </div>
          ))
        }
      </div>
      <div class="sec-head center more-links">
        <a href="/tools" class="btn btn-primary" data-i18n="landing.tools_cta">Browse all Rust tools</a>
        <a href="/architecture" class="btn btn-secondary" data-i18n="landing.arch_cta">Architecture</a>
        <a href="/memory" class="btn btn-secondary" data-i18n="landing.mem_cta">Memory &amp; Graph</a>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="section alt" id="how-it-works">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="landing.how_label">How it works</p>
        <h2 class="h2-sec" data-i18n="landing.how_title">From goal to governed execution</h2>
      </div>

      <div class="steps-grid">
        {
          steps.map((s, i) => (
            <>
              {i > 0 && <div class="step-connector">→</div>}
              <div class="step">
                <div class="step-number">{s.n}</div>
                <div class="step-body">
                  <h3 data-i18n={s.k + '.t'}>{s.t}</h3>
                  <p data-i18n={s.k + '.d'}>{s.d}</p>
                </div>
              </div>
            </>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ SAFETY & RELIABILITY ============ -->
  <section class="section">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="landing.safety_label">Safety & Reliability</p>
        <h2 class="h2-sec" data-i18n="landing.safety_title">Guardrails that never sleep</h2>
        <p class="copy-lg mx-auto" data-i18n="landing.safety_sub">Every agent action passes through multiple safety layers — from doom-loop detection to secret scanning to human approval gates.</p>
      </div>

      <div class="api-grid safety-grid">
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.doom.t">Doom Loop Detection</div>
          <p data-i18n="landing.safety.doom.d">Stuck agents repeating the same tool call are detected and stopped automatically — no runaway costs.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.approval.t">Approval Gates</div>
          <p data-i18n="landing.safety.approval.d">Side-effect tools like save_contacts and git_push wait for explicit human approval before executing.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.secrets.t">Secret Scanning</div>
          <p data-i18n="landing.safety.secrets.d">API keys, passwords and tokens are blocked before they can enter the long-term memory store.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.injection.t">Injection Defense</div>
          <p data-i18n="landing.safety.injection.d">Prompt injection attempts in web-fetched content are detected and neutralized before they reach the model.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.resume.t">Session Resume</div>
          <p data-i18n="landing.safety.resume.d">Crashed or interrupted sessions are detected and reconstructed — unfinished sub-tasks continue from where they stopped.</p>
        </div>
        <div class="api-card">
          <div class="api-name" data-i18n="landing.safety.protected.t">Protected Surfaces</div>
          <p data-i18n="landing.safety.protected.d">Safety configs, memory databases and own source code are guarded from self-modifying agent actions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ LIVE PIPELINE DEMO ============ -->
  <section class="section pipeline-sec">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="landing.pipe_label">One live pipeline</p>
        <h2 class="h2-sec" data-i18n="landing.pipe_title">A live run you can inspect</h2>
        <p class="copy-lg mx-auto" data-i18n="landing.pipe_sub">Watch a goal travel through the engine: workers plan, use tools, write findings to memory, pause for approvals, and deliver a report or action with notifications.</p>
      </div>

      <Pipeline3D />
    </div>
  </section>

  <!-- ============ NOTIFICATIONS ============ -->
  <section class="section alt">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="landing.notify_label">Notifications</p>
        <h2 class="h2-sec" data-i18n="landing.notify_title">Never miss a completed run</h2>
        <p class="copy-lg mx-auto" data-i18n="landing.notify_sub">Fan-out delivery to every configured channel. One failing channel does not block the rest.</p>
      </div>

      <div class="notify-grid">
        <div class="notify-card">
          <div class="notify-name" data-i18n="landing.notify.webhook.t">Webhook</div>
          <p data-i18n="landing.notify.webhook.d">Generic JSON POST to any URL — session_id, summary, synthesis preview, token counts and output path.</p>
        </div>
        <div class="notify-card">
          <div class="notify-name" data-i18n="landing.notify.email.t">Email (SMTP)</div>
          <p data-i18n="landing.notify.email.d">Plain or STARTTLS SMTP delivery. Subject includes session ID, body includes summary and synthesis preview.</p>
        </div>
        <div class="notify-card">
          <div class="notify-name" data-i18n="landing.notify.telegram.t">Telegram</div>
          <p data-i18n="landing.notify.telegram.d">Bot message with checkmark, summary, synthesis preview and full report path.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta" id="cta">
    <div class="container">
      <h2 class="h2-sec" data-i18n="landing.cta_title">Start building with Fathom</h2>
      <p class="copy-lg mx-auto" data-i18n="landing.cta_sub">Self-hosted and reviewable. No vendor lock-in. Give your workers access to the tools, memory, and schedules your team controls.</p>
      <a href="/install" class="btn btn-primary" data-i18n="landing.cta_access">Read installation guide →</a>
      <p class="sub" data-i18n="landing.cta_mono">fathom bench · docs · request access</p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section alt" id="faq">
    <div class="container">
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="landing.faq_label">FAQ</p>
        <h2 class="h2-sec" data-i18n="landing.faq_title">Frequently asked questions</h2>
      </div>
      <div class="faq-grid">
        <details class="faq-item">
          <summary data-i18n="landing.faq.q1">How is Fathom different from a ChatGPT plugin?</summary>
          <p data-i18n="landing.faq.a1">Fathom is a universal autonomous worker runtime in Rust: it plans goals, coordinates sub-agents, uses code and computer tools, remembers context, and keeps side effects behind governance gates — not a single-session chat context window.</p>
        </details>
        <details class="faq-item">
          <summary data-i18n="landing.faq.q2">Which search engines are supported?</summary>
          <p data-i18n="landing.faq.a2">Seven backends — Linkup, Exa, Tavily, Serper, Brave, Parallel.ai and DuckDuckGo — fused with hybrid and smart modes and RRF ranking, so one query spans the whole web, not just the first page.</p>
        </details>
        <details class="faq-item">
          <summary data-i18n="landing.faq.q3">Is my data stored on your servers?</summary>
          <p data-i18n="landing.faq.a3">No. Fathom is distributed as a self-hosted binary — sessions, contacts and memory live in your own SQLite/PostgreSQL databases on your infrastructure. There is no cloud lock-in.</p>
        </details>
        <details class="faq-item">
          <summary data-i18n="landing.faq.q4">Which interfaces can operators use?</summary>
          <p data-i18n="landing.faq.a4">Use the CLI and TUI, or expose a configured runtime through HTTP/SSE, AG-UI compatibility, and MCP. The available surface depends on how you deploy and configure Fathom.</p>
        </details>
      </div>
    </div>
  </section>

  <JsonLd data={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Fathom — Autonomous AI Workers',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux, Windows (WSL)',
    description: 'A universal autonomous AI worker platform with durable sessions, code and computer tools, research, scheduled operations, memory, governance, and reviewable automation.',
    url: 'https://fathom.uz/',
    downloadUrl: 'https://fathom.uz/install',
    installUrl: 'https://fathom.uz/install',
    fileFormat: 'binary',
    releaseNotes: 'https://fathom.uz/changelog',
  }} />

  <JsonLd data={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How is Fathom different from a ChatGPT plugin?',
        acceptedAnswer: { '@type': 'Answer', text: 'Fathom is a universal autonomous worker runtime in Rust: it plans goals, coordinates sub-agents, uses code and computer tools, remembers context, and keeps side effects behind governance gates.' },
      },
      {
        '@type': 'Question',
        name: 'Which search engines are supported?',
        acceptedAnswer: { '@type': 'Answer', text: 'Seven backends — Linkup, Exa, Tavily, Serper, Brave, Parallel.ai and DuckDuckGo — fused with hybrid and smart modes and RRF ranking.' },
      },
      {
        '@type': 'Question',
        name: 'Is my data stored on your servers?',
        acceptedAnswer: { '@type': 'Answer', text: 'No. Fathom is self-hosted — sessions, contacts and memory live in your own databases on your infrastructure. No cloud lock-in.' },
      },
      {
        '@type': 'Question',
        name: 'Which interfaces can operators use?',
        acceptedAnswer: { '@type': 'Answer', text: 'Use the CLI and TUI, or expose a configured runtime through HTTP/SSE, AG-UI compatibility, and MCP. The available surface depends on deployment and configuration.' },
      },
    ],
  }} />

</Layout>

<style>
  /* ---- Hero ---- */
  .hero { padding: 60px 0 72px; }
  .hero .container { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }

  .eyebrow {
    font-family: var(--font-mono);
    letter-spacing: 0.16px;
    color: var(--grey-600);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero__title {
    font-size: clamp(52px, 8.5vw, 128px);
    line-height: 0.94;
    letter-spacing: -0.03em;
    font-weight: 450;
    margin-top: 24px;
  }

  .hero__subtitle {
    margin-top: 26px;
    color: var(--grey-700);
    font-size: clamp(16px, 1.9vw, 21px);
    line-height: 1.5;
    max-width: 560px;
  }

  .hero__actions { margin-top: 34px; display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-lg { padding: 14px 26px; font-size: 15px; }

  .hero__mono {
    margin-top: 26px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--grey-500);
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  /* ---- Machine (terminal demo) ---- */
  .machine {
    border: 1px solid var(--grey-300);
    border-radius: 10px;
    background: var(--bg-card);
    overflow: hidden;
    box-shadow: 0 1px 1px rgba(0,0,0,.03), 0 30px 60px -30px rgba(0,0,0,.35);
  }
  .machine__bar {
    display: flex; align-items: center; gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--grey-200);
    background: var(--grey-50);
  }
  .machine__dots { display: flex; gap: 6px; }
  .machine__dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--grey-300); display: block; }
  .machine__dots i:first-child { background: #edb7a8; }
  .machine__dots i:nth-child(2) { background: #e8d49a; }
  .machine__dots i:nth-child(3) { background: #a8ccb0; }
  .machine__url { margin: 0 auto; font-family: var(--font-mono); font-size: 12px; color: var(--grey-600); }
  .machine__body { padding: 20px; font-family: var(--font-mono); font-size: 13px; }

  .prompt-line { display: flex; gap: 8px; color: var(--grey-800); align-items: baseline; flex-wrap: wrap; }
  .prompt-line .p { color: var(--grey-500); }
  .prompt-line .pc { color: var(--grey-900); }

  .tags-row { margin-top: 12px; display: flex; align-items: center; gap: 8px; color: var(--grey-600); font-size: 12px; flex-wrap: wrap; }

  .ptag {
    font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .4px;
    padding: 2px 7px; border-radius: 4px;
  }
  .ptag--plan { background: rgba(143,182,204,.25); color: #4a7186; }
  .ptag--run { background: rgba(224,140,74,.22); color: #a05a20; }
  .ptag--ok { background: rgba(168,204,176,.3); color: #3f7a52; }
  .ptag--save { background: rgba(216,207,186,.35); color: #7a6a3a; }

  .agent-lines { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; padding-left: 18px; }
  .agent-line { color: var(--grey-500); font-size: 12px; display: flex; gap: 8px; align-items: center; }
  .od { color: var(--grey-800); }

  .cursor { color: var(--grey-900); animation: blink 1.1s step-end infinite; }
  @keyframes blink { 0%,55% { opacity: 1; } 56% { opacity: .06; } }

  /* staggered terminal "typing" */
