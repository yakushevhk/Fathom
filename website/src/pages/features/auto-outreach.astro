---
import Layout from '../../layouts/Layout.astro';

const channels = [
  { t: 'Cold email', d: 'Short, specific, grounded in real context — never generic.' },
  { t: 'LinkedIn', d: 'Connection notes and follow-ups tuned to the channel\u2019s limits.' },
  { t: 'Telegram / DM', d: 'Conversational openers for messaging-first markets.' },
];
---

<Layout title="Outreach Workers — Fathom" description="Autonomous outreach workers ground personalized drafts in verified context, memory, and human approval before delivery.">
  <main class="ao-page">
    <div class="container">
      <div class="ao-hero">
        <p class="eyebrow"><a href="/features" class="crumb">Features</a> / <span data-i18n-html data-i18n="featuresOutreach.hero.crumb">Auto Outreach</span></p>
        <h1 class="h2-sec" data-i18n-html data-i18n="featuresOutreach.hero.title">Operations workers<br /><em class="it">at scale.</em></h1>
        <p class="copy-lg mx-auto" data-i18n="featuresOutreach.hero.sub">Workers write one message per recipient using fresh research and persistent memory. Batch-generate drafts, review side effects, then export or sync approved updates.</p>
      </div>

      <!-- How it works -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="featuresOutreach.steps.badge">How it works</p>
        <h2 class="h3-sec" data-i18n="featuresOutreach.steps.title">Three steps to pipeline</h2>
      </div>
      <div class="steps-grid">
        <div class="step"><div class="step-number">01</div><h3 data-i18n="featuresOutreach.steps.0.title">Collect</h3><p data-i18n="featuresOutreach.steps.0.desc">A configured contact workflow can provide evidence and context such as role, company, recent activity, or technical signals for review.</p></div>
        <div class="step-connector">→</div>
        <div class="step"><div class="step-number">02</div><h3 data-i18n="featuresOutreach.steps.1.title">Compose</h3><p data-i18n="featuresOutreach.steps.1.desc">The LLM writes one message per recipient using that context — no fill-in-the-blanks templates.</p></div>
        <div class="step-connector">→</div>
        <div class="step"><div class="step-number">03</div><h3 data-i18n="featuresOutreach.steps.2.title">Review &amp; export</h3><p data-i18n="featuresOutreach.steps.2.desc">Approval flow gates side effects, then export a deliverable or prepare an approved CRM handoff.</p></div>
      </div>

      <!-- Channels -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="featuresOutreach.channels.badge">Templates</p>
        <h2 class="h3-sec" data-i18n="featuresOutreach.channels.title">Outreach that fits the channel</h2>
      </div>
      <div class="cap-grid">
        {channels.map((c, i) => (
          <div class="cap-card">
            <h3 data-i18n={'featuresOutreach.channels.' + i + '.title'}>{c.t}</h3>
            <p data-i18n={'featuresOutreach.channels.' + i + '.desc'}>{c.d}</p>
          </div>
        ))}
      </div>

      <!-- Personalization -->
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="featuresOutreach.pers.badge">Personalization</p>
          <h2 class="h3-sec" data-i18n="featuresOutreach.pers.title">Every message is unique</h2>
          <p class="copy-lg" data-i18n="featuresOutreach.pers.desc">Messages reference what the agent actually found — a recent post, a hiring round, a tech migration. With semantic memory, repeat outreach remembers past context instead of starting from zero.</p>
        </div>
        <div class="code-card">
          <pre><code>Subject: Acme's Series B → infra hiring

Hi Jane — saw Acme just closed the Series B
and opened 6 platform roles. We helped
Globex cut lead-research time from hours
to minutes while scaling their SDR team…</code></pre>
        </div>
      </div>

      <!-- CRM -->
      <div class="feat feat-reverse">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="featuresOutreach.crm.badge">CRM integration</p>
          <h2 class="h3-sec" data-i18n="featuresOutreach.crm.title">Push to pipeline, not spreadsheets</h2>
          <p class="copy-lg" data-i18n="featuresOutreach.crm.desc">When a supported CRM adapter is configured, approved contacts can be synced with deduplication by <code>crm_id</code>. Availability and field mapping depend on your deployment.</p>
          <div class="more-links">
            <a href="/ops" class="btn btn-secondary" data-i18n="featuresOutreach.crm.approval">Approval flow &amp; ops</a>
            <a href="/#cta" class="btn btn-primary" data-i18n="featuresOutreach.crm.start">Get started</a>
          </div>
        </div>
        <div class="api-grid">
          <div class="api-card"><div class="api-name">CSV / vCard / Excel</div><p data-i18n="featuresOutreach.crm.csv">Universal exports for any stack.</p></div>
          <div class="api-card"><div class="api-name">PDF / HTML / DOCX</div><p data-i18n="featuresOutreach.crm.pdf">Shareable reports with findings.</p></div>
          <div class="api-card"><div class="api-name">Webhook / Telegram / email</div><p data-i18n="featuresOutreach.crm.webhook">Notifications when batches finish.</p></div>
          <div class="api-card"><div class="api-name">Approval flow</div><p data-i18n="featuresOutreach.crm.flow">Side effects wait for an explicit yes.</p></div>
        </div>
      </div>

      <div class="cta-strip">
        <h2 data-i18n="featuresOutreach.cta.title">Automate your outreach</h2>
        <a href="/#cta" class="btn btn-primary" data-i18n="featuresOutreach.cta.start">Get started →</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .ao-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .eyebrow .crumb { color: var(--grey-500); }
  .eyebrow .crumb:hover { color: var(--grey-900); }
  .h3-sec { font-size: clamp(20px, 2.4vw, 34px); font-weight: 500; letter-spacing: -0.02em; margin: 12px 0 0; }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .ao-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .ao-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .ao-hero .copy-lg { margin-top: 20px; }

  .sec-head { max-width: 720px; margin: 60px 0 28px; }

  .steps-grid { display: flex; align-items: stretch; gap: 16px; }
  .step { flex: 1; background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 28px; }
  .step-number { font-family: var(--font-mono); font-size: 32px; font-weight: 500; color: var(--grey-300); display: block; margin-bottom: 14px; }
  .step h3 { font-size: 18px; font-weight: 600; margin-bottom: 8px; }
  .step p { font-size: 14px; color: var(--grey-600); line-height: 1.55; }
  .step-connector { color: var(--grey-400); font-size: 1.4rem; align-self: center; }
  @media (max-width: 900px) { .steps-grid { flex-direction: column; } .step-connector { transform: rotate(90deg); text-align: center; } }

  .cap-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .cap-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; }
  .cap-card h3 { font-size: 16px; font-weight: 600; margin-bottom: 8px; }
  .cap-card p { color: var(--grey-600); font-size: 14px; line-height: 1.55; }
  @media (max-width: 900px) { .cap-grid { grid-template-columns: 1fr; } }

  .feat { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding: 48px 0; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  @media (max-width: 900px) { .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; direction: ltr; } }

  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--bg-dark); overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 13px; line-height: 1.7; color: var(--grey-100); white-space: pre; }

  .more-links { display: flex; gap: 10px; margin-top: 24px; }

  .api-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; background: var(--grey-300); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--grey-300); }
  .api-card { background: var(--bg-card); padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .api-card .api-name { font-family: var(--font-mono); font-weight: 600; font-size: 13px; }
  .api-card p { color: var(--grey-600); font-size: 13px; line-height: 1.5; }

  .cta-strip { margin-top: 64px; background: var(--bg-dark); border-radius: var(--radius-xl); padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta-strip h2 { color: #fff; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; }
  .cta-strip .btn-primary { background: var(--bg-card); color: var(--grey-900); }
</style>
