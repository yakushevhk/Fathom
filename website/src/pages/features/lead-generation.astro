---
import Layout from '../../layouts/Layout.astro';

const stages = [
  { n: '01', t: 'Find', d: 'find_leads, search_business_directory, search_social and search_news locate candidates across the open web.' },
  { n: '02', t: 'Extract', d: 'extract_contacts and parse_corporate_site pull emails, phones, socials, persons and companies from pages.' },
  { n: '03', t: 'Verify', d: 'verify_email (MX + syntax), verify_phone, verify_social_profile and suggest_emails discard invalid entries.' },
  { n: '04', t: 'Deduplicate', d: 'save_contacts merges across sources with normalization — no double records, ever.' },
  { n: '05', t: 'Push', d: 'Synced to SQLite/PostgreSQL and straight into amoCRM, Bitrix24 or HubSpot — dedup by crm_id.' },
];

const dataPoints = ['Work emails', 'Phone numbers', 'Social profiles (LinkedIn, X, Telegram…)', 'Persons & roles', 'Companies & structure', 'Locations', 'Technologies & signals'];
---

<Layout title="Lead Generation — Fathom Research">
  <main class="lg-page">
    <div class="container">
      <div class="lg-hero">
        <p class="eyebrow"><a href="/features" class="crumb">Features</a> / <span data-i18n-html data-i18n="featuresLeadgen.hero.crumb">Lead Generation</span></p>
        <h1 class="h2-sec" data-i18n-html data-i18n="featuresLeadgen.hero.title">From a query to a<br />verified lead list.</h1>
        <p class="copy-lg mx-auto" data-i18n="featuresLeadgen.hero.sub">An automated OSINT pipeline: agents find contacts across the web, verify every data point, deduplicate across sources and push straight to your CRM.</p>
      </div>

      <!-- Pipeline -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="featuresLeadgen.pipeline.badge">Pipeline</p>
        <h2 class="h3-sec" data-i18n="featuresLeadgen.pipeline.title">Five-stage lead pipeline</h2>
      </div>
      <div class="stages">
        {stages.map((s, i) => (
          <div class="stage">
            <div class="stage-num">{s.n}</div>
            <h3 data-i18n={'featuresLeadgen.stage.' + i + '.title'}>{s.t}</h3>
            <p data-i18n-html data-i18n={'featuresLeadgen.stage.' + i + '.desc'}>{s.d}</p>
          </div>
        ))}
      </div>

      <!-- Data points -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="featuresLeadgen.data.badge">Data points</p>
        <h2 class="h3-sec" data-i18n="featuresLeadgen.data.title">What Fathom extracts for you</h2>
      </div>
      <div class="chips">
        {dataPoints.map((d, i) => <span class="chip" data-i18n={'featuresLeadgen.dataPoint.' + i + '.name'}>{d}</span>)}
      </div>

      <!-- Verification -->
      <div class="feat">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="featuresLeadgen.verify.badge">Verification</p>
          <h2 class="h3-sec" data-i18n="featuresLeadgen.verify.title">Every contact is verified</h2>
          <p class="copy-lg" data-i18n="featuresLeadgen.verify.desc">Bounced emails and wrong numbers waste outreach budget. Fathom MX-validates every email, format-checks every phone and confirms social profiles exist before anything is saved.</p>
        </div>
        <div class="mini-table-wrap">
          <table class="mini-table">
            <thead><tr><th data-i18n="featuresLeadgen.table.tool">Tool</th><th data-i18n="featuresLeadgen.table.check">Check</th></tr></thead>
            <tbody>
              <tr><td>verify_email</td><td data-i18n-html data-i18n="featuresLeadgen.table.verify_email">MX records + syntax + role filter · confidence 0.85</td></tr>
              <tr><td>suggest_emails</td><td data-i18n="featuresLeadgen.table.suggest_emails">up to 9 candidates from name permutations + domain pattern</td></tr>
              <tr><td>deobfuscate</td><td data-i18n-html data-i18n="featuresLeadgen.table.deobfuscate">"name [at] domain [dot] com" → real address · 0.95 vs 0.70 raw</td></tr>
              <tr><td>verify_phone</td><td data-i18n-html data-i18n="featuresLeadgen.table.verify_phone">"+7 (495) 710-75-80" → +74957107580 · E.164, RU, landline</td></tr>
              <tr><td>verify_social_profile</td><td data-i18n="featuresLeadgen.table.verify_social">profile existence check</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Dedup -->
      <div class="feat feat-reverse">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="featuresLeadgen.dedup.badge">Deduplication</p>
          <h2 class="h3-sec" data-i18n="featuresLeadgen.dedup.title">Smart merge across sources</h2>
          <p class="copy-lg" data-i18n="featuresLeadgen.dedup.desc">The same person appears on LinkedIn, corporate sites and news. save_contacts normalizes emails and phones, merges records and keeps one canonical contact — re-runs never create duplicates.</p>
        </div>
        <div class="code-card">
          <pre><code>{`# deterministic autosave during runs
save_contacts {
  emails:  ["ceo@acme.com"],
  phones:  ["+1 415 …"],
  person:  { name: "J. Doe", role: "CEO" },
  company: "Acme Corp"
}
# → dedup by email/phone, merge fields`}</code></pre>
        </div>
      </div>

      <!-- CRM -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="featuresLeadgen.crm.badge">CRM sync</p>
        <h2 class="h3-sec" data-i18n="featuresLeadgen.crm.title">One-click push to your CRM</h2>
      </div>
      <div class="api-grid api-grid--3">
        <div class="api-card"><div class="api-name">amoCRM</div><p data-i18n="featuresLeadgen.crm.amocrm">Contacts and companies pushed with dedup by crm_id — no duplicates on repeated pushes.</p></div>
        <div class="api-card"><div class="api-name">Bitrix24</div><p data-i18n="featuresLeadgen.crm.bitrix">Leads synced into Bitrix24 with the same dedup guarantees.</p></div>
        <div class="api-card"><div class="api-name">HubSpot</div><p data-i18n="featuresLeadgen.crm.hubspot">Contacts created or updated idempotently from verified data.</p></div>
      </div>

      <!-- Results -->
      <div class="sec-head center">
        <p class="eyebrow" data-i18n="featuresLeadgen.results.badge">Results</p>
        <h2 class="h3-sec" data-i18n="featuresLeadgen.results.title">What you get in 3 minutes</h2>
      </div>
      <div class="bench-strip">
        <div class="bench-card"><div class="metric">47</div><div class="cap" data-i18n="featuresLeadgen.results.0">contacts per typical query</div></div>
        <div class="bench-card"><div class="metric">12+</div><div class="cap" data-i18n-html data-i18n="featuresLeadgen.results.1">verified emails &amp; phones</div></div>
        <div class="bench-card"><div class="metric">0</div><div class="cap" data-i18n="featuresLeadgen.results.2">duplicates after merge</div></div>
        <div class="bench-card"><div class="metric">3</div><div class="cap" data-i18n="featuresLeadgen.results.3">CRMs supported out of the box</div></div>
      </div>

      <div class="cta-strip">
        <h2 data-i18n="featuresLeadgen.cta.title">Generate your first lead list</h2>
        <a href="/#cta" class="btn btn-primary" data-i18n="featuresLeadgen.cta.start">Get started →</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .lg-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .eyebrow .crumb { color: var(--grey-500); }
  .eyebrow .crumb:hover { color: var(--grey-900); }
  .h3-sec { font-size: clamp(20px, 2.4vw, 34px); font-weight: 500; letter-spacing: -0.02em; margin: 12px 0 0; }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .lg-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .lg-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .lg-hero .copy-lg { margin-top: 20px; }

  .sec-head { max-width: 720px; margin: 60px 0 28px; }
  .sec-head.center { margin-left: auto; margin-right: auto; text-align: center; }

  .stages { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .stage { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 20px; position: relative; }
  .stage-num { font-family: var(--font-mono); font-size: 12px; color: var(--grey-400); margin-bottom: 10px; display: block; }
  .stage h3 { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
  .stage p { font-size: 13px; color: var(--grey-600); line-height: 1.55; }
  @media (max-width: 1000px) { .stages { grid-template-columns: repeat(2, 1fr); } }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-family: var(--font-mono); font-size: 13px; background: var(--bg-card); border: 1px solid var(--grey-200); padding: 8px 14px; border-radius: 100px; color: var(--grey-700); }

  .feat { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding: 48px 0; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  @media (max-width: 900px) { .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; direction: ltr; } }

  .mini-table-wrap { border: 1px solid var(--grey-200); border-radius: 8px; overflow: auto; background: var(--bg-card); }
  .mini-table { width: 100%; border-collapse: collapse; font-size: 13px; font-family: var(--font-mono); }
  .mini-table th { font-size: 10px; text-transform: uppercase; letter-spacing: .6px; color: var(--grey-600); text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--grey-200); background: var(--grey-50); }
  .mini-table td { padding: 10px 14px; border-bottom: 1px solid var(--grey-100); color: var(--grey-800); }
  .mini-table tr:last-child td { border-bottom: none; }

  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--bg-dark); overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 13px; line-height: 1.7; color: var(--grey-100); white-space: pre; }

  .api-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: var(--grey-300); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--grey-300); }
  .api-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .api-card { background: var(--bg-card); padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .api-card .api-name { font-family: var(--font-mono); font-weight: 600; font-size: 14px; }
  .api-card p { color: var(--grey-600); font-size: 14px; line-height: 1.55; }
  @media (max-width: 800px) { .api-grid, .api-grid--3 { grid-template-columns: 1fr; } }

  .bench-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .bench-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; }
  .bench-card .metric { font-size: 40px; font-weight: 500; letter-spacing: -0.02em; line-height: 1; }
  .bench-card .cap { font-family: var(--font-mono); font-size: 12px; color: var(--grey-600); margin-top: 10px; line-height: 1.5; }
  @media (max-width: 900px) { .bench-strip { grid-template-columns: repeat(2, 1fr); } }

  .cta-strip { margin-top: 64px; background: var(--bg-dark); border-radius: var(--radius-xl); padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta-strip h2 { color: #fff; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; }
  .cta-strip .btn-primary { background: var(--bg-card); color: var(--grey-900); }
</style>
