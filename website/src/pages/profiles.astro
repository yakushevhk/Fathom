---
import Layout from '../layouts/Layout.astro';

const profiles = [
  { key: 'hunter', name: 'hunter', tag: 'Lead harvesting', d: 'Aggressive contact extraction — maximizes verified contacts. Extracts name, role, company, email, phone. Always runs extract_contacts, enrich_entities, save_contacts. Spawns up to 6 parallel agents.' },
  { key: 'analyst', name: 'analyst', tag: 'Deep research', d: 'Deep research with cross-checking, no side effects. Every claim needs a source URL; conflicting sources get both cited. Denies save_contacts and git_push tools.' },
  { key: 'validator', name: 'validator', tag: 'Verify & enrich', d: 'Works through contact lists one by one — verify_email, verify_phone, verify_social. Enriches missing fields from primary sources. Denies spawn_agent to stay focused.' },
];
---

<Layout title="Profiles & Personas — Fathom">
  <main class="profiles-page">
    <div class="container">
      <div class="profiles-hero">
        <p class="eyebrow" data-i18n="profilesPage.hero.badge">Profiles & Personas</p>
        <h1 class="h2-sec" data-i18n-html data-i18n="profilesPage.hero.title">One agent,<br />many personas.</h1>
        <p class="copy-lg mx-auto" data-i18n="profilesPage.hero.sub">Ready-made profiles tune the entire agent fleet for a class of tasks — model, temperature, depth, tool sets and behavioral prompts, all in one TOML overlay.</p>
      </div>

      <!-- Built-in profiles -->
      <div class="sec-head center reveal">
        <p class="eyebrow" data-i18n="profilesPage.builtin.badge">Built-in profiles</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="profilesPage.builtin.title">Three battle-tested presets</h2>
        <p class="copy-lg mx-auto" data-i18n="profilesPage.builtin.sub">Each profile injects a specialized system prompt and overrides agent parameters — no config file needed.</p>
      </div>

      <div class="profiles-grid">
        {profiles.map((p) => (
          <div class="profiles-card">
            <div class="profiles-name-row">
              <code class="profiles-name" data-i18n={'profilesPage.builtin.' + p.key + '.name'}>{p.name}</code>
              <span class="profiles-tag" data-i18n={'profilesPage.builtin.' + p.key + '.tag'}>{p.tag}</span>
            </div>
            <p data-i18n={'profilesPage.builtin.' + p.key + '.d'}>{p.d}</p>
          </div>
        ))}
      </div>

      <!-- Custom profiles -->
      <div class="sec-head center reveal" style="margin-top:64px">
        <p class="eyebrow" data-i18n="profilesPage.custom.badge">Custom profiles</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="profilesPage.custom.title">Your rules, your TOML</h2>
        <p class="copy-lg mx-auto" data-i18n-html data-i18n="profilesPage.custom.sub">Create a TOML file in <code class="ic">~/.fathom/profiles/&lt;name&gt;.toml</code> — override model, fast_model, temperature, max_depth, max_agents, max_iterations, timeout_seconds, replan_rounds, and deny_tools. User files take priority over built-in presets.</p>
      </div>

      <div class="code-card" style="max-width:640px; margin:0 auto;">
        <pre><code># ~/.fathom/profiles/my-profile.toml

model = "deepseek-chat"
fast_model = "deepseek-chat"
temperature = 0.3
max_depth = 3
max_agents = 8
max_iterations = 50
timeout_seconds = 600
replan_rounds = 2
deny_tools = ["git_push"]</code></pre>
      </div>

      <!-- CLI usage -->
      <div class="sec-head center reveal" style="margin-top:64px">
        <p class="eyebrow" data-i18n="profilesPage.cli.badge">CLI usage</p>
        <h2 class="h2-sec" data-i18n-html data-i18n="profilesPage.cli.title">List, show, create, run</h2>
      </div>

      <div class="profiles-cli-grid">
        <div class="profiles-cli-card">
          <code>fathom profiles list</code>
          <p data-i18n="profilesPage.cli.list">List all available profiles</p>
        </div>
        <div class="profiles-cli-card">
          <code>fathom profiles show hunter</code>
          <p data-i18n="profilesPage.cli.show">Show profile details</p>
        </div>
        <div class="profiles-cli-card">
          <code>fathom profiles new my-profile</code>
          <p data-i18n="profilesPage.cli.create">Create from template</p>
        </div>
        <div class="profiles-cli-card">
          <code>fathom run --profile hunter "find leads at Acme"</code>
          <p data-i18n="profilesPage.cli.run">Run with a profile</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="profiles-cta">
        <div class="bench-card-lg">
          <h3 data-i18n="profilesPage.cta.title">Personalize your agent</h3>
          <p class="bench-sub" data-i18n="profilesPage.cta.sub">Read the full personalization guide — profiles, per-role models, tool deny lists and behavioral tuning.</p>
          <a href="/docs/personalization" class="btn btn-outline" data-i18n="profilesPage.cta.docs">Personalization docs</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .profiles-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .center { text-align: center; }

  .profiles-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .profiles-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .profiles-hero .copy-lg { margin-top: 20px; }

  .sec-head { max-width: 820px; margin: 0 auto 32px; padding: 0 24px; }
  .h2-sec { font-size: clamp(26px, 3.5vw, 48px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.08; margin-top: 12px; }

  .profiles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
  .profiles-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; transition: box-shadow .25s, transform .25s var(--ease-out), border-color .25s; }
  .profiles-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: var(--grey-400); }
  .profiles-name-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .profiles-name { font-family: var(--font-mono); font-weight: 700; font-size: 16px; background: var(--grey-100); padding: 4px 10px; border-radius: var(--radius-sm); }
  .profiles-tag { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--grey-500); border: 1px solid var(--grey-200); padding: 3px 8px; border-radius: var(--radius-sm); }
  .profiles-card p { color: var(--grey-600); font-size: 14px; line-height: 1.55; }

  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--grey-900); overflow: hidden; }
  .code-card pre { padding: 20px 24px; margin: 0; overflow-x: auto; }
  .code-card code { color: var(--grey-200); font-family: var(--font-mono); font-size: 13px; line-height: 1.7; white-space: pre; }
  .ic { font-family: var(--font-mono); font-size: 0.9em; background: var(--grey-100); padding: 2px 6px; border-radius: 4px; }

  .profiles-cli-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; max-width: 740px; margin: 0 auto; }
  .profiles-cli-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 20px; }
  .profiles-cli-card code { font-family: var(--font-mono); font-size: 13px; font-weight: 600; display: block; margin-bottom: 8px; color: var(--grey-900); word-break: break-all; }
  .profiles-cli-card p { color: var(--grey-600); font-size: 13px; line-height: 1.5; }

  .btn { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 13px; font-weight: 600; padding: 10px 20px; border-radius: var(--radius-sm); transition: all .15s; }
  .btn-outline { border: 1px solid var(--grey-300); color: var(--grey-800); }
  .btn-outline:hover { border-color: var(--grey-500); background: var(--grey-100); }

  .profiles-cta { max-width: 900px; margin: 48px auto 0; }
  .bench-card-lg { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 28px; }
  .bench-card-lg h3 { font-size: 22px; font-weight: 500; }
  .bench-sub { color: var(--grey-600); font-size: 14px; margin: 8px 0 18px; line-height: 1.6; }

  @media (max-width: 640px) {
    .profiles-cli-grid { grid-template-columns: 1fr; }
  }
</style>
