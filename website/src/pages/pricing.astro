---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Pricing & ROI Calculator — Fathom Autonomous AI Workers" description="Predictable self-hosted pricing and interactive ROI calculator for autonomous AI digital employees.">
  <main class="pricing-page">
    <PageHero cls="pricing-hero">
      <p class="eyebrow" data-i18n="pricingPage.hero.badge">Access &amp; Pricing</p>
      <h1 class="h2-sec" data-i18n-html data-i18n="pricingPage.hero.title">Remote AI workers <em class="it">on your team.</em></h1>
      <p class="copy-lg mx-auto" data-i18n="pricingPage.hero.sub">Fathom deploys on dedicated infrastructure for your team. Contact us for access — we'll set up a server with full runtime, API, dashboard, and memory.</p>
    </PageHero>

    <div class="container">
      <!-- Contact Card -->
      <div class="contact-card">
        <div class="contact-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h2 data-i18n="pricingPage.contact.title">Request Server Access</h2>
        <p class="contact-body" data-i18n="pricingPage.contact.body">
          We provision dedicated high-performance servers for your team with full access to the Fathom runtime, CLI, TUI, REST API, web dashboard, and unlimited neural compute.
        </p>
        <a href="mailto:hello@fathom.uz" class="contact-btn">hello@fathom.uz</a>
        <p class="contact-footnote" data-i18n="pricingPage.contact.footnote">We'll respond within 24 hours with server credentials and onboarding documentation.</p>
      </div>

      <!-- Interactive ROI & Savings Calculator -->
      <section class="section" id="roi-calculator" style="margin: 60px 0;">
        <div class="sec-head center">
          <p class="eyebrow"><span data-i18n="pricingCalc.sectionTitle">Interactive Financial Modeling</span></p>
          <h2 class="h3-sec" data-i18n="pricingCalc.sectionSub">Workforce ROI &amp; TCO Calculator</h2>
          <p class="copy-lg mx-auto" data-i18n="pricingCalc.sectionDesc">Calculate your annual savings from deploying autonomous Fathom digital workers versus traditional headcount and fragmented SaaS subscriptions.</p>
        </div>

        <div class="calculator-card">
          <div class="calc-inputs">
            <div class="calc-group">
              <div class="calc-label-row">
                <label for="headcount" data-i18n="pricingCalc.headcountLabel">Routine Headcount (SDRs, Researchers, Admins):</label>
                <span id="headcount-val" class="calc-val-badge">3 people</span>
              </div>
              <input type="range" id="headcount" min="1" max="20" value="3" class="calc-slider" />
            </div>

            <div class="calc-group">
              <div class="calc-label-row">
                <label for="salary" data-i18n="pricingCalc.salaryLabel">Avg Monthly Salary per Employee ($):</label>
                <span id="salary-val" class="calc-val-badge">$4,500 / mo</span>
              </div>
              <input type="range" id="salary" min="1500" max="12000" step="500" value="4500" class="calc-slider" />
            </div>

            <div class="calc-group">
              <div class="calc-label-row">
                <label for="saas" data-i18n="pricingCalc.saasLabel">Monthly SaaS Spend (ZoomInfo, Apollo, DBs, Scraping):</label>
                <span id="saas-val" class="calc-val-badge">$1,200 / mo</span>
              </div>
              <input type="range" id="saas" min="200" max="8000" step="200" value="1200" class="calc-slider" />
            </div>
          </div>

          <div class="calc-results">
            <div class="res-block highlight">
              <div class="res-title" data-i18n="pricingCalc.savingsLabel">Estimated Annual Net Savings</div>
              <div id="res-savings" class="res-amount">$162,400</div>
              <div class="res-sub" data-i18n="pricingCalc.basisLabel">Based on 91% process automation &amp; SaaS consolidation</div>
            </div>

            <div class="res-grid">
              <div class="res-mini">
                <div class="res-mini-lbl" data-i18n="pricingCalc.tradLabel">Traditional Annual Cost</div>
                <div id="res-trad" class="res-mini-val">$176,400 / yr</div>
              </div>
              <div class="res-mini">
                <div class="res-mini-lbl" data-i18n="pricingCalc.fathomLabel">Fathom Fleet Cost</div>
                <div id="res-fathom" class="res-mini-val">$14,000 / yr</div>
              </div>
              <div class="res-mini">
                <div class="res-mini-lbl" data-i18n="pricingCalc.paybackLabel">Estimated ROI Payback</div>
                <div id="res-payback" class="res-mini-val">12 Days</div>
              </div>
              <div class="res-mini">
                <div class="res-mini-lbl" data-i18n="pricingCalc.capacityLabel">Capacity Increase</div>
                <div class="res-mini-val" data-i18n="pricingCalc.fasterLabel">8.5× Faster</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- What's Included -->
      <div class="sec-head" id="includes">
        <p class="eyebrow" data-i18n="pricingPage.includes.badge">What's included</p>
        <h2 class="h3-sec" data-i18n="pricingPage.includes.title">Full worker platform</h2>
      </div>
      <div class="includes-grid">
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.1.name">Autonomous workers</div>
          <p data-i18n="pricingPage.includes.1.d">Research, outreach, code, computer use, and scheduled operations — one runtime, every capability.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.2.name">Web dashboard &amp; API</div>
          <p data-i18n="pricingPage.includes.2.d">Full control plane with REST API, SSE streaming, AG-UI compatibility, and the embedded web dashboard.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.3.name">Durable memory</div>
          <p data-i18n="pricingPage.includes.3.d">Hybrid vector + BM25 semantic memory, entity graph, and append-only knowledge that persists across sessions.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.4.name">Governance &amp; approvals</div>
          <p data-i18n="pricingPage.includes.4.d">Approval gates, policy hooks, secret scanning, and audit trails keep every side effect reviewable.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.5.name">Integrations</div>
          <p data-i18n="pricingPage.includes.5.d">CRM push (amoCRM, Bitrix24, HubSpot), MCP, notifications (webhook, email, Telegram), and search backends.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.6.name">Support</div>
          <p data-i18n="pricingPage.includes.6.d">Server provisioning, configuration assistance, and ongoing operational support from the Fathom team.</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-strip">
        <div class="cta-copy">
          <h3 data-i18n="pricingPage.cta.title">Ready to deploy workers for your team?</h3>
          <p data-i18n="pricingPage.cta.sub">Email us and we'll get you set up with a dedicated server environment.</p>
        </div>
        <div class="cta-actions">
          <a href="mailto:hello@fathom.uz" class="cta-btn" data-i18n="pricingPage.cta.access">Request access →</a>
          <a href="/whitepaper" class="cta-link" data-i18n="pricingCalc.readWhitepaper">Read Whitepaper</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
  function updateCalc() {
    const headcount = parseInt(document.getElementById('headcount').value, 10);
    const salary = parseInt(document.getElementById('salary').value, 10);
    const saas = parseInt(document.getElementById('saas').value, 10);

    const lang = document.documentElement.lang || 'en';
    const personLabel = lang === 'ru' ? 'чел.' : 'person';
    const peopleLabel = lang === 'ru' ? 'чел.' : 'people';
    const perMo = lang === 'ru' ? ' / мес' : ' / mo';
    const perYr = lang === 'ru' ? ' / год' : ' / yr';
    const daysLabel = lang === 'ru' ? 'дн.' : 'Days';

    document.getElementById('headcount-val').innerText = headcount + (headcount === 1 ? ' ' + personLabel : ' ' + peopleLabel);
    document.getElementById('salary-val').innerText = '$' + salary.toLocaleString() + perMo;
    document.getElementById('saas-val').innerText = '$' + saas.toLocaleString() + perMo;

    const tradAnnual = (headcount * salary * 12) + (saas * 12);
    const fathomAnnual = 1200 + (headcount * 300 * 12);
    const savings = Math.max(0, tradAnnual - fathomAnnual);
    const paybackDays = Math.max(4, Math.round((fathomAnnual / tradAnnual) * 365 / headcount));

    document.getElementById('res-savings').innerText = '$' + savings.toLocaleString();
    document.getElementById('res-trad').innerText = '$' + tradAnnual.toLocaleString() + perYr;
    document.getElementById('res-fathom').innerText = '$' + fathomAnnual.toLocaleString() + perYr;
    document.getElementById('res-payback').innerText = paybackDays + ' ' + daysLabel;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const inputs = ['headcount', 'salary', 'saas'];
    inputs.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('input', updateCalc);
    });
    updateCalc();
  });
</script>

<style>
  .pricing-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .h3-sec { font-size: clamp(20px, 2.4vw, 34px); font-weight: 500; letter-spacing: -0.02em; margin: 12px 0 16px; }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .pricing-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .pricing-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .pricing-hero .copy-lg { margin-top: 20px; }

  .contact-card {
    max-width: 640px; margin: 0 auto; text-align: center;
    background: var(--bg-card); border: 1px solid var(--grey-200);
    border-radius: var(--radius-xl); padding: 56px 40px;
  }
  .contact-icon { color: var(--grey-500); margin-bottom: 20px; }
  .contact-card h2 { font-size: clamp(26px, 3.4vw, 38px); font-weight: 500; letter-spacing: -0.025em; margin-bottom: 16px; }
  .contact-body { color: var(--grey-600); font-size: 16px; line-height: 1.6; max-width: 480px; margin: 0 auto 28px; }
  .contact-btn {
    display: inline-block; font-family: var(--font-mono); font-size: 18px; font-weight: 600;
    color: var(--grey-900); background: var(--grey-100); border: 1px solid var(--grey-300);
    padding: 14px 32px; border-radius: var(--radius-md); transition: all .2s;
  }
  .contact-btn:hover { background: var(--grey-900); color: var(--on-accent); border-color: var(--grey-900); }
  .contact-footnote { color: var(--grey-500); font-size: 13px; margin-top: 18px; }

  /* Calculator Styles */
  .calculator-card {
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 36px;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius-xl); padding: 40px; box-shadow: var(--shadow-lg);
  }
  .calc-inputs { display: flex; flex-direction: column; gap: 28px; justify-content: center; }
  .calc-group { display: flex; flex-direction: column; gap: 10px; }
  .calc-label-row { display: flex; justify-content: space-between; align-items: center; }
  .calc-label-row label { font-size: 0.92rem; font-weight: 600; color: var(--text-primary); }
  .calc-val-badge { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; color: var(--accent); background: var(--bg-secondary); padding: 4px 10px; border-radius: var(--radius-sm); }
  .calc-slider { width: 100%; height: 6px; border-radius: 3px; background: var(--grey-200); accent-color: var(--accent); cursor: pointer; }

  .calc-results {
    background: var(--bg-dark); color: var(--text-inverse);
    border-radius: var(--radius-lg); padding: 32px; display: flex;
    flex-direction: column; justify-content: space-between; gap: 24px;
  }
  .res-block.highlight { text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 20px; }
  .res-title { font-size: 0.85rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; color: #94a3b8; }
  .res-amount { font-size: 3rem; font-weight: 900; letter-spacing: -0.03em; color: #10b981; margin: 8px 0 4px; }
  .res-sub { font-size: 0.78rem; color: #64748b; }

  .res-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .res-mini { background: rgba(255, 255, 255, 0.05); padding: 14px; border-radius: var(--radius-sm); }
  .res-mini-lbl { font-size: 0.74rem; color: #94a3b8; margin-bottom: 4px; }
  .res-mini-val { font-size: 1rem; font-weight: 700; color: #ffffff; }

  .includes-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; margin-top: 24px; }
  .include-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; }
  .include-name { font-weight: 600; font-size: 16px; margin-bottom: 8px; }
  .include-card p { color: var(--grey-600); font-size: 14px; line-height: 1.55; }

  .cta-strip { display: flex; justify-content: space-between; align-items: center; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px 40px; margin-top: 60px; }
  .cta-copy h3 { font-size: 1.3rem; font-weight: 600; }
  .cta-copy p { font-size: 0.95rem; color: var(--text-secondary); margin-top: 4px; }
  .cta-actions { display: flex; gap: 14px; align-items: center; }
  .cta-btn { font-family: var(--font-mono); font-size: 0.9rem; font-weight: 600; color: var(--on-accent); background: var(--accent); padding: 10px 20px; border-radius: var(--radius-sm); text-decoration: none; }
  .cta-btn:hover { background: var(--accent-hover); }
  .cta-link { font-size: 0.9rem; color: var(--text-secondary); text-decoration: none; font-weight: 500; }

  @media (max-width: 900px) {
    .calculator-card { grid-template-columns: 1fr; padding: 24px; }
    .cta-strip { flex-direction: column; gap: 20px; text-align: center; }
  }
</style>
