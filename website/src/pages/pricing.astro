---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Pricing — Fathom">
  <main class="pricing-page">
    <PageHero cls="pricing-hero">
      <p class="eyebrow" data-i18n="pricingPage.hero.badge">Pricing</p>
      <h1 class="h2-sec" data-i18n-html data-i18n="pricingPage.hero.title">Remote AI workers <em class="it">on your team.</em></h1>
      <p class="copy-lg mx-auto" data-i18n="pricingPage.hero.sub">Fathom deploys on dedicated infrastructure for your team. Contact us for access — we'll set up a server with full runtime, API, dashboard, and memory.</p>
    </PageHero>
    <div class="container">

      <!-- Contact CTA -->
      <div class="contact-card">
        <div class="contact-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </div>
        <h2 data-i18n="pricingPage.contact.title">Request access</h2>
        <p class="contact-body" data-i18n="pricingPage.contact.body">
          We provision servers for your team with full access to the Fathom runtime, CLI, TUI, API, dashboard, and integrations. Email us to get started.
        </p>
        <a href="mailto:hello@fathom.uz" class="contact-btn">hello@fathom.uz</a>
        <p class="contact-footnote" data-i18n="pricingPage.contact.footnote">We'll respond within 24 hours with server credentials and documentation.</p>
      </div>

      <!-- What you get -->
      <div class="sec-head" id="includes">
        <p class="eyebrow" data-i18n="pricingPage.includes.badge">What's included</p>
        <h2 class="h3-sec" data-i18n="pricingPage.includes.title">Full worker platform</h2>
      </div>
      <div class="includes-grid">
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.1.name">Autonomous workers</div>
          <p data-i18n="pricingPage.includes.1.d">Research, outreach, code, computer use, and scheduled operations — one runtime, every capability.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.2.name">Web dashboard &amp; API</div>
          <p data-i18n="pricingPage.includes.2.d">Full control plane with REST API, SSE streaming, AG-UI compatibility, and the embedded web dashboard.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.3.name">Durable memory</div>
          <p data-i18n="pricingPage.includes.3.d">Hybrid vector + BM25 semantic memory, entity graph, and append-only knowledge that persists across sessions.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.4.name">Governance &amp; approvals</div>
          <p data-i18n="pricingPage.includes.4.d">Approval gates, policy hooks, secret scanning, and audit trails keep every side effect reviewable.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.5.name">Integrations</div>
          <p data-i18n="pricingPage.includes.5.d">CRM push (amoCRM, Bitrix24, HubSpot), MCP, notifications (webhook, email, Telegram), and search backends.</p>
        </div>
        <div class="include-card">
          <div class="include-name" data-i18n="pricingPage.includes.6.name">Support</div>
          <p data-i18n="pricingPage.includes.6.d">Server provisioning, configuration assistance, and ongoing operational support from the Fathom team.</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-strip">
        <div class="cta-copy">
          <h3 data-i18n="pricingPage.cta.title">Ready to deploy workers for your team?</h3>
          <p data-i18n="pricingPage.cta.sub">Email us and we'll get you set up with a dedicated server environment.</p>
        </div>
        <div class="cta-actions">
          <a href="mailto:hello@fathom.uz" class="cta-btn" data-i18n="pricingPage.cta.access">Request access →</a>
          <a href="/docs" class="cta-link" data-i18n="pricingPage.cta.docs">Read the docs</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .pricing-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .h3-sec { font-size: clamp(20px, 2.4vw, 34px); font-weight: 500; letter-spacing: -0.02em; margin: 12px 0 16px; }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .pricing-hero { max-width: 820px; margin: 0 auto 48px; text-align: center; padding: 0 24px; }
  .pricing-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .pricing-hero .copy-lg { margin-top: 20px; }

  .contact-card {
    max-width: 640px; margin: 0 auto; text-align: center;
    background: var(--bg-card); border: 1px solid var(--grey-200);
    border-radius: var(--radius-xl); padding: 56px 40px;
  }
  .contact-icon { color: var(--grey-500); margin-bottom: 20px; }
  .contact-card h2 { font-size: clamp(26px, 3.4vw, 38px); font-weight: 500; letter-spacing: -0.025em; margin-bottom: 16px; }
  .contact-body { color: var(--grey-600); font-size: 16px; line-height: 1.6; max-width: 480px; margin: 0 auto 28px; }
  .contact-btn {
    display: inline-block; font-family: var(--font-mono); font-size: 18px; font-weight: 600;
    color: var(--grey-900); background: var(--grey-100); border: 1px solid var(--grey-300);
    padding: 14px 32px; border-radius: var(--radius-md); transition: all .2s;
  }
  .contact-btn:hover { background: var(--grey-900); color: var(--on-accent); border-color: var(--grey-900); }
  .contact-footnote { color: var(--grey-500); font-size: 13px; margin-top: 18px; }

  .sec-head { max-width: 720px; margin: 56px 0 24px; }

  .includes-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--grey-300); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--grey-300); }
  .include-card { background: var(--bg-primary); padding: 26px 24px; display: flex; flex-direction: column; gap: 8px; transition: background .25s var(--ease-out); }
  .include-card:hover { background: var(--bg-card-hover); }
  .include-name { font-family: var(--font-mono); font-weight: 600; font-size: 15px; }
  .include-card p { color: var(--grey-600); font-size: 14px; line-height: 1.5; }
  @media (max-width: 800px) { .includes-grid { grid-template-columns: 1fr; } }

  .cta-strip { margin-top: 64px; background: var(--bg-dark); border-radius: var(--radius-xl); padding: 40px 44px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }
  .cta-copy h3 { color: #fff; font-size: 24px; font-weight: 500; letter-spacing: -0.02em; }
  .cta-copy p { color: var(--grey-500); font-size: 14.5px; line-height: 1.6; margin-top: 8px; max-width: 480px; }
  .cta-actions { display: flex; align-items: center; gap: 20px; flex-shrink: 0; }
  .cta-btn { background: var(--bg-card); color: var(--grey-900); font-weight: 600; font-size: 15px; padding: 13px 26px; border-radius: var(--radius-md); white-space: nowrap; transition: transform var(--duration) var(--ease-out), box-shadow var(--duration); }
  .cta-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 30px -12px rgba(255, 255, 255, 0.35); }
  .cta-link { color: var(--grey-400); font-size: 14px; font-weight: 500; white-space: nowrap; }
  .cta-link:hover { color: #fff; }
  @media (max-width: 800px) { .cta-strip { flex-direction: column; align-items: flex-start; padding: 32px 28px; } }
</style>