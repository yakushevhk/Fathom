---
import AgentPage from '../../components/AgentPage.astro';

const crew = [
  { name: 'Researcher', href: '/agents/researcher' },
  { name: 'Searching', href: '/agents/searching' },
  { name: 'Extracting', href: '/agents/extracting', current: true },
  { name: 'Structuring', href: '/agents/structuring' },
  { name: 'Cleaning', href: '/agents/cleaning' },
  { name: 'Memoring', href: '/agents/memoring' },
  { name: 'Outreach', href: '/agents/outreach' },
];

const caps = [
  { tool: 'extract_contacts', name: 'Everything in one pass', d: 'Emails, phones, social profiles, persons and companies from text, HTML or a URL — each item carrying a confidence score (0.0–1.0) and a source label: text, mailto link, tel link, html:alt.' },
  { tool: 'deobfuscation', name: 'Anti-scraping defeated', d: '"name [at] domain [dot] com", (at), {at}, HTML entities &#64; / &#46; and even word forms like "bob at acme dot com" are reconstructed into real addresses — tagged 0.70 confidence vs 0.95 for plain ones.' },
  { tool: 'parse_corporate_site', name: 'Company sites, decoded', d: 'Fetches the homepage, locates contact / team / about pages by path hints, reads Schema.org JSON-LD (Organization name, description, size) and harvests team member cards.' },
  { tool: 'parse_html', name: 'Fast structured parsing', d: 'CSS-selector extraction in five modes — texts, html, attr, links, tables. The same parser turns pages, exports, and documents into structured inputs for downstream workers.' },
  { tool: 'extract_json', name: 'Structured API inputs', d: 'Dot-path queries over JSON: data.items.0.name for deep access, results[*].email to iterate every element. REST responses and exports become inputs for any worker.' },
  { tool: 'analyze_image', name: 'Contacts inside pictures', d: 'A vision model OCRs screenshots, banners and rendered images; img alt/title attributes are scanned too. Emails hidden from plain-text scrapers still surface.' },
];

const flow = [
  { t: 'Ingest', d: 'Text, HTML or a URL. Fetches run behind an SSRF guard with per-hop redirect validation; the document is parsed once and reused by every extractor.' },
  { t: 'Mine', d: 'Deterministic regex passes sweep visible text, mailto:/tel: links, alt/title attributes and raw markup — JSON-LD blocks included.' },
  { t: 'Deobfuscate', d: '[at]/(at)/{at}/&#64; tokens and word-form addresses are reconstructed; asset TLDs like .png and .woff2 are rejected as fake emails.' },
  { t: 'Normalize', d: 'Phones go to E.164 via libphonenumber with region fallback; socials are keyed by platform + handle. Duplicates drop — the highest confidence survives.' },
  { t: 'Entities', d: 'Optional LLM pass returns strict JSON at temperature 0.0 with injection guards. Deterministic selectors run first when a page exposes recognizable cards.' },
  { t: 'Emit', d: 'Structured contacts with confidence and provenance flow on — and the runtime autosaves them to the contact DB before the model can move on.' },
];

const hood = [
  ['Email confidence ladder', 'mailto link 0.98 · plain text 0.95 · raw HTML/JSON-LD 0.90 · obfuscated 0.70'],
  ['Email plausibility', 'local part ≤ 64 chars, total ≤ 254, asset TLDs rejected (png, jpg, svg, woff2, mp4, pdf…)'],
  ['Obfuscation forms', '[at] (at) {at} &#64; and [dot] (dot) {.} &#46; · word forms need whitespace, so prose like "look at this" never matches'],
  ['Phone candidates', '7–15 digits · dates, IPs and round figures rejected · E.164 via libphonenumber · regions tried RU → US → DE → GB'],
  ['Phone confidence', '+-prefixed valid 0.9 · local valid 0.8 · tel: link 0.98 · invalid parse 0.35'],
  ['Social profiles', 'LinkedIn, X/Twitter, Instagram, Telegram, Facebook · reserved paths filtered · @handles read a ±60-char context window'],
  ['LLM entity pass', '12,000-char input cap · temperature 0.0 · strict JSON with code fences tolerated · prompt-injection defense on untrusted web text'],
  ['Team detection', '14 card selectors (.team-member, [class*="person-card"], [class*="team"] li…) · names ≤ 6 words and ≥ 70% letters'],
  ['Limits', 'parse_html caps each call at 500 items; selectors and output shapes stay explicit for predictable handoffs'],
];

const tools = ['extract_contacts', 'parse_html', 'extract_json', 'parse_corporate_site', 'analyze_image'];
---

<AgentPage
  pageTitle="Extraction Worker — Fathom"
  pageDesc="Turns pages, documents, and browser output into structured data with confidence scores and provenance."
  k="agents.extracting"
  index="03"
  title="Extracting"
  sub="The extraction worker turns pages, documents, and browser output into structured data — contacts when you need them, or clean inputs for any downstream workflow."
  mode="extracting"
  hue={25}
  crew={crew}
  caps={caps}
  capsTitle="Raw sources in, structured outputs out"
  flow={flow}
  flowTitle="Six passes over every source"
  hood={hood}
  hoodTitle="Regexes, thresholds and confidence"
  tools={tools}
  toolsTitle="The extraction toolbox"
  ctaTitle="From raw sources to worker-ready outputs"
  prev={{ href: '/agents/searching', label: '← Searching' }}
  middle={{ href: '/features/auto-outreach', label: 'Auto outreach' }}
  next={{ href: '/agents/structuring', label: 'Structuring →' }}
>
  <div slot="posttools" class="feat">
    <div class="feat-copy">
      <p class="feat-eyebrow" data-i18n="agents.extracting.feeds.eyebrow">Feeds downstream workers</p>
      <h2 data-i18n="agents.extracting.feeds.title">Structured output is reusable fuel</h2>
      <p class="feat-body" data-i18n="agents.extracting.feeds.body">Every extracted value leaves with a confidence score and source, so downstream workers know what to trust and what to verify. The runtime autosaves results as soon as the extraction tool returns — nothing evaporates when the session ends. Other workers can validate, write, or act on the same structured output.</p>
    </div>
    <div class="code-card">
      <pre><code>{`extract_contacts(url: "https://acme.io/team")
→ emails:  ann@acme.io        0.98  mailto link
→ phones:  +74957107580       0.90  RU · E.164
→ socials: linkedin.com/in/ann  0.9
→ persons: Ann Petrova — CTO @ Acme

[auto-persisted 4 contact(s): 4 new, 0 merged]

# → Structuring dedups into one record
# → Cleaning verifies quality and confidence
# → Operations prepares the next governed action`}</code></pre>
    </div>
  </div>
</AgentPage>

<style>
  .feat { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; margin-top: 72px; }
  .feat-eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey-600); margin-bottom: 14px; }
  .feat-copy h2 { font-size: clamp(24px, 3vw, 38px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 16px; }
  .feat-body { color: var(--grey-600); font-size: 15px; line-height: 1.6; max-width: 56ch; }
  .code-card { border: 1px solid #242424; border-radius: var(--radius-lg); background: #0d0d0d; overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.85; color: #c9c9cf; white-space: pre; }
  @media (max-width: 900px) { .feat { grid-template-columns: 1fr; gap: 28px; } }
</style>
