---
import AgentPage from '../../components/AgentPage.astro';

const crew = [
  { name: 'Coordinator', href: '/agents/coordinator' },
  { name: 'Researcher', href: '/agents/researcher' },
  { name: 'Coder', href: '/agents/coder' },
  { name: 'Operator', href: '/agents/operator' },
  { name: 'Browser', href: '/agents/browser' },
  { name: 'Memory keeper', href: '/agents/memoring', current: true },
  { name: 'Reviewer', href: '/agents/reviewer' },
];

const caps = [
  { name: 'memory_absorb', d: 'Facts enter through a 5-outcome pipeline: duplicate · supersede · contradict · related · new. Append-only with a full audit trail; dry_run previews the plan before writing.' },
  { name: 'memory_search', d: 'Hybrid retrieval — vector cosine fused with BM25 keyword matching and freshness decay. Id lookup with follow: active · latest · full_history.' },
  { name: 'memory_digest', d: 'Deterministic pre-task context: relevant memories + open TODOs + recent facts, with real ids you can verify. Loaded before work starts so nothing is re-done.' },
  { name: 'memory_boost', d: 'Raise (or lower) the importance of a memory that proved useful — default +0.5. Importance breaks ranking ties and shapes future digests.' },
  { name: 'memory_link', d: 'Typed edges between facts: related_to · implements · extends · references. supersedes and contradicts are created automatically by absorb.' },
  { name: 'memory_graph', d: 'Entity graph for people, projects, systems, and organizations. Nodes dedup by name+type, with typed relations and multi-hop BFS up to 4 hops.' },
];

const flow = [
  { t: 'Validate', d: 'Self-contained facts, 50–500 chars recommended (3–5000 enforced). Tags and metadata travel with the content.' },
  { t: 'Secret scan', d: 'sk-, sk-ant-, AKIA…, ghp_, xoxb-, Bearer tokens, PEM blocks and api_key assignments are rejected at the gate.' },
  { t: 'Consolidate', d: 'Near-duplicates within one batch merge into a single fact at cosine > 0.85; embeddings include tags and metadata.' },
  { t: 'Dedup & classify', d: 'Exact dedup by content hash; candidates at cosine ≥ 0.55; an LLM verdict — or the ≥ 0.97 heuristic — decides the relation.' },
  { t: 'Apply verdict', d: 'Duplicates skip · supersede writes a new row plus a supersedes edge and marks the old one · contradict keeps both versions alive. Nothing is ever overwritten.' },
];

const tiers = [
  { name: 'MEMORY.md / USER.md', d: 'A ~2 KB stable profile frozen into the system prompt at session start — prefix-cache friendly, always present, refreshed next run.' },
  { name: 'SKILL.md', d: 'Procedural knowledge distilled from experience; injected on demand via the skill tool instead of burning prompt budget.' },
  { name: 'Semantic archive', d: 'A durable SQLite knowledge base: hybrid search, typed edges, entity graph, supersession chains, and a history journal.' },
];

const hood = [
  ['Store', 'SQLite · append-only rows · FTS5 (BM25) · embeddings · history journal'],
  ['Hybrid score', 'score = 0.7·cosine + 0.3·BM25, both signals normalized'],
  ['Freshness decay', 'score × max(0, 1 − 0.01·days) — 1% per day'],
  ['Scopes', 'agent (shared knowledge) · user (about the client) · run (session episode)'],
  ['Ids & reads', 'UUIDv7, shown as last 8 chars · follow active | latest | full_history'],
  ['Auto-absorb', 'Successful extraction and discovery results can be stored without another model call, retaining confidence, tags, and session provenance'],
  ['Digest', 'bounded prompt block with real ids — relevant memories, open TODOs, recent facts'],
  ['Embeddings', 'OpenAI-compatible endpoint, offline TF-IDF fallback (512-dim) · vectors of different models never mix'],
  ['Housekeeping', 'distill promotes run facts into agent knowledge · GC archives expired/stale rows and compacts groups > 200 — nothing is deleted'],
  ['Benchmarks', 'absorb 49–521 µs/fact · hybrid search 0.6–0.9 ms at 1K rows · digest ~2 ms'],
];

const tools = [
  'memory_absorb', 'memory_search', 'memory_digest', 'memory_boost',
  'memory_link', 'memory_graph', 'memory', 'skill',
];
---

<AgentPage
  pageTitle="Memory Worker — Fathom"
  pageDesc="Persistent memory for the whole worker fleet: append-only knowledge base, hybrid search, entity graph, and pre-task digests."
  k="agents.memoring"
  index="06"
  title="Memoring"
  sub="Persistent memory for the whole worker fleet. Facts, findings, decisions, and past runs are absorbed into an append-only knowledge base so the next operation starts from what is already known."
  mode="memoring"
  hue={25}
  crew={crew}
  caps={caps}
  capsEyebrow="The toolset"
  capsTitle="Six tools, one knowledge base"
  flow={flow}
  flowTitle="The absorb pipeline"
  hood={hood}
  hoodTitle="Append-only, verifiable, fast"
  tools={tools}
  toolsTitle="The Memoring toolset"
  ctaTitle="Next: Outreach — the finale of the chain"
  prev={{ href: '/agents/cleaning', label: '← Cleaning' }}
  next={{ href: '/agents/outreach', label: 'Outreach →' }}
>
  <div slot="mid" class="tiers-sec">
    <div class="sec-head">
      <p class="eyebrow"><span class="eyebrow__num">02.5</span><span data-i18n="agents.memoring.tiers.eyebrow">Three tiers</span></p>
      <h2 data-i18n="agents.memoring.tiers.title">Profile, skills, archive</h2>
    </div>
    <div class="tiers-grid">
      {
        tiers.map((t) => (
          <div class="tier-card">
            <div class="tier-name">{t.name}</div>
            <p>{t.d}</p>
          </div>
        ))
      }
    </div>
  </div>

  <div slot="posttools" class="feat feat-reverse">
    <div class="feat-copy">
      <p class="feat-eyebrow" data-i18n="agents.memoring.feeds.eyebrow">Feeds the worker fleet</p>
      <h2 data-i18n="agents.memoring.feeds.title">Every operation starts smarter</h2>
      <p class="feat-body" data-i18n="agents.memoring.feeds.body">Findings, decisions, entities, and session summaries are absorbed automatically with provenance and confidence. Any later worker can load a digest, follow supersession chains, and see contradictions instead of asserting stale context. Repeat operations stop being a cold start.</p>
    </div>
    <div class="code-card">
      <pre><code>{`$ memory_digest(topic: "Acme follow-up")

## Long-term memory digest

### Relevant memories
- [a3f19c02] Acme CTO is Ivan Petrov, ivan@acme.com
  verified 2026-08 (conf 0.90)
- [7b20dd41] first outreach sent 2026-07-12;
  reply asked for pricing details (conf 0.80)

### Open TODOs
- [91c4e8ab] check Acme Q3 hiring before follow-up

### Recently added
- [c04b7715] Acme opened 6 platform roles (conf 0.60)`}</code></pre>
    </div>
  </div>
</AgentPage>

<style>
  .tiers-sec { margin-top: 72px; }
  .tiers-sec .eyebrow { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey-600); }
  .tiers-sec .eyebrow__num { color: var(--grey-400); }
  .tiers-sec .sec-head { max-width: 760px; margin-bottom: 30px; }
  .tiers-sec h2 { font-size: clamp(26px, 3.4vw, 42px); font-weight: 500; letter-spacing: -0.025em; margin-top: 14px; }
  .tiers-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--grey-300); border: 1px solid var(--grey-300); border-radius: var(--radius-lg); overflow: hidden; }
  .tier-card { background: var(--bg-primary); padding: 26px 24px; display: flex; flex-direction: column; gap: 10px; transition: background .25s var(--ease-out); }
  .tier-card:hover { background: var(--bg-card-hover); }
  .tier-name { font-family: var(--font-mono); font-weight: 600; font-size: 14px; }
  .tier-card p { color: var(--grey-600); font-size: 13.5px; line-height: 1.55; }
  @media (max-width: 800px) { .tiers-grid { grid-template-columns: 1fr; } }

  .feat { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; margin-top: 72px; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  .feat-eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey-600); margin-bottom: 14px; }
  .feat-copy h2 { font-size: clamp(24px, 3vw, 38px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 16px; }
  .feat-body { color: var(--grey-600); font-size: 15px; line-height: 1.6; max-width: 56ch; }
  .code-card { border: 1px solid #242424; border-radius: var(--radius-lg); background: #0d0d0d; overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.85; color: #c9c9cf; white-space: pre; }
  @media (max-width: 900px) { .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; direction: ltr; } }
</style>
