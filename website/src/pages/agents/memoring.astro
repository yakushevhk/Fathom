---
import Layout from '../../layouts/Layout.astro';
import AgentCanvas from '../../components/AgentCanvas.astro';

const agentsNav = [
  { n: 'Researcher', href: '/agents/researcher' },
  { n: 'Searching', href: '/agents/searching' },
  { n: 'Extracting', href: '/agents/extracting' },
  { n: 'Structuring', href: '/agents/structuring' },
  { n: 'Cleaning', href: '/agents/cleaning' },
  { n: 'Memoring', href: '/agents/memoring' },
  { n: 'Outreach', href: '/agents/outreach' },
];

const cards = [
  { name: 'memory_absorb', d: 'Facts enter through a 5-outcome pipeline: duplicate · supersede · contradict · related · new. Append-only with a full audit trail; dry_run previews the plan before writing.' },
  { name: 'memory_search', d: 'Hybrid retrieval — vector cosine fused with BM25 keyword matching and freshness decay. Id lookup with follow: active · latest · full_history.' },
  { name: 'memory_digest', d: 'Deterministic pre-task context: relevant memories + open TODOs + recent facts, with real ids you can verify. Loaded before work starts so nothing is re-done.' },
  { name: 'memory_boost', d: 'Raise (or lower) the importance of a memory that proved useful — default +0.5. Importance breaks ranking ties and shapes future digests.' },
  { name: 'memory_link', d: 'Typed edges between facts: related_to · implements · extends · references. supersedes and contradicts are created automatically by absorb.' },
  { name: 'memory_graph', d: 'Entity graph person ↔ company ↔ location. Nodes dedup by name+type, typed relations, multi-hop BFS up to 4 hops — "who leads Acme".' },
];

const flow = [
  { n: '1', t: 'Validate', d: 'Self-contained facts, 50–500 chars recommended (3–5000 enforced). Tags and metadata travel with the content.' },
  { n: '2', t: 'Secret scan', d: 'sk-, sk-ant-, AKIA…, ghp_, xoxb-, Bearer tokens, PEM blocks and api_key assignments are rejected at the gate.' },
  { n: '3', t: 'Consolidate', d: 'Near-duplicates within one batch merge into a single fact at cosine > 0.85; embeddings include tags and metadata.' },
  { n: '4', t: 'Dedup & classify', d: 'Exact dedup by content hash; candidates at cosine ≥ 0.55; an LLM verdict — or the ≥ 0.97 heuristic — decides the relation.' },
  { n: '5', t: 'Apply verdict', d: 'Duplicates skip · supersede writes a new row plus a supersedes edge and marks the old one · contradict keeps both versions alive. Nothing is ever overwritten.' },
];

const tiers = [
  { name: 'MEMORY.md / USER.md', d: 'A ~2 KB stable profile frozen into the system prompt at session start — prefix-cache friendly, always present, refreshed next run.' },
  { name: 'SKILL.md', d: 'Procedural knowledge distilled from experience; injected on demand via the skill tool instead of burning prompt budget.' },
  { name: 'Semantic archive', d: 'The unlimited SQLite knowledge base: hybrid search, typed edges, entity graph, supersession chains, history journal.' },
];

const hood = [
  ['Store', 'SQLite · append-only rows · FTS5 (BM25) · embeddings · history journal'],
  ['Hybrid score', 'score = 0.7·cosine + 0.3·BM25, both signals normalized'],
  ['Freshness decay', 'score × max(0, 1 − 0.01·days) — 1% per day'],
  ['Scopes', 'agent (shared knowledge) · user (about the client) · run (session episode)'],
  ['Ids & reads', 'UUIDv7, shown as last 8 chars · follow active | latest | full_history'],
  ['Auto-absorb', 'extract_contacts / find_leads results stored without the model — confidence 0.6, tags contact/lead · session summary at 0.7'],
  ['Digest', 'bounded prompt block with real ids — relevant memories, open TODOs, recent facts'],
  ['Embeddings', 'OpenAI-compatible endpoint, offline TF-IDF fallback (512-dim) · vectors of different models never mix'],
  ['Housekeeping', 'distill promotes run facts into agent knowledge · GC archives expired/stale rows and compacts groups > 200 — nothing is deleted'],
  ['Benchmarks', 'absorb 49–521 µs/fact · hybrid search 0.6–0.9 ms at 1K rows · digest ~2 ms'],
];

const tools = [
  'memory_absorb',
  'memory_search',
  'memory_digest',
  'memory_boost',
  'memory_link',
  'memory_graph',
  'memory',
  'skill',
];
---

<Layout
  title="Memoring — Agent 06 — Fathom Research"
  description="Memoring — the long-term semantic memory agent: append-only absorb with 5 outcomes, hybrid 0.7·cosine + 0.3·BM25 search, secret detection and an entity graph. Outreach that remembers every past touch."
>
  <main class="ag-page">
    <div class="container">
      <!-- 1 · Hero -->
      <div class="ag-hero">
        <p class="eyebrow" data-i18n="agents.memoring.hero.eyebrow">Agent 06 / 07</p>
        <h1 class="h2-sec" data-i18n="agents.memoring.hero.title">Memoring</h1>
        <p class="copy-lg mx-auto" data-i18n="agents.memoring.hero.sub">Long-term memory for the whole pipeline. Every verified contact, company fact and past touch is absorbed into an append-only knowledge base — so the next run, and the next outreach message, starts from everything already known instead of zero.</p>
        <div class="canvas-wrap">
          <AgentCanvas agents={[{ name: 'Memoring', mode: 'memoring', hue: 25 }]} />
        </div>
      </div>

      <!-- 2 · Cross-nav -->
      <nav class="chips agent-nav" aria-label="All agents">
        {
          agentsNav.map((a) =>
            a.n === 'Memoring' ? (
              <span class="chip chip-active" aria-current="page">{a.n}</span>
            ) : (
              <a class="chip" href={a.href}>{a.n}</a>
            )
          )
        }
      </nav>

      <!-- 3 · What it does -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.memoring.what.eyebrow">What it does</p>
        <h2 class="h3-sec" data-i18n="agents.memoring.what.title">Six tools, one knowledge base</h2>
      </div>
      <div class="api-grid">
        {
          cards.map((c) => (
            <div class="api-card">
              <div class="api-name">{c.name}</div>
              <p>{c.d}</p>
            </div>
          ))
        }
      </div>

      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.memoring.tiers.eyebrow">Three tiers</p>
        <h2 class="h3-sec" data-i18n="agents.memoring.tiers.title">Profile, skills, archive</h2>
      </div>
      <div class="api-grid api-grid--3">
        {
          tiers.map((t) => (
            <div class="api-card">
              <div class="api-name">{t.name}</div>
              <p>{t.d}</p>
            </div>
          ))
        }
      </div>

      <!-- 4 · How it works -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.memoring.how.eyebrow">How it works</p>
        <h2 class="h3-sec" data-i18n="agents.memoring.how.title">The absorb pipeline</h2>
      </div>
      <div class="flow">
        {
          flow.map((s, i) => (
            <div class="flow-step">
              <span class="flow-num">{s.n}</span>
              <h3 data-i18n={`agents.memoring.flow.${i}.t`}>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))
        }
      </div>

      <!-- 5 · Under the hood -->
      <div class="feat" id="hood">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="agents.memoring.hood.eyebrow">Under the hood</p>
          <h2 class="h3-sec" data-i18n="agents.memoring.hood.title">Append-only, verifiable, fast</h2>
          <p class="copy-lg">Every fact carries scope, confidence, provenance and a history journal. Supersession chains resolve with <code class="ic">follow=latest</code>; contradictions stay visible on both sides. GC and distillation only ever archive — <code class="ic">full_history</code> still reaches every row.</p>
        </div>
        <div class="mini-table-wrap">
          <table class="mini-table">
            <thead><tr><th data-i18n="agents.memoring.hood.keyCol">Detail</th><th data-i18n="agents.memoring.hood.detailCol">Implementation</th></tr></thead>
            <tbody>
              {
                hood.map((r) => (
                  <tr>
                    <td>{r[0]}</td>
                    <td>{r[1]}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- 6 · Tools -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.memoring.tools.eyebrow">Tools</p>
        <h2 class="h3-sec" data-i18n="agents.memoring.tools.title">The Memoring toolset</h2>
      </div>
      <div class="chips">
        {tools.map((t) => <span class="chip">{t}</span>)}
      </div>

      <!-- 7 · Feeds the outreach pipeline -->
      <div class="feat feat-reverse" id="outreach-feed">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="agents.memoring.feeds.eyebrow">Feeds the outreach pipeline</p>
          <h2 class="h3-sec" data-i18n="agents.memoring.feeds.title">Outreach that remembers every touch</h2>
          <p class="copy-lg">Every harvested contact is absorbed automatically — no model call, confidence 0.6, tagged <code class="ic">contact</code>/<code class="ic">lead</code> — and session summaries land at 0.7. Before composing a follow-up, the Outreach agent loads a digest: who was contacted, what was verified, what was promised. Supersession chains track role changes and new emails without losing history; contradictions keep both versions visible, so a message never asserts a stale fact confidently. Repeat outreach stops being a cold start.</p>
        </div>
        <div class="code-card">
          <pre><code>{`$ memory_digest(topic: "Acme follow-up")

## Long-term memory digest

### Relevant memories
- [a3f19c02] Acme CTO is Ivan Petrov, ivan@acme.com
  verified 2026-08 (conf 0.90)
- [7b20dd41] first outreach sent 2026-07-12;
  reply asked for pricing details (conf 0.80)

### Open TODOs
- [91c4e8ab] check Acme Q3 hiring before follow-up

### Recently added
- [c04b7715] Acme opened 6 platform roles (conf 0.60)`}</code></pre>
        </div>
      </div>

      <!-- 8 · CTA -->
      <div class="cta-strip">
        <h2 data-i18n="agents.memoring.cta.title">Next: Outreach — the finale of the chain</h2>
        <div class="cta-links">
          <a href="/agents/cleaning" class="btn btn-secondary">← Cleaning</a>
          <a href="/agents/outreach" class="btn btn-primary">Outreach →</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .ag-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .h3-sec { font-size: clamp(20px, 2.4vw, 34px); font-weight: 500; letter-spacing: -0.02em; margin: 12px 0 0; }
  .ic { font-family: var(--font-mono); font-size: .85em; background: var(--grey-100); border: 1px solid var(--grey-200); padding: 1px 6px; border-radius: 5px; }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .ag-hero { max-width: 820px; margin: 0 auto 40px; text-align: center; padding: 0 24px; }
  .ag-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .ag-hero .copy-lg { margin-top: 20px; }
  .canvas-wrap { margin-top: 36px; }

  .agent-nav { justify-content: center; margin: 0 0 8px; }

  .sec-head { max-width: 720px; margin: 60px 0 28px; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-family: var(--font-mono); font-size: 13px; background: var(--bg-card); border: 1px solid var(--grey-200); padding: 8px 14px; border-radius: 100px; color: var(--grey-700); text-decoration: none; }
  a.chip:hover { border-color: var(--grey-400); color: var(--grey-900); }
  .chip-active { background: var(--grey-900); border-color: var(--grey-900); color: var(--grey-50); }

  .api-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: var(--grey-300); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--grey-300); }
  .api-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .api-card { background: var(--bg-card); padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .api-card .api-name { font-family: var(--font-mono); font-weight: 600; font-size: 14px; }
  .api-card p { color: var(--grey-600); font-size: 14px; line-height: 1.55; }
  @media (max-width: 800px) { .api-grid, .api-grid--3 { grid-template-columns: 1fr; } }

  .flow { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .flow-step { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 20px; }
  .flow-num { display: inline-flex; width: 26px; height: 26px; align-items: center; justify-content: center; border-radius: 50%; background: var(--grey-900); color: #fff; font-family: var(--font-mono); font-size: 12px; margin-bottom: 12px; }
  .flow-step h3 { font-size: 15px; font-weight: 600; margin-bottom: 6px; }
  .flow-step p { font-size: 13px; color: var(--grey-600); line-height: 1.55; }
  @media (max-width: 1000px) { .flow { grid-template-columns: repeat(2, 1fr); } }

  .feat { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding: 48px 0; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  .feat-copy .copy-lg { margin-top: 16px; }
  @media (max-width: 900px) { .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; direction: ltr; } }

  .mini-table-wrap { border: 1px solid var(--grey-200); border-radius: 8px; overflow: auto; background: var(--bg-card); }
  .mini-table { width: 100%; border-collapse: collapse; font-size: 13px; font-family: var(--font-mono); }
  .mini-table th { font-size: 10px; text-transform: uppercase; letter-spacing: .6px; color: var(--grey-600); text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--grey-200); background: var(--grey-50); }
  .mini-table td { padding: 10px 14px; border-bottom: 1px solid var(--grey-100); color: var(--grey-800); vertical-align: top; }
  .mini-table td:first-child { color: var(--grey-600); white-space: nowrap; }
  .mini-table tr:last-child td { border-bottom: none; }

  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--bg-dark); overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 13px; line-height: 1.7; color: var(--grey-100); white-space: pre; }

  .cta-strip { margin-top: 64px; background: var(--bg-dark); border-radius: var(--radius-xl); padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta-strip h2 { color: #fff; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; }
  .cta-links { display: flex; gap: 10px; flex-wrap: wrap; }
  .cta-strip .btn-primary { background: var(--bg-card); color: var(--grey-900); }
  .cta-strip .btn-secondary { border-color: rgba(255,255,255,.3); color: var(--grey-100); }
</style>
