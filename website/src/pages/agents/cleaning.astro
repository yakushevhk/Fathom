---
import AgentPage from '../../components/AgentPage.astro';

const crew = [
  { name: 'Researcher', href: '/agents/researcher' },
  { name: 'Searching', href: '/agents/searching' },
  { name: 'Extracting', href: '/agents/extracting' },
  { name: 'Structuring', href: '/agents/structuring' },
  { name: 'Cleaning', href: '/agents/cleaning', current: true },
  { name: 'Memoring', href: '/agents/memoring' },
  { name: 'Outreach', href: '/agents/outreach' },
];

const caps = [
  { tool: 'verify_email', name: 'The email gauntlet', d: 'RFC 5322 syntax, MX lookup over DNS-over-HTTPS, disposable-domain and role-based filters, optional SMTP RCPT probe — every signal folded into one deliverability confidence score.' },
  { tool: 'verify_phone', name: 'Numbers that dial', d: 'libphonenumber metadata turns "+7 (495) 710-75-80" into +74957107580 — E.164, country RU, and line type when metadata supports it.' },
  { tool: 'verify_social_profile', name: 'Profiles that exist', d: 'GitHub verified through the public API; every other platform by page fetch with soft-404 content detection. Bot walls (401/403/429) are reported honestly, never guessed away.' },
  { tool: 'suggest_emails', name: 'Fill the gaps', d: 'Up to 9 candidates from name permutations (first.last, flast, last.first…), ranked by the corporate pattern inferred from known colleague addresses — each scored by the same verification pipeline.' },
  { tool: 'dedup & merge', name: 'One list, no twins', d: 'Duplicates are found on normalized keys — lower-cased email, digits-only phone — then merged atomically: blanks filled, socials/tags/notes moved over, the duplicate row deleted.' },
  { tool: 'side-effect safety', name: 'Signals before action', d: 'Role addresses and disposable inboxes are flagged, and SMTP outcomes are kept as explicit evidence. Operators can review confidence before a worker performs a side effect.' },
];

const flow = [
  { t: 'Candidates', d: 'The raw list arrives from the contact DB: emails, phones, social URLs, each with its extraction confidence.' },
  { t: 'Email checks', d: 'Syntax → MX via DoH (Google, Cloudflare fallback) → A-record fallback → disposable & role-based filters.' },
  { t: 'SMTP probe', d: 'Optional port-25 dialogue: banner, HELO, MAIL FROM, RCPT TO — never sends DATA. Accepted, rejected or inconclusive.' },
  { t: 'Phone checks', d: 'Parsed against region metadata, validated for length and type, normalized to E.164, classified mobile vs landline.' },
  { t: 'Social checks', d: 'Profile fetched with a browser UA; soft-404 content scans decide existence; blocked checks surface as notes.' },
  { t: 'Rank & review', d: 'Pattern-matched candidates receive confidence signals; blocked and inconclusive records remain visible for operator review before any governed action.' },
];

const hood = [
  ['Confidence formula', 'invalid syntax 0.0 · base 0.5 + 0.4 live domain · capped 0.9 without SMTP · ≥ 0.95 SMTP-accepted · ≤ 0.2 SMTP-rejected · disposable −0.3'],
  ['Syntax rules', 'RFC 5322 subset: local part ≤ 64 chars, domain ≤ 253, no leading/trailing/consecutive dots, non-numeric TLD'],
  ['MX lookup', 'DNS-over-HTTPS: dns.google → cloudflare-dns.com fallback, 5 s timeout · RFC 5321 A-record fallback · RFC 7505 null MX means "accepts no mail"'],
  ['Disposable domains', 'Configured disposable-domain rules are matched exactly or as wildcard subdomains; blocked or unknown checks remain visible'],
  ['Role-based local parts', 'Department addresses such as info@, support@, admin@, sales@, and hr@ are flagged as non-personal records'],
  ['SMTP probe', 'connect timeout 10 s, per-read 5 s · 250/251 = accepted, 5xx = rejected, 4xx = inconclusive · probe bails before DATA — no mail is ever sent'],
  ['E.164 phones', '"+7 (495) 710-75-80" → +74957107580 · RU · landline · 17 number types · default_country resolves national formats'],
  ['suggest_emails', '9 patterns: first.last, firstlast, f.last, first.l, last.first, first_last, f_last, flast, first-last · pattern match +0.15, capped 0.95'],
  ['Social verification', 'soft-404 content scan on HTTP 200 · 404/410 dead · 401/403/429 reported as bot-blocked · og:title name + follower count when public'],
  ['Dedup & merge', 'normalized email (trim + lowercase) and digits-only phone keys · atomic merge fills blanks and moves socials/tags/notes'],
];

const results = [
  { v: '0.95', c: 'maximum confidence assigned to an SMTP-confirmed mailbox' },
  { v: '9', c: 'candidate patterns available to suggest_emails' },
  { v: 'E.164', c: 'normalized phone representation for downstream tools' },
  { v: 'Review', c: 'blocked, inconclusive, and role-based signals stay visible' },
];

const tools = ['verify_email', 'verify_phone', 'verify_social_profile', 'suggest_emails'];
---

<AgentPage
  pageTitle="Verification Worker — Fathom"
  pageDesc="Checks email, phone, and profile data before it reaches a governed action — five gates, honest signals, reviewable evidence."
  k="agents.cleaning"
  index="05"
  title="Cleaning"
  sub="The verification worker checks email, phone, profile, and extracted data before it reaches a governed action — keeping downstream work grounded in records that actually exist."
  mode="cleaning"
  hue={160}
  crew={crew}
  caps={caps}
  capsTitle="Verification before a governed action"
  flow={flow}
  flowTitle="Six gates between input and action"
  hood={hood}
  hoodTitle="Thresholds, filters and formulas"
  tools={tools}
  toolsTitle="The verification toolbox"
  ctaTitle="Clear signals make governed actions safer"
  prev={{ href: '/agents/structuring', label: '← Structuring' }}
  middle={{ href: '/features/auto-outreach', label: 'Auto outreach' }}
  next={{ href: '/agents/memoring', label: 'Memoring →' }}
>
  <div slot="pretools" class="results-sec">
    <div class="sec-head">
      <p class="eyebrow"><span class="eyebrow__num">03.5</span><span>Results</span></p>
      <h2>What cleaning buys you</h2>
    </div>
    <div class="results-grid">
      {
        results.map((m) => (
          <div class="result-card">
            <div class="result-v">{m.v}</div>
            <div class="result-c">{m.c}</div>
          </div>
        ))
      }
    </div>
  </div>

  <div slot="posttools" class="feat">
    <div class="feat-copy">
      <p class="feat-eyebrow" data-i18n="agents.cleaning.feeds.eyebrow">Feeds downstream workers</p>
      <h2 data-i18n="agents.cleaning.feeds.title">Verified inputs keep actions safe</h2>
      <p class="feat-body" data-i18n="agents.cleaning.feeds.body">Downstream workers receive only validated values and explicit confidence signals. Bad addresses, malformed records, and disposable domains stay out of governed actions, whether the next step is outreach, a report, or an update to another system.</p>
    </div>
    <div class="code-card">
      <pre><code>{`verify_email("ann@acme.io")
→ syntax: valid · domain: exists
→ disposable: no · role-based: no
→ confidence: 0.90   # LIKELY VALID

verify_phone("+7 (495) 710-75-80")
→ +74957107580 · RU · landline · valid

# reviewable survivors reach the next worker —
# governed actions use recorded evidence`}</code></pre>
    </div>
  </div>
</AgentPage>

<style>
  .results-sec { margin-top: 72px; }
  .results-sec .eyebrow { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey-600); }
  .results-sec .eyebrow__num { color: var(--grey-400); }
  .results-sec .sec-head { max-width: 760px; margin-bottom: 30px; }
  .results-sec h2 { font-size: clamp(26px, 3.4vw, 42px); font-weight: 500; letter-spacing: -0.025em; margin-top: 14px; }
  .results-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .result-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; transition: border-color .25s, transform .25s var(--ease-out), box-shadow .25s; }
  .result-card:hover { border-color: var(--grey-400); transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .result-v { font-size: 34px; font-weight: 500; letter-spacing: -0.03em; line-height: 1; }
  .result-c { font-family: var(--font-mono); font-size: 12px; color: var(--grey-600); margin-top: 10px; line-height: 1.5; }
  @media (max-width: 900px) { .results-grid { grid-template-columns: 1fr 1fr; } }

  .feat { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; margin-top: 72px; }
  .feat-eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey-600); margin-bottom: 14px; }
  .feat-copy h2 { font-size: clamp(24px, 3vw, 38px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 16px; }
  .feat-body { color: var(--grey-600); font-size: 15px; line-height: 1.6; max-width: 56ch; }
  .code-card { border: 1px solid #242424; border-radius: var(--radius-lg); background: #0d0d0d; overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.85; color: #c9c9cf; white-space: pre; }
  @media (max-width: 900px) { .feat { grid-template-columns: 1fr; gap: 28px; } }
</style>
