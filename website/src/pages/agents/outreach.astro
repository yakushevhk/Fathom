---
import AgentPage from '../../components/AgentPage.astro';

const crew = [
  { name: 'Researcher', href: '/agents/researcher' },
  { name: 'Searching', href: '/agents/searching' },
  { name: 'Extracting', href: '/agents/extracting' },
  { name: 'Structuring', href: '/agents/structuring' },
  { name: 'Cleaning', href: '/agents/cleaning' },
  { name: 'Memoring', href: '/agents/memoring' },
  { name: 'Outreach', href: '/agents/outreach', current: true },
];

const caps = [
  { name: 'One artifact, one context', d: 'Role-aware and grounded in what the workflow actually found — a report, update, notification, or message. No fill-in-the-blanks templates.' },
  { name: 'Batch generation', d: 'Pass a set of structured records: each artifact is built from enriched context, notes, provenance, and verification confidence.' },
  { name: 'Channel fit', d: 'Email subject + body, LinkedIn connection notes tuned to the channel’s limits, conversational Telegram openers for messaging-first markets.' },
  { name: 'Approval before side effects', d: 'save_contacts and git_push are approval-gated by default: y/n in the TUI, POST /sessions/:id/approve over the API — with timeout and headless fallback.' },
  { name: 'CRM push', d: 'amoCRM v4 · Bitrix24 REST · HubSpot CRM v3. Pushes run 4-at-a-time with one retry, and dedup by crm_id means re-runs never double-create.' },
  { name: 'Export & notify', d: 'Contacts as CSV · vCard · JSON · xlsx, reports as PDF · HTML · DOCX, completion fan-out via webhook · email · Telegram.' },
];

const flow = [
  { t: 'Ground', d: 'Load verified records plus the memory digest: prior decisions, relevant entities, and current provenance.' },
  { t: 'Compose', d: 'Create the requested artifact from real context — records, recent findings, source URLs, and explicit constraints. Nothing invented.' },
  { t: 'Approve', d: 'Side-effect tools pause and wait. Nothing leaves the pipeline without an explicit yes from the operator.' },
  { t: 'Deliver', d: 'Persistence deduplicates and merges; configured integrations store remote ids for idempotent reruns; exports remain available for operator review.' },
  { t: 'Watch', d: 'An operator-triggered or configured schedule can rerun the workflow and diff results, sending notifications when tracked records change.' },
];

const hood = [
  ['Approval gate', '[agent] approval_tools defaults to save_contacts, git_push · timeout + headless fallback'],
  ['Local dedup', 'save_contacts merges on normalized email/phone — atomic check-and-insert, never a duplicate'],
  ['amoCRM', 'POST /api/v4/contacts on your account subdomain · bearer auth · PHONE/EMAIL field codes'],
  ['Bitrix24', '/rest/crm.contact.add.json · auth query param · NAME, POST, EMAIL, PHONE, COMMENTS'],
  ['HubSpot', 'api.hubapi.com/crm/v3/objects/contacts · private app token · firstname/lastname split'],
  ['CRM dedup', 'remote id stored as crm_id → already-synced contacts are skipped on every re-push'],
  ['Push engine', 'bounded concurrency ×4 · one retry after 1s on transient failure · errors reported, not fatal'],
  ['Contact export', 'csv · vcard · json · xlsx'],
  ['Report export', 'pdf · html · json · docx — pandoc, with wkhtmltopdf fallback for PDF'],
  ['Notify', 'webhook JSON (session.completed) · SMTP email · Telegram bot — fan-out, one failing channel never blocks the rest'],
  ['Watch mode', 'run --repeat N — runs are diffed; new emails/phones/persons alerted via webhook, Telegram or email'],
];

const tools = [
  'save_contacts', 'memory_digest', 'memory_search', 'memory_graph',
  'verify_email', 'suggest_emails', 'file_write', 'python_exec',
];
---

<AgentPage
  pageTitle="Outreach & Operations Worker — Fathom"
  pageDesc="Turns verified context and memory into governed action: personalized drafts, approved updates, exports, scheduled runs, and notifications."
  k="agents.outreach"
  index="07"
  title="Outreach"
  sub="The operations worker turns verified context and memory into useful action: personalized drafts, approved updates, exports, scheduled runs, and notifications — without losing the operator in the loop."
  mode="outreach"
  hue={130}
  crew={crew}
  caps={caps}
  capsTitle="From verified context to ready drafts"
  flow={flow}
  flowTitle="Five steps to a reviewable result"
  hood={hood}
  hoodTitle="A draft you can audit"
  tools={tools}
  toolsTitle="The Outreach toolset"
  ctaTitle="Run a governed operation from start to finish"
  prev={{ href: '/agents/memoring', label: '← Memoring' }}
  middle={{ href: '/#cta', label: 'Get started →' }}
>
  <div slot="posttools" class="feat feat-reverse">
    <div class="feat-copy">
      <p class="feat-eyebrow">Delivers governed operations</p>
      <h2>From context to accountable action</h2>
      <p class="feat-body">This worker turns grounded context into useful action: a personalized draft, an approved record update, an export, or a scheduled notification. Memory keeps repeat runs current, approval gates keep operators in control, and every result can be inspected before it leaves the runtime.</p>
    </div>
    <div class="code-card">
      <pre><code>{`Subject: Acme's Series B → platform hiring

Hi Jane — saw Acme closed the Series B and opened
6 platform roles. When we spoke in March you
mentioned infra tooling was the bottleneck —
we've since documented a repeatable workflow
for this kind of handoff. Worth a 15-min call?

────────────────────────────────────────────
approval:    granted (operator, TUI)
save_contacts: 1 saved · merged with existing
crm push:    hubspot id 515 (crm_id stored)
export:      outreach-batch.docx
notify:      telegram ✓  webhook ✓`}</code></pre>
    </div>
  </div>
</AgentPage>

<style>
  .feat { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; margin-top: 72px; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  .feat-eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey-600); margin-bottom: 14px; }
  .feat-copy h2 { font-size: clamp(24px, 3vw, 38px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 16px; }
  .feat-body { color: var(--grey-600); font-size: 15px; line-height: 1.6; max-width: 56ch; }
  .code-card { border: 1px solid #242424; border-radius: var(--radius-lg); background: #0d0d0d; overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.85; color: #c9c9cf; white-space: pre; }
  @media (max-width: 900px) { .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; direction: ltr; } }
</style>
