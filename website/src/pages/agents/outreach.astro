---
import Layout from '../../layouts/Layout.astro';
import AgentCanvas from '../../components/AgentCanvas.astro';

const agentsNav = [
  { n: 'Researcher', href: '/agents/researcher' },
  { n: 'Searching', href: '/agents/searching' },
  { n: 'Extracting', href: '/agents/extracting' },
  { n: 'Structuring', href: '/agents/structuring' },
  { n: 'Cleaning', href: '/agents/cleaning' },
  { n: 'Memoring', href: '/agents/memoring' },
  { n: 'Outreach', href: '/agents/outreach' },
];

const cards = [
  { name: 'One message, one recipient', d: 'Role-aware, company-aware, grounded in what the pipeline actually found — a funding round, a hiring wave, a tech migration. No fill-in-the-blanks templates.' },
  { name: 'Batch generation', d: 'Pass the whole lead list: every contact gets an individual message built from enriched context — title, company, notes, verification confidence.' },
  { name: 'Channel fit', d: 'Email subject + body, LinkedIn connection notes tuned to the channel’s limits, conversational Telegram openers for messaging-first markets.' },
  { name: 'Approval before side effects', d: 'save_contacts and git_push are approval-gated by default: y/n in the TUI, POST /sessions/:id/approve over the API — with timeout and headless fallback.' },
  { name: 'CRM push', d: 'amoCRM v4 · Bitrix24 REST · HubSpot CRM v3. Pushes run 4-at-a-time with one retry, and dedup by crm_id means re-runs never double-create.' },
  { name: 'Export & notify', d: 'Contacts as CSV · vCard · JSON · xlsx, reports as PDF · HTML · DOCX, completion fan-out via webhook · email · Telegram.' },
];

const flow = [
  { n: '1', t: 'Ground', d: 'Load verified contacts plus the memory digest: past touches, verified emails, the person ↔ company graph.' },
  { n: '2', t: 'Compose', d: 'One message per recipient, written from real context — role, company, recent findings, source URLs. Nothing invented.' },
  { n: '3', t: 'Approve', d: 'Side-effect tools pause and wait. Nothing leaves the pipeline without an explicit yes from the operator.' },
  { n: '4', t: 'Deliver', d: 'save_contacts dedups and merges; the CRM push stores crm_id so the next run skips what is already synced; exports for any stack.' },
  { n: '5', t: 'Watch', d: 'run --repeat 24 re-runs on a schedule and diffs the results — new emails, phones and persons trigger an alert.' },
];

const hood = [
  ['Approval gate', '[agent] approval_tools defaults to save_contacts, git_push · timeout + headless fallback'],
  ['Local dedup', 'save_contacts merges on normalized email/phone — atomic check-and-insert, never a duplicate'],
  ['amoCRM', 'POST /api/v4/contacts on your account subdomain · bearer auth · PHONE/EMAIL field codes'],
  ['Bitrix24', '/rest/crm.contact.add.json · auth query param · NAME, POST, EMAIL, PHONE, COMMENTS'],
  ['HubSpot', 'api.hubapi.com/crm/v3/objects/contacts · private app token · firstname/lastname split'],
  ['CRM dedup', 'remote id stored as crm_id → already-synced contacts are skipped on every re-push'],
  ['Push engine', 'bounded concurrency ×4 · one retry after 1s on transient failure · errors reported, not fatal'],
  ['Contact export', 'csv · vcard · json · xlsx'],
  ['Report export', 'pdf · html · json · docx — pandoc, with wkhtmltopdf fallback for PDF'],
  ['Notify', 'webhook JSON (session.completed) · SMTP email · Telegram bot — fan-out, one failing channel never blocks the rest'],
  ['Watch mode', 'run --repeat N — runs are diffed; new emails/phones/persons alerted via webhook, Telegram or email'],
];

const tools = [
  'save_contacts',
  'memory_digest',
  'memory_search',
  'memory_graph',
  'verify_email',
  'suggest_emails',
  'file_write',
  'python_exec',
];
---

<Layout
  title="Outreach — Agent 07 — Fathom Research"
  description="Outreach — the finale of the Fathom chain: personal messages grounded in verified research, approval-gated side effects, CRM push with crm_id dedup, exports and notifications."
>
  <main class="ag-page">
    <div class="container">
      <!-- 1 · Hero -->
      <div class="ag-hero">
        <p class="eyebrow" data-i18n="agents.outreach.hero.eyebrow">Agent 07 / 07</p>
        <h1 class="h2-sec" data-i18n="agents.outreach.hero.title">Outreach</h1>
        <p class="copy-lg mx-auto" data-i18n="agents.outreach.hero.sub">The finale of the chain. Everything six agents researched, extracted, verified and remembered becomes the one thing that matters — a personal message a human actually wants to read. Approved before it ships, written per recipient, then synced to your CRM or exported.</p>
        <div class="canvas-wrap">
          <AgentCanvas agents={[{ name: 'Outreach', mode: 'outreach', hue: 205 }]} />
        </div>
      </div>

      <!-- 2 · Cross-nav -->
      <nav class="chips agent-nav" aria-label="All agents">
        {
          agentsNav.map((a) =>
            a.n === 'Outreach' ? (
              <span class="chip chip-active" aria-current="page">{a.n}</span>
            ) : (
              <a class="chip" href={a.href}>{a.n}</a>
            )
          )
        }
      </nav>

      <!-- 3 · What it does -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.outreach.what.eyebrow">What it does</p>
        <h2 class="h3-sec" data-i18n="agents.outreach.what.title">From verified leads to ready drafts</h2>
      </div>
      <div class="api-grid">
        {
          cards.map((c) => (
            <div class="api-card">
              <div class="api-name">{c.name}</div>
              <p>{c.d}</p>
            </div>
          ))
        }
      </div>

      <!-- 4 · How it works -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.outreach.how.eyebrow">How it works</p>
        <h2 class="h3-sec" data-i18n="agents.outreach.how.title">Five steps to a ready-to-send draft</h2>
      </div>
      <div class="flow">
        {
          flow.map((s, i) => (
            <div class="flow-step">
              <span class="flow-num">{s.n}</span>
              <h3 data-i18n={`agents.outreach.flow.${i}.t`}>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))
        }
      </div>

      <!-- 5 · Under the hood -->
      <div class="feat" id="hood">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="agents.outreach.hood.eyebrow">Under the hood</p>
          <h2 class="h3-sec" data-i18n="agents.outreach.hood.title">A draft you can audit</h2>
          <p class="copy-lg">Every side effect passes an approval gate, every push returns the remote id, every run is diffable. The CRM payload maps real contact fields — name, title, company, email, phone, notes — and provider errors come back descriptive, never silent.</p>
        </div>
        <div class="mini-table-wrap">
          <table class="mini-table">
            <thead><tr><th data-i18n="agents.outreach.hood.keyCol">Detail</th><th data-i18n="agents.outreach.hood.detailCol">Implementation</th></tr></thead>
            <tbody>
              {
                hood.map((r) => (
                  <tr>
                    <td>{r[0]}</td>
                    <td>{r[1]}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <!-- 6 · Tools -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.outreach.tools.eyebrow">Tools</p>
        <h2 class="h3-sec" data-i18n="agents.outreach.tools.title">The Outreach toolset</h2>
      </div>
      <div class="chips">
        {tools.map((t) => <span class="chip">{t}</span>)}
      </div>

      <!-- 7 · Feeds the outreach pipeline -->
      <div class="feat feat-reverse" id="finale">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="agents.outreach.feeds.eyebrow">Feeds the outreach pipeline</p>
          <h2 class="h3-sec" data-i18n="agents.outreach.feeds.title">The finale: final assembly and delivery</h2>
          <p class="copy-lg">This is where the whole pipeline pays off. The message references real findings — with sources — because the prompt’s iron rule is to never fabricate. Memory makes repeat outreach smarter: past touches surface through the digest, supersession chains track role changes, and the text never asserts a stale fact. The approval flow keeps a human in control; crm_id dedup keeps the pipeline clean; notifications close the loop the moment the batch lands.</p>
        </div>
        <div class="code-card">
          <pre><code>{`Subject: Acme's Series B → platform hiring

Hi Jane — saw Acme closed the Series B and opened
6 platform roles. When we spoke in March you
mentioned infra tooling was the bottleneck —
we've since helped Globex cut lead-research time
from hours to minutes. Worth a 15-min call?

────────────────────────────────────────────
approval:    granted (operator, TUI)
save_contacts: 1 saved · merged with existing
crm push:    hubspot id 515 (crm_id stored)
export:      outreach-batch.docx
notify:      telegram ✓  webhook ✓`}</code></pre>
        </div>
      </div>

      <!-- 8 · CTA -->
      <div class="cta-strip">
        <h2 data-i18n="agents.outreach.cta.title">Run the whole pipeline — end with outreach</h2>
        <div class="cta-links">
          <a href="/agents/memoring" class="btn btn-secondary">← Memoring</a>
          <a href="/#cta" class="btn btn-primary">Get started →</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .ag-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .h3-sec { font-size: clamp(20px, 2.4vw, 34px); font-weight: 500; letter-spacing: -0.02em; margin: 12px 0 0; }
  .ic { font-family: var(--font-mono); font-size: .85em; background: var(--grey-100); border: 1px solid var(--grey-200); padding: 1px 6px; border-radius: 5px; }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .ag-hero { max-width: 820px; margin: 0 auto 40px; text-align: center; padding: 0 24px; }
  .ag-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .ag-hero .copy-lg { margin-top: 20px; }
  .canvas-wrap { margin-top: 36px; }

  .agent-nav { justify-content: center; margin: 0 0 8px; }

  .sec-head { max-width: 720px; margin: 60px 0 28px; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-family: var(--font-mono); font-size: 13px; background: var(--bg-card); border: 1px solid var(--grey-200); padding: 8px 14px; border-radius: 100px; color: var(--grey-700); text-decoration: none; }
  a.chip:hover { border-color: var(--grey-400); color: var(--grey-900); }
  .chip-active { background: var(--grey-900); border-color: var(--grey-900); color: var(--grey-50); }

  .api-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; background: var(--grey-300); border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--grey-300); }
  .api-card { background: var(--bg-card); padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .api-card .api-name { font-family: var(--font-mono); font-weight: 600; font-size: 14px; }
  .api-card p { color: var(--grey-600); font-size: 14px; line-height: 1.55; }
  @media (max-width: 800px) { .api-grid { grid-template-columns: 1fr; } }

  .flow { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .flow-step { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 20px; }
  .flow-num { display: inline-flex; width: 26px; height: 26px; align-items: center; justify-content: center; border-radius: 50%; background: var(--grey-900); color: #fff; font-family: var(--font-mono); font-size: 12px; margin-bottom: 12px; }
  .flow-step h3 { font-size: 15px; font-weight: 600; margin-bottom: 6px; }
  .flow-step p { font-size: 13px; color: var(--grey-600); line-height: 1.55; }
  @media (max-width: 1000px) { .flow { grid-template-columns: repeat(2, 1fr); } }

  .feat { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding: 48px 0; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  .feat-copy .copy-lg { margin-top: 16px; }
  @media (max-width: 900px) { .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; direction: ltr; } }

  .mini-table-wrap { border: 1px solid var(--grey-200); border-radius: 8px; overflow: auto; background: var(--bg-card); }
  .mini-table { width: 100%; border-collapse: collapse; font-size: 13px; font-family: var(--font-mono); }
  .mini-table th { font-size: 10px; text-transform: uppercase; letter-spacing: .6px; color: var(--grey-600); text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--grey-200); background: var(--grey-50); }
  .mini-table td { padding: 10px 14px; border-bottom: 1px solid var(--grey-100); color: var(--grey-800); vertical-align: top; }
  .mini-table td:first-child { color: var(--grey-600); white-space: nowrap; }
  .mini-table tr:last-child td { border-bottom: none; }

  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--bg-dark); overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 13px; line-height: 1.7; color: var(--grey-100); white-space: pre; }

  .cta-strip { margin-top: 64px; background: var(--bg-dark); border-radius: var(--radius-xl); padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta-strip h2 { color: #fff; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; }
  .cta-links { display: flex; gap: 10px; flex-wrap: wrap; }
  .cta-strip .btn-primary { background: var(--bg-card); color: var(--grey-900); }
  .cta-strip .btn-secondary { border-color: rgba(255,255,255,.3); color: var(--grey-100); }
</style>
