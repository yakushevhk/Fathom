---
import AgentPage from '../../components/AgentPage.astro';

const crew = [
  { name: 'Researcher', href: '/agents/researcher' },
  { name: 'Searching', href: '/agents/searching' },
  { name: 'Extracting', href: '/agents/extracting' },
  { name: 'Structuring', href: '/agents/structuring', current: true },
  { name: 'Cleaning', href: '/agents/cleaning' },
  { name: 'Memoring', href: '/agents/memoring' },
  { name: 'Outreach', href: '/agents/outreach' },
];

const caps = [
  { tool: 'save_contacts', name: 'Persist, never duplicate', d: 'Writes structured records into SQLite or PostgreSQL, deduplicating against existing data: the same normalized key means a merge, not a second row. Optional integrations can receive the canonical record.' },
  { tool: 'deterministic autosave', name: 'The model cannot forget', d: 'Prompt-only steering can lose a handoff when a model skips a save call. The runtime persists metadata from successful extraction and discovery tools itself, so structured results survive the next turn.' },
  { tool: 'ContactDb schema', name: 'Five tables, one dossier', d: 'contacts, social_profiles, companies, tags and notes — with source provenance, timestamps and a crm_id column for idempotent CRM sync. WAL mode, foreign keys, indexed lookups.' },
  { tool: 'normalization', name: 'One spelling per contact', d: 'normalize_email trims and lower-cases ("Ann@Acme.io" → ann@acme.io); normalize_phone keeps ASCII digits only, stored in the indexed phone_norm column. These are the dedup keys.' },
  { tool: 'merge semantics', name: 'Records grow, never split', d: 'The older record wins: blank fields are filled from the new data, social profiles move over with NOT EXISTS dedup, tags append via UNIQUE(contact_id, tag), notes accumulate — the duplicate row is deleted.' },
  { tool: 'entity graph', name: 'Entities and relationships', d: 'Entities deduplicate by (name, type); typed relations connect people, projects, systems, and organizations. Multi-hop BFS up to depth 4 supports context-aware downstream work.' },
];

const flow = [
  { t: 'Trigger', d: 'An extraction or discovery tool returns structured metadata with confidence and provenance for the current mission.' },
  { t: 'Autosave', d: 'The runtime persists structured items right after success — compaction cannot prune the handoff, and the model cannot forget the result.' },
  { t: 'Normalize', d: 'Emails lower-cased, phones reduced to digits, provenance recorded: extract_contacts:mailto link:https://acme.io.' },
  { t: 'Find-or-insert', d: 'One atomic transaction: look up by normalized email, then phone_norm. Match → merge; no match → insert. Concurrent agents cannot double-insert.' },
  { t: 'Graph', d: 'People, projects, systems, and organizations upsert as nodes; relations become typed edges with confidence for context-aware downstream work.' },
  { t: 'Sync', d: 'Contacts push to amoCRM, Bitrix24 or HubSpot four at a time with retry; the returned crm_id is stored so re-syncs update instead of duplicating.' },
];

const hood = [
  ['Schema', 'contacts(id, email, phone, phone_norm, name, title, company, source, crm_id, created_at, updated_at) · social_profiles · companies · tags · notes'],
  ['Storage', 'SQLite with WAL + busy_timeout 5000 out of the box · PostgreSQL behind the same interface via [contacts] pg_url'],
  ['Dedup keys', 'normalized email first, then digits-only phone_norm · lowest id wins — the oldest record survives'],
  ['Merge', 'blanks filled from new data · socials moved with NOT EXISTS · tags INSERT OR IGNORE · notes appended · temp row deleted, one transaction'],
  ['Atomicity', 'find-or-insert runs in a single locked transaction — concurrent workers cannot both insert the same normalized record (TOCTOU-safe)'],
  ['Autosave', 'fires on extract_contacts / find_leads success regardless of the model · "[auto-persisted N contact(s): X new, Y merged]"'],
  ['Provenance', 'source tags identify the producing tool and source URL · confidence is retained as record metadata for review'],
  ['Lenient input', 'tags/notes accept a JSON array or a plain string; "; " and newlines split blobs — LLM shape drift never loses data'],
  ['Graph dedup', 'entity_nodes UNIQUE(name COLLATE NOCASE, entity_type) · edges UNIQUE(from, to, relation), default confidence 0.8'],
  ['Multi-hop', 'BFS depth clamped 1–4, simple paths only, inverse traversal marked ⁻¹'],
  ['CRM push', 'buffer_unordered(4) concurrency · one retry after 1 s · set_crm_id for idempotent re-pushes'],
];

const tools = ['save_contacts', 'extract_contacts', 'find_leads', 'memory'];
---

<AgentPage
  pageTitle="Structuring Worker — Fathom"
  pageDesc="Turns extracted fragments into canonical records — normalized, deduplicated, and linked in an entity graph."
  k="agents.structuring"
  index="04"
  title="Structuring"
  sub="The structuring worker turns extracted fragments into canonical records — normalized, deduplicated, and linked in an entity graph so every worker can rely on the same context."
  mode="structuring"
  hue={260}
  crew={crew}
  caps={caps}
  capsTitle="Canonical records from scattered fragments"
  flow={flow}
  flowTitle="From tool output to canonical contact"
  hood={hood}
  hoodTitle="Schema, keys and merge rules"
  tools={tools}
  toolsTitle="What the agent runs"
  ctaTitle="Every downstream task needs canonical context"
  prev={{ href: '/agents/extracting', label: '← Extracting' }}
  middle={{ href: '/features/auto-outreach', label: 'Auto outreach' }}
  next={{ href: '/agents/cleaning', label: 'Cleaning →' }}
>
  <div slot="posttools" class="feat feat-reverse">
    <div class="feat-copy">
      <p class="feat-eyebrow">Feeds downstream workers</p>
      <h2>A canonical record is shared context</h2>
      <p class="feat-body">Structured records give every worker the same reliable subject, source links, tags, and notes. A coding, research, or operations task can reuse the canonical entity without re-parsing every source or creating duplicates.</p>
    </div>
    <div class="code-card">
      <pre><code>{`save_contacts([{
  email:  "Ann@Acme.io",   # → ann@acme.io
  name:   "Ann Petrova",
  title:  "CTO",
  company:"Acme",
  socials:[{ platform: "linkedin", url: "…" }],
  tags:   ["saas", "decision-maker"]
}])
→ added: 0 · merged_with_existing: 1

# one canonical record =
# one consistent downstream handoff`}</code></pre>
    </div>
  </div>
</AgentPage>

<style>
  .feat { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 48px; align-items: center; margin-top: 72px; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  .feat-eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey-600); margin-bottom: 14px; }
  .feat-copy h2 { font-size: clamp(24px, 3vw, 38px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 16px; }
  .feat-body { color: var(--grey-600); font-size: 15px; line-height: 1.6; max-width: 56ch; }
  .code-card { border: 1px solid #242424; border-radius: var(--radius-lg); background: #0d0d0d; overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.85; color: #c9c9cf; white-space: pre; }
  @media (max-width: 900px) { .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; direction: ltr; } }
</style>
