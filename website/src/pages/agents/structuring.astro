---
import Layout from '../../layouts/Layout.astro';
import AgentCanvas from '../../components/AgentCanvas.astro';

const fleet = [
  { name: 'Researcher', href: '/agents/researcher' },
  { name: 'Searching', href: '/agents/searching' },
  { name: 'Extracting', href: '/agents/extracting' },
  { name: 'Structuring', href: '/agents/structuring', active: true },
  { name: 'Cleaning', href: '/agents/cleaning' },
  { name: 'Memoring', href: '/agents/memoring' },
  { name: 'Outreach', href: '/agents/outreach' },
];

const caps = [
  { tool: 'save_contacts', t: 'Persist, never duplicate', d: 'Writes harvested contacts into SQLite or PostgreSQL, deduplicating against existing records: same normalized email or phone means a merge, not a second row. Optionally pushes straight to the CRM.' },
  { tool: 'deterministic autosave', t: 'The model cannot forget', d: 'Prompt-only steering leaks yield whenever the LLM skips the save call. The runtime persists the metadata of every successful extract_contacts / find_leads itself — contacts reach the database no matter what the model does next.' },
  { tool: 'ContactDb schema', t: 'Five tables, one dossier', d: 'contacts, social_profiles, companies, tags and notes — with source provenance, timestamps and a crm_id column for idempotent CRM sync. WAL mode, foreign keys, indexed lookups.' },
  { tool: 'normalization', t: 'One spelling per contact', d: 'normalize_email trims and lower-cases ("Ann@Acme.io" → ann@acme.io); normalize_phone keeps ASCII digits only, stored in the indexed phone_norm column. These are the dedup keys.' },
  { tool: 'merge semantics', t: 'Records grow, never split', d: 'The older record wins: blank fields are filled from the new data, social profiles move over with NOT EXISTS dedup, tags append via UNIQUE(contact_id, tag), notes accumulate — the duplicate row is deleted.' },
  { tool: 'entity graph', t: 'Person ↔ company ↔ location', d: 'Entities deduplicate by (name, type); typed relations like works_at, leads and located_in connect them. Multi-hop BFS up to depth 4 answers "who runs companies in sector X".' },
];

const flow = [
  { t: 'Trigger', d: 'extract_contacts or find_leads returns structured metadata: emails, phones, persons, leads with confidence scores.' },
  { t: 'Autosave', d: 'The runtime converts every item into a contact row right after success — compaction cannot prune it, the model cannot forget it.' },
  { t: 'Normalize', d: 'Emails lower-cased, phones reduced to digits, provenance recorded: extract_contacts:mailto link:https://acme.io.' },
  { t: 'Find-or-insert', d: 'One atomic transaction: look up by normalized email, then phone_norm. Match → merge; no match → insert. Concurrent agents cannot double-insert.' },
  { t: 'Graph', d: 'Persons, companies and locations upsert as nodes; relations become typed edges with confidence — the substrate for multi-hop OSINT questions.' },
  { t: 'Sync', d: 'Contacts push to amoCRM, Bitrix24 or HubSpot four at a time with retry; the returned crm_id is stored so re-syncs update instead of duplicating.' },
];

const hood = [
  ['Schema', 'contacts(id, email, phone, phone_norm, name, title, company, source, crm_id, created_at, updated_at) · social_profiles(platform, url, username) · companies(name UNIQUE) · tags · notes'],
  ['Storage', 'SQLite with WAL + busy_timeout 5000 out of the box · PostgreSQL behind the same interface via [contacts] pg_url'],
  ['Dedup keys', 'normalized email first, then digits-only phone_norm · lowest id wins — the oldest record survives'],
  ['Merge', 'blanks filled from new data · socials moved with NOT EXISTS · tags INSERT OR IGNORE · notes appended · temp row deleted, all inside one transaction'],
  ['Atomicity', 'find-or-insert runs in a single locked transaction — two agents harvesting the same lead cannot both insert it (TOCTOU-safe)'],
  ['Autosave', 'fires on extract_contacts / find_leads success regardless of the model · "[auto-persisted N contact(s): X new, Y merged]"'],
  ['Provenance', 'source tags like extract_contacts:person:https://acme.io · lead confidence lands as a note: "lead confidence: 0.83"'],
  ['Lenient input', 'tags/notes accept a JSON array or a plain string; "; " and newlines split blobs — LLM shape drift never loses data'],
  ['Graph dedup', 'entity_nodes UNIQUE(name COLLATE NOCASE, entity_type) · edges UNIQUE(from, to, relation), default confidence 0.8'],
  ['Multi-hop', 'BFS depth clamped 1–4, simple paths only, inverse traversal marked ⁻¹ · "Ivan Petrov (person) --works_at--> Acme LLC (company)"'],
  ['CRM push', 'buffer_unordered(4) concurrency · one retry after 1 s · set_crm_id for idempotent re-pushes'],
];

const tools = ['save_contacts', 'extract_contacts', 'find_leads', 'memory'];
---

<Layout title="Structuring Agent — Fathom Research">
  <main class="ag-page">
    <div class="container">
      <div class="ag-hero">
        <p class="eyebrow" data-i18n="agents.structuring.hero.eyebrow">AGENT 03 / 07</p>
        <h1 class="h2-sec" data-i18n="agents.structuring.hero.title">Structuring</h1>
        <p class="copy-lg mx-auto" data-i18n="agents.structuring.hero.sub">A lead you cannot address is noise. The Structuring agent turns extracted fragments into one canonical contact record — normalized, deduplicated, linked into an entity graph — so outreach always knows exactly who it is writing to.</p>
        <div class="hero-canvas">
          <AgentCanvas agents={[{ name: 'Structuring', mode: 'structuring', hue: 260 }]} />
        </div>
      </div>

      <!-- Cross-nav -->
      <div class="chips nav-chips">
        {fleet.map((a) => (
          <a href={a.href} class:list={['chip', a.active && 'chip--active']}>{a.name}</a>
        ))}
      </div>

      <!-- What it does -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.structuring.what.eyebrow">What it does</p>
        <h2 class="h3-sec" data-i18n="agents.structuring.what.title">Canonical records from scattered fragments</h2>
      </div>
      <div class="api-grid">
        {caps.map((c, i) => (
          <div class="api-card">
            <div class="api-name" data-i18n={`agents.structuring.cap.${i}.n`}>{c.tool}</div>
            <h3 data-i18n={`agents.structuring.cap.${i}.t`}>{c.t}</h3>
            <p data-i18n={`agents.structuring.cap.${i}.d`}>{c.d}</p>
          </div>
        ))}
      </div>

      <!-- How it works -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.structuring.how.eyebrow">How it works</p>
        <h2 class="h3-sec" data-i18n="agents.structuring.how.title">From tool output to canonical contact</h2>
      </div>
      <div class="flow">
        {flow.map((s, i) => (
          <div class="flow-step">
            <span class="flow-num">{i + 1}</span>
            <h3 data-i18n={`agents.structuring.flow.${i}.t`}>{s.t}</h3>
            <p data-i18n={`agents.structuring.flow.${i}.d`}>{s.d}</p>
          </div>
        ))}
      </div>

      <!-- Under the hood -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.structuring.hood.eyebrow">Under the hood</p>
        <h2 class="h3-sec" data-i18n="agents.structuring.hood.title">Schema, keys and merge rules</h2>
      </div>
      <div class="mini-table-wrap">
        <table class="mini-table">
          <thead><tr><th data-i18n="agents.structuring.hood.keyCol">Mechanism</th><th data-i18n="agents.structuring.hood.detailCol">Detail</th></tr></thead>
          <tbody>
            {hood.map((r, i) => (
              <tr><td data-i18n={`agents.structuring.hood.${i}.k`}>{r[0]}</td><td data-i18n={`agents.structuring.hood.${i}.d`}>{r[1]}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Tools -->
      <div class="sec-head">
        <p class="eyebrow" data-i18n="agents.structuring.tools.eyebrow">Tools</p>
        <h2 class="h3-sec" data-i18n="agents.structuring.tools.title">What the agent runs</h2>
      </div>
      <div class="chips">
        {tools.map((t, i) => <span class="chip chip--mono" data-i18n={`agents.structuring.toolNames.${i}`}>{t}</span>)}
      </div>

      <!-- Feeds the outreach pipeline -->
      <div class="feat feat-reverse">
        <div class="feat-copy">
          <p class="eyebrow" data-i18n="agents.structuring.feeds.eyebrow">Feeds the outreach pipeline</p>
          <h2 class="h3-sec" data-i18n="agents.structuring.feeds.title">A structured contact is an addressee</h2>
          <p class="copy-lg" data-i18n="agents.structuring.feeds.body">Outreach never writes "to whom it may concern". It writes to Ann Petrova, CTO at Acme, ann@acme.io — with her LinkedIn for context, tags for segmentation and notes for the opening hook. Because Structuring merged every source into one record, the message lands once, in the right inbox — not three times in three spellings.</p>
        </div>
        <div class="code-card">
          <pre><code>{`save_contacts([{
  email:  "Ann@Acme.io",   # → ann@acme.io
  name:   "Ann Petrova",
  title:  "CTO",
  company:"Acme",
  socials:[{ platform: "linkedin", url: "…" }],
  tags:   ["saas", "decision-maker"]
}])
→ added: 0 · merged_with_existing: 1

# one canonical record =
# one personal message, sent once`}</code></pre>
        </div>
      </div>

      <div class="cta-strip">
        <h2 data-i18n="agents.structuring.cta.title">Every message needs a canonical addressee</h2>
        <div class="more-links">
          <a href="/agents/extracting" class="btn btn-secondary" data-i18n="agents.structuring.cta.prev">← Extracting</a>
          <a href="/agents/cleaning" class="btn btn-secondary" data-i18n="agents.structuring.cta.next">Cleaning →</a>
          <a href="/features/auto-outreach" class="btn btn-primary" data-i18n="agents.structuring.cta.auto">Auto outreach</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .ag-page { padding: 70px 0 90px; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-600); }
  .h3-sec { font-size: clamp(20px, 2.4vw, 34px); font-weight: 500; letter-spacing: -0.02em; margin: 12px 0 0; }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.55; max-width: 640px; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .ag-hero { max-width: 820px; margin: 0 auto 32px; text-align: center; padding: 0 24px; }
  .ag-hero h1 { font-size: clamp(34px, 5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.02; margin-top: 12px; }
  .ag-hero .copy-lg { margin-top: 20px; }

  .hero-canvas { max-width: 320px; margin: 34px auto 0; background: #0a0a0a; border: 1px solid #222; border-radius: var(--radius-xl); padding: 26px 20px; }
  .hero-canvas :global(.agent-grid) { max-width: none; }

  .nav-chips { justify-content: center; margin: 8px 0 8px; }

  .sec-head { max-width: 720px; margin: 60px auto 28px; text-align: center; }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { font-family: var(--font-mono); font-size: 13px; background: var(--bg-card); border: 1px solid var(--grey-200); padding: 8px 14px; border-radius: 100px; color: var(--grey-700); text-decoration: none; transition: border-color .2s, color .2s; }
  a.chip:hover { border-color: var(--grey-400); color: var(--grey-900); }
  .chip--active { background: var(--grey-900); border-color: var(--grey-900); color: #fff; }
  .chip--mono { cursor: default; }

  .api-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .api-card { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 24px; display: flex; flex-direction: column; gap: 8px; transition: box-shadow .25s, transform .25s var(--ease-out), border-color .25s; }
  .api-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: var(--grey-400); }
  .api-card .api-name { font-family: var(--font-mono); font-weight: 600; font-size: 13px; color: var(--grey-600); }
  .api-card h3 { font-size: 16px; font-weight: 600; }
  .api-card p { color: var(--grey-600); font-size: 13.5px; line-height: 1.55; }
  @media (max-width: 1000px) { .api-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 680px) { .api-grid { grid-template-columns: 1fr; } }

  .flow { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .flow-step { background: var(--bg-card); border: 1px solid var(--grey-200); border-radius: var(--radius-lg); padding: 20px; }
  .flow-num { display: inline-flex; width: 26px; height: 26px; align-items: center; justify-content: center; border-radius: 50%; background: var(--grey-900); color: #fff; font-family: var(--font-mono); font-size: 12px; margin-bottom: 12px; }
  .flow-step h3 { font-size: 15px; font-weight: 600; margin-bottom: 6px; }
  .flow-step p { font-size: 12.5px; color: var(--grey-600); line-height: 1.5; }
  @media (max-width: 1100px) { .flow { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 680px) { .flow { grid-template-columns: repeat(2, 1fr); } }

  .mini-table-wrap { border: 1px solid var(--grey-200); border-radius: 8px; overflow: auto; background: var(--bg-card); }
  .mini-table { width: 100%; border-collapse: collapse; font-size: 13px; font-family: var(--font-mono); }
  .mini-table th { font-size: 10px; text-transform: uppercase; letter-spacing: .6px; color: var(--grey-600); text-align: left; padding: 10px 14px; border-bottom: 1px solid var(--grey-200); background: var(--grey-50); }
  .mini-table td { padding: 10px 14px; border-bottom: 1px solid var(--grey-100); color: var(--grey-800); vertical-align: top; }
  .mini-table td:first-child { white-space: nowrap; color: var(--grey-600); }
  .mini-table tr:last-child td { border-bottom: none; }

  .feat { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; padding: 48px 0; }
  .feat-reverse { direction: rtl; }
  .feat-reverse > * { direction: ltr; }
  @media (max-width: 900px) { .feat, .feat-reverse { grid-template-columns: 1fr; gap: 28px; direction: ltr; } }

  .code-card { border: 1px solid var(--grey-200); border-radius: var(--radius-md); background: var(--bg-dark); overflow: hidden; box-shadow: var(--shadow-lg); }
  .code-card pre { margin: 0; padding: 22px; overflow-x: auto; }
  .code-card code { font-family: var(--font-mono); font-size: 13px; line-height: 1.7; color: var(--grey-100); white-space: pre; }

  .cta-strip { margin-top: 64px; background: var(--bg-dark); border-radius: var(--radius-xl); padding: 48px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .cta-strip h2 { color: #fff; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; }
  .cta-strip .btn-primary { background: var(--bg-card); color: var(--grey-900); }
  .cta-strip .btn-secondary { border-color: rgba(255,255,255,.25); color: rgba(255,255,255,.85); }
  .cta-strip .btn-secondary:hover { border-color: rgba(255,255,255,.5); color: #fff; }
  .more-links { display: flex; gap: 10px; flex-wrap: wrap; }
</style>
