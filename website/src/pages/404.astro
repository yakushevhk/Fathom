---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Fathom Research">
  <main class="nf">
    <div class="container">
      <p class="eyebrow" data-i18n="nf404.eyebrow">404</p>
      <h1 class="h2-sec" data-i18n-html data-i18n="nf404.title">This page was<br />superseded.</h1>
      <p class="copy-lg" data-i18n="nf404.copy">Like facts in our memory store, some pages get replaced by newer versions. The one you requested is archived.</p>
      <div class="more-links">
        <a href="/" class="btn btn-primary" data-i18n="nf404.home">Back home</a>
        <a href="/docs" class="btn btn-secondary" data-i18n="nf404.docs">Documentation</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .nf { padding: 140px 0 160px; text-align: center; }
  .eyebrow { font-family: var(--font-mono); font-size: 13px; letter-spacing: .16px; text-transform: uppercase; color: var(--grey-500); }
  .h2-sec { font-size: clamp(40px, 7vw, 96px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.0; margin: 16px 0 20px; }
  .copy-lg { color: var(--grey-600); font-size: 17px; line-height: 1.55; max-width: 560px; margin: 0 auto; }
  .more-links { display: flex; gap: 10px; justify-content: center; margin-top: 36px; }
</style>
