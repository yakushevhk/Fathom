---
// HeroField — barely-visible particle wave behind the landing hero.
// A grid of dots drifts in slow layered sine waves; opacity stays low
// in both themes (theme changes are observed live). Lazy-loaded
// Three.js, paused off-screen, static frame under reduced motion,
// silent removal if WebGL is unavailable.
---
<div class="hero-field" aria-hidden="true">
  <canvas data-herofield></canvas>
</div>

<style>
  .hero-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .hero-field canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const canvas = document.querySelector('[data-herofield]');
  if (canvas) import('three').then((THREE) => {
    const wrap = canvas.parentElement;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = Math.max(320, wrap.clientWidth);
    let H = Math.max(320, wrap.clientHeight);

    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    } catch {
      wrap.remove();
      return;
    }
    renderer.setPixelRatio(Math.min(2, window.devicePixelRatio || 1));
    renderer.setSize(W, H, false);
    renderer.setClearColor(0x000000, 0);

    const scene = new THREE.Scene();
    const FOV = 45;
    const camera = new THREE.PerspectiveCamera(FOV, W / H, 0.1, 2000);
    function camDistance() {
      return (H / 2) / Math.tan((FOV * Math.PI) / 360);
    }
    camera.position.set(0, 0, camDistance());

    // dot sprite
    const cv = document.createElement('canvas');
    cv.width = cv.height = 32;
    const cx = cv.getContext('2d');
    const g = cx.createRadialGradient(16, 16, 0, 16, 16, 16);
    g.addColorStop(0, 'rgba(255,255,255,1)');
    g.addColorStop(0.6, 'rgba(255,255,255,.5)');
    g.addColorStop(1, 'rgba(255,255,255,0)');
    cx.fillStyle = g;
    cx.fillRect(0, 0, 32, 32);
    const dot = new THREE.CanvasTexture(cv);

    const SPACING = 44;
    let geo = null, points = null;
    let baseX = [], baseY = [];

    const mat = new THREE.PointsMaterial({
      size: 3.1, map: dot, transparent: true,
      depthWrite: false, vertexColors: true,
    });

    function themeColors() {
      const dark = document.documentElement.dataset.theme === 'dark';
      return dark
        ? { dot: new THREE.Color('#7f97ac'), dim: new THREE.Color('#20262d'), opacity: 0.5 }
        : { dot: new THREE.Color('#8b9aa8'), dim: new THREE.Color('#e6e4e1'), opacity: 0.55 };
    }
    let tc = themeColors();
    mat.opacity = tc.opacity;

    function rebuild() {
      if (points) { scene.remove(points); geo.dispose(); }
      baseX = []; baseY = [];
      const cols = Math.ceil(W / SPACING) + 2;
      const rows = Math.ceil(H / SPACING) + 2;
      const x0 = -((cols - 1) / 2) * SPACING;
      const y0 = -((rows - 1) / 2) * SPACING;
      const n = cols * rows;
      const pos = new Float32Array(n * 3);
      const col = new Float32Array(n * 3);
      let i = 0;
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          baseX.push(x0 + c * SPACING);
          baseY.push(y0 + r * SPACING);
          pos[i * 3] = baseX[i];
          pos[i * 3 + 1] = baseY[i];
          pos[i * 3 + 2] = 0;
          col[i * 3] = tc.dim.r; col[i * 3 + 1] = tc.dim.g; col[i * 3 + 2] = tc.dim.b;
          i++;
        }
      }
      geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
      geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
      points = new THREE.Points(geo, mat);
      scene.add(points);
    }
    rebuild();

    const tmpC = new THREE.Color();
    function draw(t) {
      const p = geo.attributes.position;
      const c = geo.attributes.color;
      for (let i = 0; i < baseX.length; i++) {
        const x = baseX[i];
        const y = baseY[i];
        const w =
          9 * Math.sin(x * 0.0085 + t * 0.55) +
          6 * Math.sin(y * 0.011 + t * 0.38) +
          4.5 * Math.sin((x + y) * 0.006 + t * 0.72);
        p.setY(i, y + w);
        const k = Math.min(1, Math.max(0, (w + 12) / 24));
        tmpC.copy(tc.dim).lerp(tc.dot, k);
        c.setXYZ(i, tmpC.r, tmpC.g, tmpC.b);
      }
      p.needsUpdate = true;
      c.needsUpdate = true;
      renderer.render(scene, camera);
    }

    let raf = 0, running = false, visible = true;
    const start = performance.now();
    function loop() {
      if (!running) return;
      draw((performance.now() - start) / 1000);
      raf = requestAnimationFrame(loop);
    }
    function startLoop() { if (!running && visible) { running = true; raf = requestAnimationFrame(loop); } }
    function stopLoop() { running = false; cancelAnimationFrame(raf); }

    if (reduced) {
      draw(2.4);
    } else {
      new IntersectionObserver((es) => {
        visible = es[0].isIntersecting;
        if (visible) startLoop(); else stopLoop();
      }, { rootMargin: '120px' }).observe(wrap);
      startLoop();
    }

    // live theme switch
    new MutationObserver(() => {
      tc = themeColors();
      mat.opacity = tc.opacity;
      if (reduced) draw(2.4);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    new ResizeObserver(() => {
      W = Math.max(320, wrap.clientWidth);
      H = Math.max(320, wrap.clientHeight);
      camera.aspect = W / H;
      camera.position.z = camDistance();
      camera.updateProjectionMatrix();
      renderer.setSize(W, H, false);
      rebuild();
      if (reduced) draw(2.4);
    }).observe(wrap);
  });
</script>
