---
// AgentPage — shared chrome for every /agents/* page: orb hero, crew
// cross-nav, capability bento, flow timeline, hood table, tool chips,
// and a CTA strip. Pages pass their data + custom blocks via slots.
import Layout from '../layouts/Layout.astro';
import OrbScene from './OrbScene.astro';

interface CrewItem { name: string; href: string; current?: boolean; }
interface Cap { name: string; d: string; tool?: string; }
interface FlowStep { t: string; d: string; }

interface Props {
  pageTitle: string;
  pageDesc?: string;
  k: string;
  index: string;
  title: string;
  sub: string;
  mode: string;
  hue: number;
  crew: CrewItem[];
  caps: Cap[];
  capsEyebrow?: string;
  capsTitle?: string;
  flow: FlowStep[];
  flowEyebrow?: string;
  flowTitle?: string;
  hood: [string, string][];
  hoodEyebrow?: string;
  hoodTitle?: string;
  tools: string[];
  toolsEyebrow?: string;
  toolsTitle?: string;
  ctaTitle: string;
  prev?: { href: string; label: string };
  next?: { href: string; label: string };
  middle?: { href: string; label: string };
}

const {
  pageTitle, pageDesc, k, index, title, sub, mode, hue, crew,
  caps, capsEyebrow = 'What it does', capsTitle = 'One loop, built for the mission',
  flow, flowEyebrow = 'How it works', flowTitle = 'From mission to durable result',
  hood, hoodEyebrow = 'Under the hood', hoodTitle = 'The runtime underneath',
  tools, toolsEyebrow = 'Tools', toolsTitle = 'What this worker can call',
  ctaTitle, prev, next, middle,
} = Astro.props;

const total = String(crew.length).padStart(2, '0');
---

<Layout title={pageTitle} description={pageDesc}>
  <main class="ag-page">
    <div class="container">
      <!-- ===== Hero ===== -->
      <div class="ag-hero">
        <div class="ag-hero-copy">
          <p class="eyebrow" data-i18n={`${k}.hero.eyebrow`}>AGENT {index} / {total}</p>
          <h1 data-i18n={`${k}.hero.title`}>{title}</h1>
          <p class="copy-lg" data-i18n={`${k}.hero.sub`}>{sub}</p>
          <div class="ag-hero-meta">
            <span class="meta-chip"><i class="swatch" style={`background:hsl(${hue} 45% 62%)`}></i><span data-i18n={`${k}.hero.mode`}>{mode}</span></span>
            <span class="meta-chip meta-chip--dim">fathom worker</span>
          </div>
        </div>
        <div class="ag-hero-visual">
          <OrbScene {hue} {mode} height={360} label={`${mode} · autonomous`} />
        </div>
      </div>

      <!-- ===== Crew nav ===== -->
      <nav class="crew">
        {
          crew.map((a) =>
            a.current ? (
              <span class="crew-chip crew-chip--on">{a.name}</span>
            ) : (
              <a class="crew-chip" href={a.href}>{a.name}</a>
            )
          )
        }
      </nav>

      <!-- ===== Capabilities ===== -->
      <section class="ag-sec">
        <div class="sec-head">
          <p class="eyebrow"><span class="eyebrow__num">01</span><span data-i18n={`${k}.caps.eyebrow`}>{capsEyebrow}</span></p>
          <h2 data-i18n={`${k}.caps.title`}>{capsTitle}</h2>
        </div>
        <div class="caps-grid">
          {
            caps.map((c, i) => (
              <div class="cap-card">
                <div class="cap-top">
                  {c.tool && <span class="cap-tool">{c.tool}</span>}
                  <span class="cap-num">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <h3 data-i18n={`${k}.caps.${i}.name`}>{c.name}</h3>
                <p data-i18n={`${k}.caps.${i}.d`}>{c.d}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ===== Flow ===== -->
      <section class="ag-sec">
        <div class="sec-head">
          <p class="eyebrow"><span class="eyebrow__num">02</span><span data-i18n={`${k}.flow.eyebrow`}>{flowEyebrow}</span></p>
          <h2 data-i18n={`${k}.flow.title`}>{flowTitle}</h2>
        </div>
        <div class="flow-list">
          {
            flow.map((s, i) => (
              <div class="flow-row">
                <div class="flow-mark">
                  <span class="flow-dot">{i + 1}</span>
                  {i < flow.length - 1 && <span class="flow-line"></span>}
                </div>
                <div class="flow-body">
                  <h3 data-i18n={`${k}.flow.${i}.t`}>{s.t}</h3>
                  <p data-i18n={`${k}.flow.${i}.d`}>{s.d}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <slot name="mid" />

      <!-- ===== Hood ===== -->
      <section class="ag-sec">
        <div class="sec-head">
          <p class="eyebrow"><span class="eyebrow__num">03</span><span data-i18n={`${k}.hood.eyebrow`}>{hoodEyebrow}</span></p>
          <h2 data-i18n={`${k}.hood.title`}>{hoodTitle}</h2>
        </div>
        <div class="hood-wrap">
          <table class="hood">
            <tbody>
              {
                hood.map((r, i) => (
                  <tr>
                    <td class="hood-k" data-i18n={`${k}.hood.${i}.k`}>{r[0]}</td>
                    <td class="hood-d" data-i18n={`${k}.hood.${i}.d`}>{r[1]}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <slot name="pretools" />

      <!-- ===== Tools ===== -->
      <section class="ag-sec">
        <div class="sec-head">
          <p class="eyebrow"><span class="eyebrow__num">04</span><span data-i18n={`${k}.tools.eyebrow`}>{toolsEyebrow}</span></p>
          <h2 data-i18n={`${k}.tools.title`}>{toolsTitle}</h2>
        </div>
        <div class="tool-chips">
          {tools.map((t) => <span class="tool-chip">{t}</span>)}
        </div>
      </section>

      <slot name="posttools" />

      <!-- ===== CTA ===== -->
      <div class="cta-strip">
        <h2 data-i18n={`${k}.cta.title`}>{ctaTitle}</h2>
        <div class="cta-links">
          {prev && <a href={prev.href} class="btn btn-secondary">{prev.label}</a>}
          {middle && <a href={middle.href} class="btn btn-primary">{middle.label}</a>}
          {next && <a href={next.href} class="btn btn-secondary">{next.label}</a>}
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .ag-page { padding: 64px 0 90px; }

  .eyebrow {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--font-mono); font-size: 12px; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey-600);
  }
  .eyebrow__num { color: var(--grey-400); }
  .sec-head { max-width: 760px; margin-bottom: 36px; }
  .sec-head h2 {
    font-size: clamp(26px, 3.4vw, 42px); font-weight: 500;
    letter-spacing: -0.025em; line-height: 1.08; margin-top: 14px;
  }
  .copy-lg { color: var(--grey-700); font-size: 17px; line-height: 1.6; max-width: 620px; }

  /* ---- Hero ---- */
  .ag-hero {
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px;
    align-items: center; margin-bottom: 40px;
  }
  .ag-hero-copy .eyebrow { color: var(--grey-500); }
  .ag-hero-copy h1 {
    font-size: clamp(48px, 6.4vw, 96px); line-height: 0.98;
    letter-spacing: -0.035em; font-weight: 470; margin-top: 22px;
  }
  .ag-hero-copy .copy-lg { margin-top: 22px; }
  .ag-hero-meta { display: flex; gap: 10px; margin-top: 28px; flex-wrap: wrap; }
  .meta-chip {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em;
    color: var(--grey-700); border: 1px solid var(--grey-300);
    border-radius: var(--radius-full); padding: 7px 14px; background: var(--bg-card);
  }
  .meta-chip--dim { color: var(--grey-500); }
  .swatch { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }

  /* ---- Crew nav ---- */
  .crew {
    display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
    padding: 20px 0; margin-bottom: 24px;
    border-top: 1px solid var(--grey-200); border-bottom: 1px solid var(--grey-200);
  }
  .crew-chip {
    font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.02em;
    color: var(--grey-600); background: transparent;
    border: 1px solid var(--grey-200); border-radius: var(--radius-full);
    padding: 8px 16px; transition: border-color .2s, color .2s, transform .2s var(--ease-out);
  }
  a.crew-chip:hover { border-color: var(--grey-500); color: var(--grey-900); transform: translateY(-1px); }
  .crew-chip--on { background: var(--grey-900); border-color: var(--grey-900); color: var(--on-accent); }

  /* ---- Sections ---- */
  .ag-sec { margin-top: 72px; }

  /* ---- Capabilities ---- */
  .caps-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: var(--grey-300); border: 1px solid var(--grey-300);
    border-radius: var(--radius-lg); overflow: hidden;
  }
  .cap-card {
    background: var(--bg-primary); padding: 26px 24px;
    display: flex; flex-direction: column; gap: 10px;
    transition: background .25s var(--ease-out);
  }
  .cap-card:hover { background: var(--bg-card-hover); }
  .cap-top { display: flex; align-items: center; justify-content: space-between; min-height: 22px; }
  .cap-tool {
    font-family: var(--font-mono); font-size: 11px; color: var(--grey-700);
    background: var(--grey-100); border: 1px solid var(--grey-200);
    padding: 3px 9px; border-radius: 5px;
  }
  .cap-num { font-family: var(--font-mono); font-size: 12px; color: var(--grey-400); }
  .cap-card h3 { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; }
  .cap-card p { color: var(--grey-600); font-size: 13.5px; line-height: 1.55; }

  /* ---- Flow ---- */
  .flow-list { display: flex; flex-direction: column; max-width: 820px; }
  .flow-row { display: grid; grid-template-columns: 44px 1fr; gap: 20px; }
  .flow-mark { display: flex; flex-direction: column; align-items: center; }
  .flow-dot {
    width: 30px; height: 30px; flex: none; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--grey-900); color: var(--on-accent);
    font-family: var(--font-mono); font-size: 13px; font-weight: 600;
  }
  .flow-line { flex: 1; width: 1px; background: var(--grey-300); margin: 6px 0; min-height: 20px; }
  .flow-body { padding-bottom: 30px; }
  .flow-row:last-child .flow-body { padding-bottom: 0; }
  .flow-body h3 { font-size: 17px; font-weight: 600; margin-bottom: 6px; letter-spacing: -0.01em; }
  .flow-body p { color: var(--grey-600); font-size: 14px; line-height: 1.6; max-width: 60ch; }

  /* ---- Hood ---- */
  .hood-wrap { border: 1px solid var(--grey-200); border-radius: var(--radius-lg); overflow: auto; background: var(--bg-card); }
  .hood { width: 100%; border-collapse: collapse; font-size: 13px; }
  .hood td { padding: 12px 16px; border-bottom: 1px solid var(--grey-100); vertical-align: top; }
  .hood tr:last-child td { border-bottom: none; }
  .hood-k { font-family: var(--font-mono); font-weight: 600; color: var(--grey-900); white-space: nowrap; width: 1%; }
  .hood-d { color: var(--grey-600); line-height: 1.55; font-family: var(--font-mono); font-size: 12.5px; }

  /* ---- Tools ---- */
  .tool-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .tool-chip {
    font-family: var(--font-mono); font-size: 12.5px; color: var(--grey-800);
    background: var(--bg-card); border: 1px solid var(--grey-300);
    border-radius: var(--radius-full); padding: 7px 14px;
    transition: border-color .2s, transform .2s var(--ease-out);
  }
  .tool-chip:hover { border-color: var(--grey-500); transform: translateY(-1px); }

  /* ---- CTA ---- */
  .cta-strip {
    margin-top: 80px; background: var(--bg-dark); border-radius: var(--radius-xl);
    padding: 48px; display: flex; align-items: center; justify-content: space-between;
    gap: 24px; flex-wrap: wrap; position: relative; overflow: hidden;
  }
  .cta-strip::before {
    content: ""; position: absolute; inset: -40% -10% auto auto; width: 60%; height: 180%;
    background: radial-gradient(50% 50% at 60% 40%, rgba(143, 182, 204, 0.2), transparent 70%);
    filter: blur(30px); pointer-events: none;
  }
  .cta-strip h2 { color: #fff; font-size: 26px; font-weight: 500; letter-spacing: -0.02em; position: relative; }
  .cta-links { display: flex; gap: 10px; flex-wrap: wrap; position: relative; }
  .cta-strip .btn-primary { background: #fff; color: #101010; }
  .cta-strip .btn-primary:hover { background: var(--grey-200); }
  .cta-strip .btn-secondary { border-color: rgba(255,255,255,.25); color: rgba(255,255,255,.85); background: transparent; }
  .cta-strip .btn-secondary:hover { border-color: rgba(255,255,255,.6); color: #fff; }

  @media (max-width: 960px) {
    .ag-hero { grid-template-columns: 1fr; gap: 36px; }
    .caps-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .cta-strip { padding: 32px 24px; }
    .hood-k { white-space: normal; }
  }
</style>
