---
// JsonLd — вставляет структурированные данные JSON-LD в <head>.
// Использование: <JsonLd data={{ "@type": "..." }} />
interface Props {
  data: Record<string, unknown>;
}

const { data } = Astro.props;
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />

<style>
  /* scoped styles никогда не должны попадать в head — пусто */
</style>