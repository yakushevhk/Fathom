---
// OceanField — Three.js wireframe ocean.
// "Fathom" is a nautical unit of depth; this section visualizes it:
// an animated sea of vertices with height-mapped colors, fog-faded
// horizon, lazy-loaded Three.js, paused off-screen, reduced-motion
// renders a single static frame.
---
<div class="ocean-wrap">
  <canvas data-ocean aria-hidden="true"></canvas>
</div>

<style>
  .ocean-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .ocean-wrap canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const canvas = document.querySelector('[data-ocean]');
  if (canvas) import('three').then((THREE) => {
    const wrap = canvas.parentElement;
    if (!wrap) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let W = Math.max(320, wrap.clientWidth);
    let H = Math.max(280, wrap.clientHeight);

    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'low-power' });
    } catch {
      wrap.remove();
      return;
    }
    renderer.setPixelRatio(Math.min(1.5, window.devicePixelRatio || 1));
    renderer.setSize(W, H, false);
    renderer.setClearColor(0x000000, 0);

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0x0a0a0a, 13, 34);

    const camera = new THREE.PerspectiveCamera(52, W / H, 0.1, 60);
    camera.position.set(0, 3.4, 10.5);
    camera.lookAt(0, 0.4, -5);

    // Optimized grid resolution for smooth 60fps on mobile
    const SEG_X = 76, SEG_Y = 46;
    const geo = new THREE.PlaneGeometry(52, 34, SEG_X, SEG_Y);
    const pos = geo.attributes.position;
    const count = pos.count;
    const colors = new Float32Array(count * 3);
    geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const deepR = 0.07, deepG = 0.15, deepB = 0.20;
    const crestR = 0.56, crestG = 0.71, crestB = 0.80;

    const mat = new THREE.MeshBasicMaterial({
      wireframe: true,
      vertexColors: true,
      transparent: true,
      opacity: 0.48,
      fog: true,
    });
    const mesh = new THREE.Mesh(geo, mat);
    mesh.rotation.x = -Math.PI / 2;
    mesh.position.set(0, -1.6, -4);
    scene.add(mesh);

    const mat2 = mat.clone();
    mat2.opacity = 0.15;
    const mesh2 = new THREE.Mesh(geo.clone(), mat2);
    mesh2.rotation.x = -Math.PI / 2;
    mesh2.position.set(3, -2.4, -8);
    scene.add(mesh2);

    const baseX = new Float32Array(count);
    const baseY = new Float32Array(count);
    for (let i = 0; i < count; i++) {
      baseX[i] = pos.getX(i);
      baseY[i] = pos.getY(i);
    }

    const posArray1 = mesh.geometry.attributes.position.array;
    const colorArray1 = mesh.geometry.attributes.color.array;
    const posArray2 = mesh2.geometry.attributes.position.array;
    const colorArray2 = mesh2.geometry.attributes.color.array;

    function deformFast(posArr, colArr, t, phase) {
      for (let i = 0; i < count; i++) {
        const x = baseX[i];
        const y = baseY[i];
        const z = (
          0.42 * Math.sin(x * 0.42 + t * 0.9 + phase) +
          0.28 * Math.sin(y * 0.55 + t * 0.62 + x * 0.18 + phase) +
          0.16 * Math.sin((x + y) * 0.32 + t * 1.35) +
          0.09 * Math.sin(x * 1.1 - t * 1.8)
        );
        const i3 = i * 3;
        posArr[i3 + 2] = z;
        const k = Math.min(1, Math.max(0, (z + 0.7) / 1.4));
        const k2 = k * k;
        colArr[i3] = deepR + (crestR - deepR) * k2;
        colArr[i3 + 1] = deepG + (crestG - deepG) * k2;
        colArr[i3 + 2] = deepB + (crestB - deepB) * k2;
      }
    }

    let raf = 0;
    let running = false;
    let visible = true;
    const start = performance.now();

    function draw() {
      const t = (performance.now() - start) / 1000;
      deformFast(posArray1, colorArray1, t, 0);
      mesh.geometry.attributes.position.needsUpdate = true;
      mesh.geometry.attributes.color.needsUpdate = true;

      deformFast(posArray2, colorArray2, t, 2.4);
      mesh2.geometry.attributes.position.needsUpdate = true;
      mesh2.geometry.attributes.color.needsUpdate = true;

      camera.position.x = Math.sin(t * 0.1) * 0.6;
      camera.lookAt(0, 0.4, -5);
      renderer.render(scene, camera);
    }

    function loop() {
      if (!running) return;
      draw();
      raf = requestAnimationFrame(loop);
    }
    function startLoop() {
      if (running || !visible) return;
      running = true;
      raf = requestAnimationFrame(loop);
    }
    function stopLoop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    if (reduced) {
      draw();
    } else {
      new IntersectionObserver((es) => {
        visible = es[0].isIntersecting;
        if (visible) startLoop(); else stopLoop();
      }, { rootMargin: '100px' }).observe(wrap);
      startLoop();
    }

    let resizeTimer;
    function resize() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (!wrap) return;
        W = Math.max(320, wrap.clientWidth);
        H = Math.max(280, wrap.clientHeight);
        camera.aspect = W / H;
        camera.updateProjectionMatrix();
        renderer.setSize(W, H, false);
        if (reduced) draw();
      }, 100);
    }
    new ResizeObserver(resize).observe(wrap);

    canvas.addEventListener('webglcontextlost', (e) => {
      e.preventDefault();
      stopLoop();
    }, false);

    canvas.addEventListener('webglcontextrestored', () => {
      startLoop();
    }, false);
  });
</script>
